//bruteforce | give tle
class Solution {
  public:
    int longestSubarray(vector<int>& arr, int k) {
        int n = arr.size();
    int len = 0;
    for(int i = 0; i < n; i++)
    {
        long long sum = 0;
        for(int j = i; j < n; j++)
        {
            sum += arr[j];
            if(sum == k)
            {
                len = max(len,j - i + 1);
            }
        }
    }
    return len;
        
    }
};


//optimal
int longestSubarrayWithSumK(vector<int> a, long long k) {
    int n = a.size();
    int head = -1;
    int tail = 0;
    long long sum = 0;
    int len = 0;
    while(tail < n)
    {
        while(head + 1 < n && sum + a[head+1] <= k)
        {
            head++;
            sum += a[head];
        } 
        if(sum == k)
        {
            len = max(len,head - tail + 1);
        }

        if(tail <= head)
        {
            sum -= a[tail];
            tail++;
        }
        else
        {
            tail++;
            head = tail - 1;
        }
    }
    return len;
}
