/*
===============================================================================
Approach 1 : Brute Force
===============================================================================

Intuition:
For every day, assume we buy the stock on that day and try selling it on every
future day. Keep track of the maximum profit.

Algorithm:
1. Traverse each day as the buying day.
2. Traverse all future days as the selling day.
3. Calculate profit = prices[j] - prices[i].
4. Update the maximum profit.

Time Complexity : O(n²)
Space Complexity: O(1)
*/

class Solution_Brute {
public:
    int maxProfit(vector<int>& prices) {

        int n = prices.size();
        int maxProfit = 0;

        for(int i = 0; i < n; i++)
        {
            for(int j = i + 1; j < n; j++)
            {
                maxProfit = max(maxProfit, prices[j] - prices[i]);
            }
        }

        return maxProfit;
    }
};



/*
===============================================================================
Approach 2 : Optimal (Track Minimum Price)
===============================================================================

Intuition:
To maximize profit, always buy at the lowest price seen so far. While traversing
the array, maintain the minimum price and calculate the profit obtained by
selling on the current day.

Algorithm:
1. Initialize minPrice as the first day's price.
2. Traverse the array from the second day.
3. Update the minimum price seen so far.
4. Calculate the profit if sold today.
5. Update the maximum profit.

Time Complexity : O(n)
Space Complexity: O(1)
*/

class Solution {
public:
    int maxProfit(vector<int>& prices) {

        int minPrice = prices[0];
        int maxProfit = 0;

        for(int i = 1; i < prices.size(); i++)
        {
            minPrice = min(minPrice, prices[i]);
            maxProfit = max(maxProfit, prices[i] - minPrice);
        }

        return maxProfit;
    }
};
