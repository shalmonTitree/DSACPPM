class Solution {
  public:
    string encode(vector<string>& s) {
        int n = s.size();
        string ans = "";
        for(int i = 0; i < n; i++)
        {
            ans += to_string(s[i].size());
            ans += '#';
            ans += s[i];
            
        }
        return ans;
    }

    vector<string> decode(string& s) {
        
        vector<string>ans;
        int i = 0;
        int j = 0;
        int n = s.size();
        while(i < n)
        {
            int j = i;
            
            
            while(s[j] != '#')
            {
                j++;
            }
            
            int len = stoi(s.substr(i, j - i));
            string ss = "";
            for(int k = j + 1; k <= j + len; k++)
            {
                ss += s[k];
            }
            ans.push_back(ss);
            
            i = j + len + 1;
        }
        return ans;
        
    }
};
