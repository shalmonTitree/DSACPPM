There are 3 variations commonly covered in Striver’s approach.
1. Find an element at a given row and column
2. Print a specific row
3. Generate the entire Pascal’s Triangle (LeetCode 118)



Complexities:
- Time: O(n²)
- Space: O(n²), including the output.
- Auxiliary space: O(n), excluding the output.

class Solution {
public:
    vector<vector<int>> generate(int numRows) {
        vector<vector<int>> ans;

        for (int i = 0; i < numRows; i++) {
            vector<int> row;
            long long val = 1;

            for (int j = 0; j <= i; j++) {
                row.push_back(val);
                val = val * (i - j) / (j + 1);
            }

            ans.push_back(row);
        }

        return ans;
    }
};
