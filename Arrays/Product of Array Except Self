/*
===============================================================================
Approach 1 : Brute Force
===============================================================================

Intuition:
For every index, calculate the product of all other elements by traversing the
entire array.

Algorithm:
1. Traverse each index i.
2. For every i, traverse the array again.
3. Multiply all elements except nums[i].
4. Store the product in the answer array.

Time Complexity : O(n²)
Space Complexity: O(1) (excluding the output array)
*/

class Solution_Brute {
public:
    vector<int> productExceptSelf(vector<int>& nums) {

        int n = nums.size();
        vector<int> ans(n);

        for(int i = 0; i < n; i++)
        {
            int product = 1;

            for(int j = 0; j < n; j++)
            {
                if(i != j)
                    product *= nums[j];
            }

            ans[i] = product;
        }

        return ans;
    }
};



/*
===============================================================================
Approach 2 : Better (Prefix & Suffix Arrays)
===============================================================================

Intuition:
The product except self at index i is:
    Prefix Product × Suffix Product

where,
Prefix Product = product of all elements before i.
Suffix Product = product of all elements after i.

Algorithm:
1. Build a prefix array.
2. Build a suffix array.
3. Multiply prefix[i] and suffix[i] for every index.

Time Complexity : O(n)
Space Complexity: O(n)
*/

class Solution_Better {
public:
    vector<int> productExceptSelf(vector<int>& nums) {

        int n = nums.size();

        vector<int> prefix(n);
        vector<int> suffix(n);
        vector<int> ans(n);

        prefix[0] = 1;
        for(int i = 1; i < n; i++)
            prefix[i] = prefix[i - 1] * nums[i - 1];

        suffix[n - 1] = 1;
        for(int i = n - 2; i >= 0; i--)
            suffix[i] = suffix[i + 1] * nums[i + 1];

        for(int i = 0; i < n; i++)
            ans[i] = prefix[i] * suffix[i];

        return ans;
    }
};



/*
===============================================================================
Approach 3 : Optimal (Constant Extra Space)
===============================================================================

Intuition:
Instead of storing separate prefix and suffix arrays, use the answer array to
store prefix products first. Then traverse from right to left while maintaining
a running suffix product.

Algorithm:
1. Store prefix products directly in the answer array.
2. Maintain a variable suffix = 1.
3. Traverse from right to left.
4. Multiply ans[i] with suffix.
5. Update suffix by multiplying nums[i].

Time Complexity : O(n)
Space Complexity: O(1) (excluding the output array)
*/

class Solution {
public:
    vector<int> productExceptSelf(vector<int>& nums) {

        int n = nums.size();

        vector<int> ans(n);

        ans[0] = 1;

        for(int i = 1; i < n; i++)
            ans[i] = ans[i - 1] * nums[i - 1];

        int suffix = 1;

        for(int i = n - 1; i >= 0; i--)
        {
            ans[i] *= suffix;
            suffix *= nums[i];
        }

        return ans;
    }
};
