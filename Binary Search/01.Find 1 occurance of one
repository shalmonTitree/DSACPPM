int firstOne(vector<int>& arr) {
    int n = arr.size();
    int low = 0, high = n - 1;
    int ans = -1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (arr[mid] == 1) {
            ans = mid;       // possible answer
            high = mid - 1;  // search for an earlier 1
        } 
        else {
            low = mid + 1;   // first 1 must be on the right
        }
    }

    return ans;
}
