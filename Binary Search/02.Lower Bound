#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

int n,target;
int arr[100100];


int check(int mid)
{
    if(mid >= target)
    {
        return 1;
    }
    else
    {
        return 0;
    }
}

void solve() {
    cin>>n;
    int ans = n;

    for(int i = 0; i < n; i++)
    {
        cin>>arr[i];
    }
    
    cin>>target;

    int l = 0;
    int h = n - 1;
    
    while(l <= h)
    {
        int mid = (l + h)/2;

        if(check(mid) == 0) //if zero
        {
            l = mid + 1;
        }
        else
        {
            h = mid - 1; //if one
            ans = mid;
        }
    }
    cout<<ans<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    // cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
