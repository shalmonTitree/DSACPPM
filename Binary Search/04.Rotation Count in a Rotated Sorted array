class Solution {
  public:
    int check(int mid,vector<int>&arr)
    {
        if(arr[mid] < arr[0])
        {
            return 1;
        }
        else
        {
            return 0;
        }
    }

    int findKRotation(vector<int> &arr) {
        int n = arr.size();
        
            int l = 0;
            int h = n - 1;
            int ans = 0;

            while(l <= h)
            {
                int mid = (l + h)/2;

                if(check(mid,arr) == 0)
                {
                    l = mid + 1;
                }
                else
                {
                    h = mid - 1;
                    ans = mid;
                }
            }
            return ans;
        
    }
};
