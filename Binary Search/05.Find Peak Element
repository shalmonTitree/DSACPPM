class Solution {
public:
    int check(int mid,vector<int>&nums)
    {
        if(mid == nums.size() - 1 || nums[mid] > nums[mid + 1])
        {
            return 1;
        }
        else
        {
            return 0;
        }
    }


    int findPeakElement(vector<int>& nums) {
            int n = nums.size();
        
            int l = 0;
            int h = n - 1;
            int ans = 0;

            while(l <= h)
            {
                int mid = (l + h)/2;

                if(check(mid,nums) == 0)
                {
                    l = mid + 1;
                }
                else
                {
                    h = mid - 1;
                    ans = mid;
                }
            }
            return ans;
        
    }
};
