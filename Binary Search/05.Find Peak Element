//bruteforce
TC: O(n) — In the worst case, the loop traverses all elements.

SC: O(1) — Only a constant amount of extra space is used.

class Solution {
public:
    int findPeakElement(vector<int>& nums) {
        int n = nums.size();
        if(n == 1)
        {
            return 0;
        }
        if (nums[0] > nums[1]) {
            return 0;
        }

        if (nums[n - 1] > nums[n - 2]) {
            return n - 1;
        }

        for(int i = 1; i < n - 1; i++)
        {
            if(nums[i-1] < nums[i] && nums[i] > nums[i+1])
            {
                return i;
            }
        }
        return n-1;
    }
};


//optimal
TC: O(log n)

SC: O(1)

class Solution {
public:
    int check(vector<int>& nums,int mid)
    {
        if(mid == nums.size() - 1 || nums[mid] > nums[mid + 1])
        {
            return 1;
        }
        else
        {
            return 0;
        }
    }
    int findPeakElement(vector<int>& nums) {
        int n = nums.size();
        int l = 0;
        int h = n - 1;
        int ans = -1;
        while(l <= h)
        {
            int mid = l+(h-l)/2;
            if(check(nums,mid))
            {
                
                 h = mid - 1;
                 ans = mid;
            }
            else
            {
               
                l = mid + 1;
            }
        }
        return ans;
    }
};
