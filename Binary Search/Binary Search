Time Complexity (TC): O(log n)
Space Complexity (SC): O(1)

class Solution {
	public:
	  
	 int check(vector<int>& arr,int mid,int k)
      {
          if(arr[mid] > k)
          {
              return 1;
          }
          else
          {
              return 0;
          }
      }
	bool binarySearch(vector<int>& arr, int k) {
	    int n = arr.size();
		int l = 0;
		int h = n - 1;

		while (l <= h)
		{
			int mid = (l + h)/2;
			if(arr[mid] == k) return true;
			if (check(arr,mid,k) == 0)
			{
				l = mid + 1;
			}
			else
			{
				h = mid - 1;
			}
		}
		return false;
		
	}
};
