class Solution {
	public:
	int check(int mid, vector<int>& nums, int target) {
		if (nums[mid] >= target) {
			return 1;
		} else {
			return 0;
		}
	}
	
	int findCeil(vector<int>& arr, int x) {
		int n = arr.size();
		int l = 0;
		int h = n - 1;
		int ans = -1;
		while (l <= h) {
			int mid = (l + h) / 2;
			
		  if(check(mid,arr,x) == 0) 
           {
               l = mid + 1;
           }
           else
           {
               h = mid - 1; 
               ans = mid;
           }
		}
		return ans;
		
	}
};
