class Solution {
  public:
    int lastOcc(vector<int>& arr, int target)
    {
        int l = 0;
        int h = arr.size() - 1;
        int ans = -1;
        while(l <= h)
        {
            int mid = l+(h-l)/2;
            if(arr[mid] == target)
            {
                ans = mid;
                l = mid + 1;
            }
            else if(arr[mid] > target)
            {
                h = mid - 1;
            }
            else
            {
                l = mid + 1;
            }
        }
        return ans;
    }
    
    int firstOcc(vector<int>& arr, int target)
    {
        int l = 0;
        int h = arr.size() - 1;
        int ans = -1;
        while(l <= h)
        {
            int mid = l+(h-l)/2;
            if(arr[mid] == target)
            {
                ans = mid;
                h = mid - 1;
            }
            else if(arr[mid] < target)
            {
                l = mid + 1;
            }
            else
            {
                h = mid - 1;
            }
        }
        return ans;
    }
    int countFreq(vector<int>& arr, int target) {
        int n = arr.size();
        int first = firstOcc(arr,target);
        int last = lastOcc(arr,target);
        
        if (first == -1) return 0;
        return last - first + 1;
    }
};
