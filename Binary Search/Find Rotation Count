class Solution {
  public:
    int findKRotation(vector<int> &arr) {
        int n = arr.size();
        int ans = 0;
        
        int l = 1;
        int h = n - 1;
        while(l <= h)
        {
            int mid = l+(h-l)/2;
            if(arr[mid] > arr[h])
            {
                l = mid + 1;
            }
            else
            {
                ans = mid;
                h = mid - 1;
            }
        }
        return l;
        
    }
};
