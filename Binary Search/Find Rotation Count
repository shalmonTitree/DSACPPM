class Solution {
  public:
    int findKRotation(vector<int> &arr) {
        int n = arr.size();
               int low = 0, high = n - 1;

               while (low < high) {
                   int mid = low + (high - low) / 2;

                   if (arr[mid] > arr[high]) {
                       // Minimum is on the right side
                       low = mid + 1;
                   } else {
                       // Minimum is at mid or on the left side
                       high = mid;
                   }
               }

               return low;
        
    }
};
