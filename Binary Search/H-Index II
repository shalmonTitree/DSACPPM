//bruteforce
class Solution {
public:
    int hIndex(vector<int>& citations) {
        int n = citations.size();
        int ans = 0;

        
        for(int i = 0; i < n; i++)
        {
            int curr = n - i;
            int currcnt = 0;
            for(int j = i; j < n; j++)
            {
                if(citations[j] >= curr)
                {
                    currcnt++;
                }
            }
            if(currcnt >= curr)
            {
                if(curr >= ans)
                {
                    ans = curr;
                }
            }
        }
        return ans;
    }
};


//optimal 
class Solution {
public:
    
    int hIndex(vector<int>& citations) {
        int n = citations.size();
        int ans = 0;

        int l = 0;
        int h = n - 1;
        while(l <= h)
        {
            int mid = l+(h-l)/2;
            if(citations[mid] >= n - mid)
            {
                ans = max(ans, n - mid);
                h = mid - 1;
            }
            else
            {
                l = mid + 1;
            }
        }
        return ans;
    }
};




