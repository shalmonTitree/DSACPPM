//bruteforce
TC: O(n * D)

SC: O(1)

Where:
n = size of bloomDay
D = max(bloomDay) - min(bloomDay) + 1

class Solution {
public:
    int minDays(vector<int>& bloomDay, int m, int k) {
        int n = bloomDay.size();
        int cnt = 0;
        int low = *min_element(bloomDay.begin(), bloomDay.end());
        int high = *max_element(bloomDay.begin(), bloomDay.end());
        int ans = INT_MAX;
        if(m*k > n)
        {
            return -1;
        }
        for(int i = low; i <= high; i++)
        {
            int boq = 0;
            int curr = 0;
            for(int j = 0; j < n; j++)
            {
                if(bloomDay[j] <= i)
                {
                    curr++;
                    if(curr == k)
                    {
                        boq++;
                        curr = 0;
                    }
                }
                else
                {
                    curr = 0;
                }
            }
            if(boq >= m)
            {
                ans = min(ans,i);
            }
        }
        if(ans == INT_MAX)
        {
            return -1;
        }
        return ans;
    }
};

//binaryseach
TC: O(n * log D)

SC: O(1)

Where:
- n = size of bloomDay
- D = max(bloomDay) - min(bloomDay) + 1
The check() function takes O(n) time, and binary search runs in O(log D) iterations.

class Solution {
public:
    int check(vector<int>& bloomDay,int day,int k)
    {
        int boq = 0;
        int cnt = 0;
        for(int i = 0; i < bloomDay.size(); i++)
        {
            if(bloomDay[i] <= day)
            {
                cnt++;
                if(cnt == k)
                {
                    boq++;
                    cnt = 0;
                }
            }
            else
            {
                cnt = 0;
            }
        }
        return boq;
    }
    int minDays(vector<int>& bloomDay, int m, int k) {
        int n = bloomDay.size();
        int cnt = 0;
        int low = *min_element(bloomDay.begin(), bloomDay.end());
        int high = *max_element(bloomDay.begin(), bloomDay.end());
        int ans = INT_MAX;
        if(1LL*m*k > n)
        {
            return -1;
        }
        

        while(low <= high)
        {
            int mid = low + (high - low)/2;
            if(check(bloomDay,mid,k) >= m)
            {
                
                high = mid - 1;
                ans = min(ans,mid);
            }
            else
            {
                
                low = mid + 1;
            }
        }
        if(ans == INT_MAX)
        {
            return -1;
        }
        return ans;
    }
};
