
#include <bits/stdc++.h>
using namespace std;

typedef long long ll;

long long baseToDecimal(string s, int base)
{
    long long res = 0;

    for (char c : s)
    {
        int val;

        if (isdigit(c))
        {
            val = c - '0';
        }
        else
        {
            val = c - 'A' + 10;
        }

        res = res * base + val;
    }

    return res;
}

void solve()
{
    string n;
    int base;

    cin >> n >> base;

    if (base < 2 || base > 16)
    {
        cout << "Invalid Base" << endl;
        return;
    }

    cout << baseToDecimal(n, base) << endl;
}

int main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    // cin >> t;

    while (t--)
    {
        solve();
    }

    return 0;
}
