#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

string decimalToBase(long long n,int base)
{
    if(n == 0)
    {
        return "0";
    }

    string digits = "0123456789ABCDEF";
    string res = "";

    while(n > 0)
    {
        int rem = n % base;
        res.push_back(digits[rem]);
        n /= base;
    }

    reverse(res.begin(),res.end());
    return res;
}
void solve() {
    long long n;
    int base;

    cin >> n >> base;

    if (base < 2 || base > 16)
    {
        cout << "Invalid Base" << endl;
        return;
    }

    cout << decimalToBase(n, base) << endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    // cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
