//bruteforce
Time: O(2^N)
Space: O(N)

class Solution{
public:
    bool solve(int idx, int target, int arr[])
    {
        if (target == 0)
            return true;

        if (idx == 0)
            return arr[0] == target;

        bool notTake = solve(idx - 1, target, arr);

        bool take = false;
        if (arr[idx] <= target)
            take = solve(idx - 1, target - arr[idx], arr);

        return take || notTake;
    }

    int equalPartition(int N, int arr[])
    {
        int sum = 0;
        for (int i = 0; i < N; i++)
            sum += arr[i];

        if (sum % 2)
            return 0;

        return solve(N - 1, sum / 2, arr);
    }
};

//memo
Time: O(N × Sum)
Space: O(N × Sum) + O(N)

class Solution{
public:
    bool solve(int idx, int target, int arr[],
               vector<vector<int>> &dp)
    {
        if (target == 0)
            return true;

        if (idx == 0)
            return arr[0] == target;

        if (dp[idx][target] != -1)
            return dp[idx][target];

        bool notTake = solve(idx - 1, target, arr, dp);

        bool take = false;
        if (arr[idx] <= target)
            take = solve(idx - 1, target - arr[idx], arr, dp);

        return dp[idx][target] = take || notTake;
    }

    int equalPartition(int N, int arr[])
    {
        int sum = 0;
        for (int i = 0; i < N; i++)
            sum += arr[i];

        if (sum % 2)
            return 0;

        vector<vector<int>> dp(N, vector<int>(sum / 2 + 1, -1));

        return solve(N - 1, sum / 2, arr, dp);
    }
};

//tabulation
Time: O(N × Sum)
Space: O(N × Sum)
class Solution{
public:
    int equalPartition(int N, int arr[])
    {
        int sum = 0;
        for (int i = 0; i < N; i++)
            sum += arr[i];

        if (sum % 2)
            return 0;

        int target = sum / 2;

        vector<vector<bool>> dp(N + 1,
                                vector<bool>(target + 1, false));

        // Base case
        for (int i = 0; i <= N; i++)
            dp[i][0] = true;

        for (int idx = 1; idx <= N; idx++)
        {
            for (int tar = 1; tar <= target; tar++)
            {
                bool notTake = dp[idx - 1][tar];

                bool take = false;
                if (arr[idx - 1] <= tar)
                    take = dp[idx - 1][tar - arr[idx - 1]];

                dp[idx][tar] = take || notTake;
            }
        }

        return dp[N][target];
    }
};
