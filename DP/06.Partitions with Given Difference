//bruteforce
Time Complexity	O(2^n)
Space Complexity	O(n)

class Solution {
	public:
	int solve(int idx, int tar, vector<int>& arr)
	{
		if (idx == 0)
			{
			if (tar == 0 && arr[0] == 0)
				return 2;
			if (tar == 0 || arr[0] == tar)
				return 1;
			return 0;
		}
		
		int nottake = solve(idx - 1, tar, arr);
		
		int take = 0;
		if (arr[idx] <= tar)
			{
			take = solve(idx - 1, tar - arr[idx], arr);
		}
		return take + nottake;
		
	}
	int countPartitions(vector<int>& arr, int d) {
		int totalSum = accumulate(arr.begin(), arr.end(), 0);
		if ((totalSum + d) % 2 != 0)
			return 0;
		
		int target = (totalSum + d) / 2;
		return solve(arr.size() - 1, target, arr);
		
	}
};

//memo
class Solution {
public:
    int mod = 1e9 + 7;

    int solve(int idx, int tar, vector<int>& arr, vector<vector<int>>& dp)
    {
        if (idx == 0)
        {
            if (tar == 0 && arr[0] == 0)
                return 2;

            if (tar == 0 || arr[0] == tar)
                return 1;

            return 0;
        }

        if (dp[idx][tar] != -1)
            return dp[idx][tar];

        int notTake = solve(idx - 1, tar, arr, dp);

        int take = 0;
        if (arr[idx] <= tar)
            take = solve(idx - 1, tar - arr[idx], arr, dp);

        return dp[idx][tar] = (take + notTake) % mod;
    }

    int countPartitions(vector<int>& arr, int d)
    {
        int totalSum = accumulate(arr.begin(), arr.end(), 0);

        // Impossible cases
        if (totalSum < d)
            return 0;

        if ((totalSum + d) % 2 != 0)
            return 0;

        int target = (totalSum + d) / 2;

        vector<vector<int>> dp(arr.size(), vector<int>(target + 1, -1));

        return solve(arr.size() - 1, target, arr, dp);
    }
};

//tabu
Complexity	Value
Time Complexity	O(n × target) (or O(n × totalSum))
Space Complexity	O(n × target)

class Solution {
public:
    int mod = 1e9 + 7;

    int countPartitions(vector<int>& arr, int d) {

        int n = arr.size();
        int totalSum = accumulate(arr.begin(), arr.end(), 0);

        // Impossible cases
        if (totalSum < d || (totalSum + d) % 2 != 0)
            return 0;

        int target = (totalSum + d) / 2;

        vector<vector<int>> dp(n + 1, vector<int>(target + 1, 0));

        // Base case
        dp[0][0] = 1;

        for (int idx = 1; idx <= n; idx++)
        {
            for (int sum = 0; sum <= target; sum++)
            {
                int notTake = dp[idx - 1][sum];

                int take = 0;
                if (arr[idx - 1] <= sum)
                    take = dp[idx - 1][sum - arr[idx - 1]];

                dp[idx][sum] = (take + notTake) % mod;
            }

            // Handle zeros
            if (arr[idx - 1] == 0)
            {
                for (int sum = 0; sum <= target; sum++)
                    dp[idx][sum] = (2 * dp[idx - 1][sum]) % mod;
            }
        }

        return dp[n][target];
    }
};
