//bruteforce
Approach	
Time Complexity	
Recursion	O(2^n)	
Space Complexity
O(n)

class Solution {
public:
    int solve(int idx,int newtarget,vector<int>& nums)
    {
        if(idx == 0)
        {
            if(newtarget == 0 && nums[0] == 0)
            {
                return 2;
            }

            if(newtarget == 0 || nums[0] == newtarget)
            {
                return 1;
            }

            return 0;
        }

        int nottake = solve(idx - 1,newtarget,nums);
        int take = 0;
        if(nums[idx] <= newtarget)
        {
            take = solve(idx-1,newtarget - nums[idx],nums);
        }

        return take+nottake;
    }
    int findTargetSumWays(vector<int>& nums, int target) {
        int n = nums.size();
        int totalsum = 0;
        for(int i = 0; i < n; i++)
        {
            totalsum += nums[i];
        }

        if(totalsum < target || (totalsum + target) % 2 != 0)
        {
            return 0;
        }

        int newtarget = (totalsum + target)/2;

        return solve(n-1,newtarget,nums);
    }
};

//memo
Complexity	Value
Time Complexity	O(n × newtarget) (≈ O(n × totalSum))
Space Complexity	O(n × newtarget) + O(n)

class Solution {
public:
    int solve(int idx, int newtarget, vector<int>& nums,
              vector<vector<int>>& dp) {
        if (idx == 0) {
            if (newtarget == 0 && nums[0] == 0) {
                return 2;
            }

            if (newtarget == 0 || nums[0] == newtarget) {
                return 1;
            }

            return 0;
        }

        if (dp[idx][newtarget] != -1) {
            return dp[idx][newtarget];
        }
        int nottake = solve(idx - 1, newtarget, nums, dp);
        int take = 0;
        if (nums[idx] <= newtarget) {
            take = solve(idx - 1, newtarget - nums[idx], nums, dp);
        }

        return dp[idx][newtarget] = take + nottake;
    }
    int findTargetSumWays(vector<int>& nums, int target) {
        int n = nums.size();
        int totalsum = 0;
        for (int i = 0; i < n; i++) {
            totalsum += nums[i];
        }
        if (abs(target) > totalsum)
            return 0;
        if (totalsum < target || (totalsum + target) % 2 != 0) {
            return 0;
        }

        int newtarget = (totalsum + target) / 2;
        vector<vector<int>> dp(n, vector<int>(newtarget + 1, -1));
        return solve(n - 1, newtarget, nums, dp);
    }
};

//tabu
Complexity	Value
Time Complexity	O(n × newtarget) (≈ O(n × totalSum))
Space Complexity	O(n × newtarget) (≈ O(n × totalSum))

class Solution {
public:
    
    int findTargetSumWays(vector<int>& nums, int target) {
        int n = nums.size();
        int totalsum = 0;
        for (int i = 0; i < n; i++) {
            totalsum += nums[i];
        }
        if (abs(target) > totalsum)
            return 0;
        if (totalsum < target || (totalsum + target) % 2 != 0) {
            return 0;
        }

        int newtarget = (totalsum + target) / 2;
        vector<vector<int>> dp(n, vector<int>(newtarget + 1, 0));

        if(nums[0] == 0)
        {
            dp[0][0] = 2;
        }
        else
        {
            dp[0][0] = 1;
        }

        if(nums[0] != 0 && nums[0] <= newtarget)
        {
            dp[0][nums[0]] = 1;
        }
        for (int idx = 1; idx < n; idx++) {
            for (int target = 0; target <= newtarget; target++) {

                int nottake = dp[idx - 1][target];
                int take = 0;
                if (nums[idx] <= target) {
                    take = dp[idx - 1][target - nums[idx]];
                }

                dp[idx][target] = take + nottake;
            }
        }
        return dp[n - 1][newtarget];
    }
};
