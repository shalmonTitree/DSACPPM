//bruteforce
Time Complexity
O(2^n) (exponential recursion)
Space Complexity
O(W) recursion stack in the worst case because repeated "take" calls reduce capacity while staying on the same index.

class Solution {
public:
    int solve(int idx, int W, vector<int>& val, vector<int>& wt)
    {
        if (idx == 0)
        {
            return (W / wt[0]) * val[0];
        }

        int notTake = solve(idx - 1, W, val, wt);

        int take = 0;
        if (wt[idx] <= W)
            take = val[idx] + solve(idx, W - wt[idx], val, wt);

        return max(take, notTake);
    }

    int knapSack(vector<int>& val, vector<int>& wt, int W)
    {
        int n = val.size();
        return solve(n - 1, W, val, wt);
    }
};


//memo
Time Complexity
O(n × W)
Space Complexity
O(n × W) + O(W)
DP table: O(n × W)
Recursion stack: O(W)

class Solution {
public:
    int solve(int idx, int W, vector<int>& val,
              vector<int>& wt, vector<vector<int>>& dp)
    {
        if (idx == 0)
        {
            return (W / wt[0]) * val[0];
        }

        if (dp[idx][W] != -1)
            return dp[idx][W];

        int notTake = solve(idx - 1, W, val, wt, dp);

        int take = 0;
        if (wt[idx] <= W)
            take = val[idx] + solve(idx, W - wt[idx], val, wt, dp);

        return dp[idx][W] = max(take, notTake);
    }

    int knapSack(vector<int>& val, vector<int>& wt, int W)
    {
        int n = val.size();

        vector<vector<int>> dp(n, vector<int>(W + 1, -1));

        return solve(n - 1, W, val, wt, dp);
    }
};


//tabu
Time Complexity
O(n × W)
Space Complexity
O(n × W)

class Solution {
public:
    int knapSack(vector<int>& val, vector<int>& wt, int W)
    {
        int n = val.size();

        vector<vector<int>> dp(n, vector<int>(W + 1, 0));

        // Base case
        for (int w = 0; w <= W; w++)
        {
            dp[0][w] = (w / wt[0]) * val[0];
        }

        for (int idx = 1; idx < n; idx++)
        {
            for (int w = 0; w <= W; w++)
            {
                int notTake = dp[idx - 1][w];

                int take = 0;
                if (wt[idx] <= w)
                    take = val[idx] + dp[idx][w - wt[idx]];

                dp[idx][w] = max(take, notTake);
            }
        }

        return dp[n - 1][W];
    }
};
