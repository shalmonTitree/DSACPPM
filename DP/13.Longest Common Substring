//=========================================================
// Longest Common Substring
// 1. Recursion
// 2. Memoization
// 3. Tabulation
//=========================================================

#include <bits/stdc++.h>
using namespace std;

class Solution {
public:

    //=====================================================
    // 1. RECURSION
    //=====================================================

    int solveRec(int i, int j, int cnt, string &s1, string &s2) {

        if (i == s1.size() || j == s2.size())
            return cnt;

        int ans = cnt;

        if (s1[i] == s2[j])
            ans = solveRec(i + 1, j + 1, cnt + 1, s1, s2);

        ans = max(ans, solveRec(i + 1, j, 0, s1, s2));
        ans = max(ans, solveRec(i, j + 1, 0, s1, s2));

        return ans;
    }

    int longCommSubstrRec(string &s1, string &s2) {
        return solveRec(0, 0, 0, s1, s2);
    }

    /*
    Time Complexity : O(3^(N+M))
    Space Complexity: O(N+M)
    */


    //=====================================================
    // 2. MEMOIZATION
    //=====================================================

    int solveMemo(int i, int j, string &s1, string &s2,
                  vector<vector<int>> &dp, int &ans) {

        if (i == s1.size() || j == s2.size())
            return 0;

        if (dp[i][j] != -1)
            return dp[i][j];

        solveMemo(i + 1, j, s1, s2, dp, ans);
        solveMemo(i, j + 1, s1, s2, dp, ans);

        if (s1[i] == s2[j]) {
            dp[i][j] = 1 + solveMemo(i + 1, j + 1, s1, s2, dp, ans);
            ans = max(ans, dp[i][j]);
        }
        else {
            dp[i][j] = 0;
        }

        return dp[i][j];
    }

    int longCommSubstrMemo(string &s1, string &s2) {

        int n = s1.size();
        int m = s2.size();

        vector<vector<int>> dp(n, vector<int>(m, -1));

        int ans = 0;

        solveMemo(0, 0, s1, s2, dp, ans);

        return ans;
    }

    /*
    Time Complexity : O(N*M)
    Space Complexity: O(N*M) + O(N+M) recursion stack
    */


    //=====================================================
    // 3. TABULATION
    //=====================================================

    int longCommSubstr(string &s1, string &s2) {

        int n = s1.size();
        int m = s2.size();

        vector<vector<int>> dp(n + 1, vector<int>(m + 1, 0));

        int ans = 0;

        for (int i = 1; i <= n; i++) {

            for (int j = 1; j <= m; j++) {

                if (s1[i - 1] == s2[j - 1]) {
                    dp[i][j] = 1 + dp[i - 1][j - 1];
                    ans = max(ans, dp[i][j]);
                }
                else {
                    dp[i][j] = 0;
                }
            }
        }

        return ans;
    }

    /*
    Time Complexity : O(N*M)
    Space Complexity: O(N*M)
    */


    //=====================================================
    // 4. SPACE OPTIMIZED (Best)
    //=====================================================

    int longCommSubstrSO(string &s1, string &s2) {

        int n = s1.size();
        int m = s2.size();

        vector<int> prev(m + 1, 0), curr(m + 1, 0);

        int ans = 0;

        for (int i = 1; i <= n; i++) {

            for (int j = 1; j <= m; j++) {

                if (s1[i - 1] == s2[j - 1]) {
                    curr[j] = 1 + prev[j - 1];
                    ans = max(ans, curr[j]);
                }
                else {
                    curr[j] = 0;
                }
            }

            prev = curr;
            fill(curr.begin(), curr.end(), 0);
        }

        return ans;
    }

    /*
    Time Complexity : O(N*M)
    Space Complexity: O(M)
    */
};
