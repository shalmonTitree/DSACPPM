PRINT LONGEST COMMON SUBSEQUENCE (LCS)

============================================================
1. RECURSION
============================================================

class Solution {
public:
    int solve(int i, int j, string &s, string &t)
    {
        if(i < 0 || j < 0)
            return 0;

        if(s[i] == t[j])
            return 1 + solve(i - 1, j - 1, s, t);

        return max(solve(i - 1, j, s, t),
                   solve(i, j - 1, s, t));
    }

    string findLCS(string &s, string &t)
    {
        int i = s.size() - 1;
        int j = t.size() - 1;

        string ans = "";

        while(i >= 0 && j >= 0)
        {
            if(s[i] == t[j])
            {
                ans += s[i];
                i--;
                j--;
            }
            else
            {
                int up = solve(i - 1, j, s, t);
                int left = solve(i, j - 1, s, t);

                if(up >= left)
                    i--;
                else
                    j--;
            }
        }

        reverse(ans.begin(), ans.end());
        return ans;
    }
};

Time Complexity:
- Computing recursive calls repeatedly: O(2^(N+M))
- Reconstruction: O(N+M)

Overall TC: O(2^(N+M))

Space Complexity:
- Recursive Stack: O(N+M)
- Answer String: O(L)

Overall SC: O(N+M)

where L = Length of LCS.


