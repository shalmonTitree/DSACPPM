2. MEMOIZATION
============================================================

class Solution {
public:
    int solve(int i, int j, string &s, string &t,
              vector<vector<int>> &dp)
    {
        if(i < 0 || j < 0)
            return 0;

        if(dp[i][j] != -1)
            return dp[i][j];

        if(s[i] == t[j])
            return dp[i][j] = 1 + solve(i - 1, j - 1, s, t, dp);

        return dp[i][j] = max(solve(i - 1, j, s, t, dp),
                              solve(i, j - 1, s, t, dp));
    }

    string findLCS(string &s, string &t)
    {
        int n = s.size();
        int m = t.size();

        vector<vector<int>> dp(n, vector<int>(m, -1));

        solve(n - 1, m - 1, s, t, dp);

        int i = n - 1;
        int j = m - 1;

        string ans = "";

        while(i >= 0 && j >= 0)
        {
            if(s[i] == t[j])
            {
                ans += s[i];
                i--;
                j--;
            }
            else
            {
                int up = (i > 0) ? dp[i - 1][j] : 0;
                int left = (j > 0) ? dp[i][j - 1] : 0;

                if(up >= left)
                    i--;
                else
                    j--;
            }
        }

        reverse(ans.begin(), ans.end());

        return ans;
    }
};

Time Complexity:
- DP Computation: O(N × M)
- Reconstruction: O(N+M)

Overall TC: O(N × M)

Space Complexity:
- DP Table: O(N × M)
- Recursive Stack: O(N+M)
- Answer String: O(L)

Overall SC: O(N × M) + O(N+M)

where L = Length of LCS.


