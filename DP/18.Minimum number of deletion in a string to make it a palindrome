MINIMUM NUMBER OF DELETIONS TO MAKE A STRING PALINDROME (GFG)

Formula:

LPS = Longest Palindromic Subsequence
LPS = LCS(s, reverse(s))

Answer = n - LPS

------------------------------------------------------------
1. RECURSION
------------------------------------------------------------

class Solution{
public:
    int solve(int i, int j, string &s, string &rev)
    {
        if(i < 0 || j < 0)
            return 0;

        if(s[i] == rev[j])
            return 1 + solve(i - 1, j - 1, s, rev);

        return max(solve(i - 1, j, s, rev),
                   solve(i, j - 1, s, rev));
    }

    int minDeletions(string s)
    {
        string rev = s;
        reverse(rev.begin(), rev.end());

        int lps = solve(s.size() - 1, rev.size() - 1, s, rev);

        return s.size() - lps;
    }
};

Time Complexity : O(2^(2n))
Space Complexity: O(2n)

------------------------------------------------------------
2. MEMOIZATION (TOP-DOWN DP)
------------------------------------------------------------

class Solution{
public:
    int solve(int i, int j, string &s, string &rev,
              vector<vector<int>> &dp)
    {
        if(i < 0 || j < 0)
            return 0;

        if(dp[i][j] != -1)
            return dp[i][j];

        if(s[i] == rev[j])
            return dp[i][j] = 1 + solve(i - 1, j - 1, s, rev, dp);

        return dp[i][j] = max(solve(i - 1, j, s, rev, dp),
                              solve(i, j - 1, s, rev, dp));
    }

    int minDeletions(string s)
    {
        string rev = s;
        reverse(rev.begin(), rev.end());

        int n = s.size();

        vector<vector<int>> dp(n, vector<int>(n, -1));

        int lps = solve(n - 1, n - 1, s, rev, dp);

        return n - lps;
    }
};

Time Complexity : O(n*n)
Space Complexity: O(n*n) + O(2n)

------------------------------------------------------------
3. TABULATION (BOTTOM-UP DP)
------------------------------------------------------------

class Solution{
public:
    int minDeletions(string s)
    {
        string rev = s;
        reverse(rev.begin(), rev.end());

        int n = s.size();

        vector<vector<int>> dp(n + 1, vector<int>(n + 1, 0));

        for(int i = 1; i <= n; i++)
        {
            for(int j = 1; j <= n; j++)
            {
                if(s[i - 1] == rev[j - 1])
                    dp[i][j] = 1 + dp[i - 1][j - 1];
                else
                    dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]);
            }
        }

        int lps = dp[n][n];

        return n - lps;
    }
};

Time Complexity : O(n*n)
Space Complexity: O(n*n)
