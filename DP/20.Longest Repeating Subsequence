LONGEST REPEATING SUBSEQUENCE (GFG)

Formula:

LRS = LCS(s, s)
Condition: i != j

------------------------------------------------------------
1. RECURSION
------------------------------------------------------------

class Solution {
public:
    int solve(int i, int j, string &s)
    {
        if(i < 0 || j < 0)
            return 0;

        if(s[i] == s[j] && i != j)
            return 1 + solve(i - 1, j - 1, s);

        return max(solve(i - 1, j, s),
                   solve(i, j - 1, s));
    }

    int LongestRepeatingSubsequence(string str)
    {
        int n = str.size();

        return solve(n - 1, n - 1, str);
    }
};

Time Complexity : O(2^(2n))
Space Complexity: O(2n)

------------------------------------------------------------
2. MEMOIZATION (TOP-DOWN DP)
------------------------------------------------------------

class Solution {
public:
    int solve(int i, int j, string &s,
              vector<vector<int>> &dp)
    {
        if(i < 0 || j < 0)
            return 0;

        if(dp[i][j] != -1)
            return dp[i][j];

        if(s[i] == s[j] && i != j)
            return dp[i][j] = 1 + solve(i - 1, j - 1, s, dp);

        return dp[i][j] = max(solve(i - 1, j, s, dp),
                              solve(i, j - 1, s, dp));
    }

    int LongestRepeatingSubsequence(string str)
    {
        int n = str.size();

        vector<vector<int>> dp(n, vector<int>(n, -1));

        return solve(n - 1, n - 1, str, dp);
    }
};

Time Complexity : O(n*n)
Space Complexity: O(n*n) + O(2n)

------------------------------------------------------------
3. TABULATION (BOTTOM-UP DP)
------------------------------------------------------------

class Solution {
public:
    int LongestRepeatingSubsequence(string str)
    {
        int n = str.size();

        vector<vector<int>> dp(n + 1, vector<int>(n + 1, 0));

        for(int i = 1; i <= n; i++)
        {
            for(int j = 1; j <= n; j++)
            {
                if(str[i - 1] == str[j - 1] && i != j)
                    dp[i][j] = 1 + dp[i - 1][j - 1];
                else
                    dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]);
            }
        }

        return dp[n][n];
    }
};

Time Complexity : O(n*n)
Space Complexity: O(n*n)
