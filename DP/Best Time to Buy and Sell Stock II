class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int totalProfit = 0;

        for (int i = 1; i < prices.size(); i++) {
            if (prices[i] > prices[i - 1]) {
                totalProfit += prices[i] - prices[i - 1];
            }
        }

        return totalProfit;
    }
};


//rec
Approach	Time Complexity	Space Complexity
Recursion (your code)	O(2ⁿ)	O(n)
Memoization	            O(n)	O(n)
Tabulation	            O(n)	O(n)
Space Optimization	    O(n)	O(1)
class Solution {
public:
    int solve(int idx,int buy,vector<int>& prices)
    {
        //basecase
        if(idx == prices.size())
        {
            return 0;
        }

        //if you want to buy
        if(buy)
        {
            return max(-prices[idx] + solve(idx+1,0,prices), //buy
                    solve(idx+1,1,prices));//skip
        }

        //if you dont want to buy
        return max(prices[idx] + solve(idx+1,1,prices), //sell
                solve(idx+1,0,prices)); //hold

    }
    int maxProfit(vector<int>& prices) {
        return solve(0,1,prices);
    }
};

//memo
class Solution {
public:
    int solve(int idx,int buy,vector<int>& prices,vector<vector<int>>&dp)
    {
        //basecase
        if(idx == prices.size())
        {
            return 0;
        }
        
        if(dp[idx][buy] != -1)
        {
            return dp[idx][buy];
        }
        //if you want to buy
        if(buy)
        {
            return dp[idx][buy] = max(-prices[idx] + solve(idx+1,0,prices,dp), //buy
                    solve(idx+1,1,prices,dp));//skip
        }

        //if you dont want to buy
        return  dp[idx][buy] = max(prices[idx] + solve(idx+1,1,prices,dp), //sell
                solve(idx+1,0,prices,dp)); //hold

    }
    int maxProfit(vector<int>& prices) {
        int n = prices.size();
        vector<vector<int>>dp(n,vector<int>(2,-1));
        return solve(0,1,prices,dp);
    }
};

//tabu
class Solution {
public:
   
    int maxProfit(vector<int>& prices) {
        int n = prices.size();
        vector<vector<int>>dp(n+1,vector<int>(2,0));
        
        dp[n][0] = 0;
        dp[n][1] = 0;

        for(int idx = n - 1; idx>=0; idx--)
        {
            for(int buy = 0; buy <= 1; buy++)
            {
                if(buy)
                {
                    dp[idx][buy] = max(-prices[idx] + dp[idx+1][0], dp[idx+1][1]);
                }
                else
                {
                    dp[idx][buy] = max(prices[idx] + dp[idx+1][1], dp[idx+1][0]);
                }
            }
        }
        return dp[0][1];
    }
};

//space
Array	Meaning
ahead[0]	Next day's profit when holding a stock
ahead[1]	Next day's profit when allowed to buy
curr[0]	Current day's profit when holding a stock
curr[1]	Current day's profit when allowed to buy

class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int n = prices.size();

        vector<int> ahead(2, 0);
        vector<int> curr(2, 0);

        for(int idx = n - 1; idx >= 0; idx--)
        {
            // buy = 1: Can buy a stock
            curr[1] = max(
                -prices[idx] + ahead[0],
                ahead[1]
            );

            // buy = 0: Holding a stock
            curr[0] = max(
                prices[idx] + ahead[1],
                ahead[0]
            );

            ahead = curr;
        }

        return ahead[1];
    }
};
