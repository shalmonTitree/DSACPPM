class Solution {
public:

    int solve(int idx, int buy, int cap, vector<int>& prices)
    {
        // base case
        if(idx == prices.size() || cap == 0)
        {
            return 0;
        }

        // if you want to buy
        if(buy)
        {
            return max(
                -prices[idx] + solve(idx + 1, 0, cap, prices), // buy
                solve(idx + 1, 1, cap, prices)                 // skip
            );
        }

        // if you want to sell
        return max(
            prices[idx] + solve(idx + 1, 1, cap - 1, prices), // sell
            solve(idx + 1, 0, cap, prices)                    // hold
        );
    }

    int maxProfit(int k, vector<int>& prices)
    {
        return solve(0, 1, k, prices);
    }
};
```

**Time:** `O(2^n)`
**Space:** `O(n)` recursion stack


