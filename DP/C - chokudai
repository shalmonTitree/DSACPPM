#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl
const int MOD = 1e9 + 7;
int fun(int i,int j,string &s, string &target)
{

    if(j == target.size())
    {
        return 1;
    }

    if(i == s.size())
    {
        return 0;
    }
    

    if(s[i] == target[j])
    {
        int nottake = fun(i+1,j,s,target);
        int take = fun(i+1,j+1,s,target);

        return take + nottake;

    }
    else
    {
        return fun(i+1,j,s,target);
    }
}
