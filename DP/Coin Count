TC: O(n × m)
SC: O(m) 

#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n" // optional, better to avoid redefining endl
const int MOD = 1000000007;

int solve(vector<int> &v, int tar,vector<int>&dp)
{
    if(tar == 0)
    {
        return 1;
    }

    if(dp[tar] != -1) return dp[tar];

    int cnt = 0;
    for(int i = 0; i < v.size(); i++)
    {
        if(v[i] <= tar)
        {
            cnt = (cnt + solve(v,tar-v[i],dp))%MOD;
        }
    }

    return dp[tar] = cnt;


}
void solve()
{
    int n, m;
    cin >> n >> m;
    vector<int> v(n);
    for (int i = 0; i < n; i++)
    {
        cin >> v[i];
    }
    vector<int>dp(m+1,-1);

    cout << solve(v, m, dp) << endl;
}

int main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    // cin >> t;
    while (t--)
    {
        solve();
    }

    return 0;
}

//tabu
Time Complexity: O(n × m)
Space Complexity: O(m)

#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n" // optional, better to avoid redefining endl
const int MOD = 1000000007;

void solve()
{
    int n, m;
    cin >> n >> m;
    vector<int> v(n);
    for (int i = 0; i < n; i++)
    {
        cin >> v[i];
    }
    vector<int>dp(m+1,0);

    dp[0] = 1;

    for(int sum = 1; sum <= m; sum++)
    {
        for(int i = 0; i < n; i++)
        {
            if(v[i] <= sum)
            {
                dp[sum] = (dp[sum] + dp[sum - v[i]])%MOD;
            }
        }
    }

    cout << dp[m] << endl;
}

int main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    // cin >> t;
    while (t--)
    {
        solve();
    }

    return 0;
}


