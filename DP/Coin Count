Time Limit: 2 sec
Memory Limit: 256 MB

Description

Consider a money system consisting of n coins. Each coin has a positive integer value. Your task is to calculate the number of distinct ways you can produce a money sum x using the available coins.

Input Format

- The first line contains two integers n and x, denoting the number of coins and the desired sum of money.
- The second line contains n distinct integers C1, C2, ..., Cn, where Ci is the value of the i-th coin.

Output Format

Print one integer: the number of ways modulo 10^9 + 7.

Constraints

1 ≤ n ≤ 100
1 ≤ x, Ci ≤ 10^6
The array C contains distinct integers.

Sample Input 1

3 9
2 3 5

Sample Output 1

8

Sample Input 2

3 6
2 3 5

Sample Output 2

2

Sample Input 3

3 7
2 3 5

Sample Output 3

5

Explanation

In the first test case, there are 8 ways:

2 + 2 + 5
2 + 5 + 2
5 + 2 + 2
3 + 3 + 3
2 + 2 + 2 + 3
2 + 2 + 3 + 2
2 + 3 + 2 + 2
3 + 2 + 2 + 2

//rec
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl
const int MOD = 1e9 + 7;

ll func(const vector<int>&v,int tar)
{
    if(tar == 0) return 1;

    ll ans = 0;
    for(auto it : v)
    {
        if(tar >= it)
        {
            ans =  (ans + func(v,tar - it)) % MOD;
        }
        
    }

    return ans;
}

void solve() {
    int n,tar;
    cin>>n>>tar;
    vector<int>v(n);
    for(int i = 0; i < n; i++)cin>>v[i];
    cout<<func(v,tar)<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
   // cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}


//memo
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl
const int MOD = 1e9 + 7;

ll func(const vector<int>&v,int tar,vector<int>&dp)
{
    if(tar == 0) return 1;
    if(dp[tar] != -1) return dp[tar];

    ll ans = 0;
    for(auto it : v)
    {
        if(tar >= it)
        {
            ans =  (ans + func(v,tar - it,dp)) % MOD;
        }
        
    }

    return dp[tar] = ans;
}

void solve() {
    int n,tar;
    cin>>n>>tar;
    vector<int>v(n);
    for(int i = 0; i < n; i++)cin>>v[i];
    vector<int>dp(tar+1,-1);
    cout<<func(v,tar,dp)<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    //cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}

//tabu
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl
const int MOD = 1e9 + 7;

void solve() {
    int n,tar;
    cin>>n>>tar;
    vector<int>v(n);
    for(int i = 0; i < n; i++)cin>>v[i];
    vector<int>dp(tar+1,0);

    dp[0] = 1;

    for(int sum = 1; sum <= tar; sum++)
    {
        for(auto it : v)
        {
            if(sum >= it)
            {
                dp[sum] = (dp[sum] + dp[sum - it]) % MOD;
            }
        }
    }
    cout<<dp[tar]<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    //cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
