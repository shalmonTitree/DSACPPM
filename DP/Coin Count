Time Limit: 2 sec
Memory Limit: 256 MB

Description

Consider a money system consisting of n coins. Each coin has a positive integer value. Your task is to calculate the number of distinct ways you can produce a money sum x using the available coins.

Input Format

- The first line contains two integers n and x, denoting the number of coins and the desired sum of money.
- The second line contains n distinct integers C1, C2, ..., Cn, where Ci is the value of the i-th coin.

Output Format

Print one integer: the number of ways modulo 10^9 + 7.

Constraints

1 ≤ n ≤ 100
1 ≤ x, Ci ≤ 10^6
The array C contains distinct integers.

Sample Input 1

3 9
2 3 5

Sample Output 1

8

Sample Input 2

3 6
2 3 5

Sample Output 2

2

Sample Input 3

3 7
2 3 5

Sample Output 3

5

Explanation

In the first test case, there are 8 ways:

2 + 2 + 5
2 + 5 + 2
5 + 2 + 2
3 + 3 + 3
2 + 2 + 2 + 3
2 + 2 + 3 + 2
2 + 3 + 2 + 2
3 + 2 + 2 + 2

//Recursion
Time Complexity: O(n^x) (exponential)
Space Complexity: O(x) (recursion stack)

#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n" // optional, better to avoid redefining endl
const int MOD = 1000000007;

int solve(vector<int> &v, int tar)
{
    if(tar == 0)
    {
        return 1;
    }

    int cnt = 0;
    for(int i = 0; i < v.size(); i++)
    {
        if(v[i] <= tar)
        {
            cnt = (cnt + solve(v,tar-v[i]))%MOD;
        }
    }

    return cnt;


}
void solve()
{
    int n, m;
    cin >> n >> m;
    vector<int> v(n);
    for (int i = 0; i < n; i++)
    {
        cin >> v[i];
    }

    cout << solve(v, m) << endl;
}

int main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    // cin >> t;
    while (t--)
    {
        solve();
    }

    return 0;
}

