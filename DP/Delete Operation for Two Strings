class Solution {
public:
    int solve(int i, int j,string &s, string &rev)
    {
        if(i < 0 || j < 0)
        {
            return 0;
        }

        if(s[i] == rev[j])
        {
            return 1 + solve(i-1,j-1,s,rev);
        }
        else
        {
            return max(solve(i-1,j,s,rev),solve(i,j-1,s,rev));
        }
    }

    int minDistance(string word1, string word2) {
        int n = word1.size();
        int m = word2.size();
        int lcs = solve(n-1,m-1,word1,word2);
        return (n-lcs) + (m-lcs);
    }
};




//memo
class Solution {
public:
    int solve(int i, int j,string &s, string &rev,vector<vector<int>>&dp)
    {
        if(i < 0 || j < 0)
        {
            return 0;
        }
        if(dp[i][j] != -1)
        {
            return dp[i][j];
        }
        if(s[i] == rev[j])
        {
            return dp[i][j] = 1 + solve(i-1,j-1,s,rev,dp);
        }
        else
        {
            return dp[i][j] = max(solve(i-1,j,s,rev,dp),solve(i,j-1,s,rev,dp));
        }
    }

    int minDistance(string word1, string word2) {
        int n = word1.size();
        int m = word2.size();
        vector<vector<int>>dp(n,vector<int>(m,-1));
        int lcs = solve(n-1,m-1,word1,word2,dp);
        
        return (n-lcs) + (m-lcs);
    }
};


//tabbu
class Solution {
public:
   

    int minDistance(string word1, string word2) {
        int n = word1.size();
        int m = word2.size();
        vector<vector<int>> dp(n + 1, vector<int>(m + 1, -1));

        for(int j = 0; j <= m; j++)
        {
            dp[0][j] = 0;
        }

        for(int i = 0; i <= n; i++)
        {
            dp[i][0] = 0;
        }
        
        

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= m; j++) {
                if (word1[i-1] == word2[j-1]) {
                     dp[i][j] = 1 + dp[i - 1][j - 1];
                } else {
                     dp[i][j] = max(dp[i - 1][j],dp[i][j - 1]);
                }
            }
        }
        return (n-dp[n][m]) + (m-dp[n][m]);
    }
};


