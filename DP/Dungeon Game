//rec
class Solution {
public:
    int solve(int i,int j,vector<vector<int>>& dungeon,int n,int m)
    {
        if(i >= n || j >= m)
        {
            return INT_MAX;
        }

        if(i == n-1 && j == m-1)
        {
            return max(1,1-dungeon[i][j]);
        }

        int down = solve(i+1,j,dungeon,n,m);
        int right = solve(i,j+1,dungeon,n,m);

        int need = min(down,right) - dungeon[i][j];

        return max(1,need);
    }

    int calculateMinimumHP(vector<vector<int>>& dungeon) {
        int n = dungeon.size();
        int m = dungeon[0].size();

        return solve(0,0,dungeon,n,m);
    }
};


//memo
class Solution {
public:
    int solve(int i,int j,vector<vector<int>>& dungeon,int n,int m,vector<vector<int>>dp)
    {
        if(i >= n || j >= m)
        {
            return INT_MAX;
        }

        if(i == n-1 && j == m-1)
        {
            return max(1,1-dungeon[i][j]);
        }

        if(dp[i][j] != -1)
        {
            return dp[i][j];
        }

        int down = solve(i+1,j,dungeon,n,m,dp);
        int right = solve(i,j+1,dungeon,n,m,dp);

        int need = min(down,right) - dungeon[i][j];

        return dp[i][j] = max(1,need);
    }

    int calculateMinimumHP(vector<vector<int>>& dungeon) {
        int n = dungeon.size();
        int m = dungeon[0].size();
        vector<vector<int>>dp(n+1,vector<int>(m+1,-1));

        return solve(0,0,dungeon,n,m,dp);
    }
};

//tabu
class Solution {
public:
    
    int calculateMinimumHP(vector<vector<int>>& dungeon) {
        int n = dungeon.size();
        int m = dungeon[0].size();
        vector<vector<int>>dp(n+1,vector<int>(m+1,INT_MAX));
        dp[n][m-1] = 1;
        dp[n-1][m] = 1;

        for(int i = n-1; i >= 0; i--)
        {
            for(int j = m - 1; j >= 0; j--)
            {
                int down = dp[i+1][j];
                int right = dp[i][j+1];

                int need = min(down,right) - dungeon[i][j];

                dp[i][j] = max(1,need);
            }
        }

        return dp[0][0];
    }
};
