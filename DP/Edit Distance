//rec
Time Complexity: O(3^(n+m))
- When characters don't match, the function makes three recursive calls: insert, delete, and replace.
- This results in exponential time complexity in the worst case.
Space Complexity: O(n + m)
- The maximum recursion depth is at most n + m.
- Since strings are passed by reference, no string copies are created in recursive calls.

class Solution {
public:
    int solve(int i,int j,string &word1, string &word2)
    {
        if(i == word1.size())
        {
            return word2.size() - j;
        }

        if(j == word2.size())
        {
            return word1.size() - i;
        }

        if(word1[i] == word2[j])
        {
            return solve(i+1,j+1,word1,word2);
        }

        int ins = 1 + solve(i,j+1,word1,word2);
        int del = 1 + solve(i+1,j,word1,word2);
        int rep = 1 + solve(i+1,j+1,word1,word2);

        return min(ins,min(del,rep));
    }
    int minDistance(string word1, string word2) {
        return solve(0,0,word1,word2);
    }
};

//memo
Time Complexity: O(n × m)
- There are n × m possible (i, j) states.
- Each state is computed at most once, with constant work apart from recursive calls.
Space Complexity: O(n × m)
- DP array: O(n × m).
- Recursion stack: O(n + m).

class Solution {
public:
    int solve(int i,int j,string &word1, string &word2,vector<vector<int>>&dp)
    {
        if(i == word1.size())
        {
            return word2.size() - j;
        }

        if(j == word2.size())
        {
            return word1.size() - i;
        }
        
        if(dp[i][j] != -1)
        {
            return dp[i][j];
        }
        if(word1[i] == word2[j])
        {
            return dp[i][j] = solve(i+1,j+1,word1,word2,dp);
        }

        int ins = 1 + solve(i,j+1,word1,word2,dp);
        int del = 1 + solve(i+1,j,word1,word2,dp);
        int rep = 1 + solve(i+1,j+1,word1,word2,dp);

        return dp[i][j] = min(ins,min(del,rep));
    }

    int minDistance(string word1, string word2) {
        int n = word1.size();
        int m = word2.size();

        vector<vector<int>>dp(n,vector<int>(m,-1));
        return solve(0,0,word1,word2,dp);
    }
};

//tabu
Time Complexity: O(n × m)
- Two nested loops process all (n + 1) × (m + 1) DP states.
- Each state takes O(1) time.
Space Complexity: O(n × m)
- The 2D DP table stores (n + 1) × (m + 1) values.
- No recursion stack is required.

class Solution {
public:
    int minDistance(string word1, string word2) {
        int n = word1.size();
        int m = word2.size();

        vector<vector<int>> dp(n + 1, vector<int>(m + 1, 0));
        for (int i = 0; i <= n; i++)
            dp[i][0] = i;

        for (int j = 0; j <= m; j++)
            dp[0][j] = j;
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= m; j++) {
                if (word1[i - 1] == word2[j - 1]) {
                    dp[i][j] = dp[i - 1][j - 1];
                } else {
                    int ins = 1 + dp[i][j - 1];
                    int del = 1 + dp[i - 1][j];
                    int rep = 1 + dp[i - 1][j - 1];

                    dp[i][j] = min(ins, min(del, rep));
                }
            }
        }
        return dp[n][m];
    }
};
