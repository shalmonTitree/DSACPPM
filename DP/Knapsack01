#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n" // optional, better to avoid redefining endl
const int MOD = 1000000007;


void solve()
{
    int n, tar;
    cin >> n >> tar;
    vector<int> v;
    vector<int> wt;
    for (int i = 0; i < n; i++)
    {
        int a, b;
        cin >> a >> b;
        v.push_back(a);
        wt.push_back(b);
    }
    vector<vector<int>> dp(n, vector<int>(tar + 1, 0));

    for (int j = v[0]; j <= tar; j++)
    {
        dp[0][j] = wt[0];
    }

    for (int idx = 1; idx < n; idx++)
    {
        for(int target = 1; target <= tar; target++)
        {
            int nottake = dp[idx-1][target];
            int take = 0;
            if (v[idx] <= target)
            {
                take = wt[idx] + dp[idx-1][target - v[idx]];
            }
            dp[idx][target] = max(take,nottake);

        }
    }
    cout <<dp[n-1][tar]<< endl;
}

int main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--)
    {
        solve();
    }

    return 0;
}
