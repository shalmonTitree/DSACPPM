    dp[0] = 0;
    dp[1] = max(0, arr[0]);

    for(int idx = 2; idx <= n; idx++)
    {
       int nottake = dp[idx - 1];
       int take = arr[idx - 1] + dp[idx - 2];
        
       dp[idx] = max(take,nottake);
      
    }
    return dp[n];
}


