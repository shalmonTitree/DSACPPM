//rec
class Solution {
public:
    int solve(int idx,vector<int>& cost)
    {
        if(idx == cost.size())
        {
            return 0;
        }

        int onestep = INT_MAX;
        if(idx + 1 <= cost.size())
        {
            onestep = solve(idx+1,cost);
        }
        
        int twostep = INT_MAX;
        if(idx + 2 <= cost.size())
        {
            twostep = solve(idx+2,cost);
        }

        return cost[idx] + min(onestep,twostep);
    }
    int minCostClimbingStairs(vector<int>& cost) {
        return min(solve(0,cost), solve(1,cost));
    }
};


//memo
class Solution {
public:
    int solve(int idx,vector<int>& cost,vector<int>&dp)
    {
        if(idx == cost.size())
        {
            return 0;
        }

        if(dp[idx] != -1)
        {
            return dp[idx];
        }

        int onestep = INT_MAX;
        if(idx + 1 <= cost.size())
        {
            onestep = solve(idx+1,cost,dp);
        }
        
        int twostep = INT_MAX;
        if(idx + 2 <= cost.size())
        {
            twostep = solve(idx+2,cost,dp);
        }

        return dp[idx] = cost[idx] + min(onestep,twostep);
    }
    int minCostClimbingStairs(vector<int>& cost) {
        int n = cost.size();
        vector<int>dp1(n+1,-1);
        vector<int>dp2(n+1,-1);
        return min(solve(0,cost,dp1), solve(1,cost,dp2));
    }
};

//tabu
class Solution {
public:
    
    int minCostClimbingStairs(vector<int>& cost) {
        int n = cost.size();

        vector<int> dp(n);

        dp[0] = cost[0];
        dp[1] = cost[1];

        for (int i = 2; i < n; i++) {
            dp[i] = cost[i] + min(dp[i - 1], dp[i - 2]);
        }

        return min(dp[n - 1], dp[n - 2]);
    }
};
