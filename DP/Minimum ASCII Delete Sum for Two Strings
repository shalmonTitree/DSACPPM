//rec
TC: O(2^(n+m))
SC: O(n + m)

class Solution {
public:
    int solve(int i, int j, string& s1, string& s2) {
        if (i == s1.size() || j == s2.size())
            return 0;

        if (s1[i] == s2[j]) {
            return (int)s1[i] + solve(i + 1, j + 1, s1, s2);
        }

        return max(
            solve(i + 1, j, s1, s2),
            solve(i, j + 1, s1, s2)
        );
    }

    int minimumDeleteSum(string s1, string s2) {
        int total = 0;

        for (char c : s1)
            total += c;

        for (char c : s2)
            total += c;

        int common = solve(0, 0, s1, s2);

        return total - 2 * common;
    }
};

//memo
TC: O(n × m)
SC: O(n × m) + O(n + m) recursion stack

class Solution {
public:
    int solve(int i, int j, string& s1, string& s2,
              vector<vector<int>>& dp) {

        if (i == s1.size() || j == s2.size())
            return 0;

        if (dp[i][j] != -1)
            return dp[i][j];

        if (s1[i] == s2[j]) {
            return dp[i][j] =
                (int)s1[i] + solve(i + 1, j + 1, s1, s2, dp);
        }

        return dp[i][j] = max(
            solve(i + 1, j, s1, s2, dp),
            solve(i, j + 1, s1, s2, dp)
        );
    }

    int minimumDeleteSum(string s1, string s2) {
        int n = s1.size();
        int m = s2.size();

        vector<vector<int>> dp(n, vector<int>(m, -1));

        int total = 0;

        for (char c : s1)
            total += c;

        for (char c : s2)
            total += c;

        int common = solve(0, 0, s1, s2, dp);

        return total - 2 * common;
    }
};


//tabu
TC: O(n × m)
SC: O(n × m)
class Solution {
public:
    int minimumDeleteSum(string s1, string s2) {
        int n = s1.size();
        int m = s2.size();

        vector<vector<int>> dp(n + 1, vector<int>(m + 1, 0));

        // s2 is finished
        // Delete remaining characters of s1
        for (int i = n - 1; i >= 0; i--) {
            dp[i][m] = s1[i] + dp[i + 1][m];
        }

        // s1 is finished
        // Delete remaining characters of s2
        for (int j = m - 1; j >= 0; j--) {
            dp[n][j] = s2[j] + dp[n][j + 1];
        }

        for (int i = n - 1; i >= 0; i--) {
            for (int j = m - 1; j >= 0; j--) {

                if (s1[i] == s2[j]) {
                    dp[i][j] = s1[i] + dp[i + 1][j + 1];
                }
                else {
                    dp[i][j] = max(
                        dp[i + 1][j],
                        dp[i][j + 1]
                    );
                }
            }
        }

        int total = 0;

        for (char c : s1)
            total += c;

        for (char c : s2)
            total += c;

        int common = dp[0][0];

        return total - 2 * common;
    }
};
