//Rec
class Solution {
public:
    int ans = INT_MAX;
    int solve(int idx,int col,vector<vector<int>>& matrix)
    {
        int n = matrix.size();
        int m = matrix[0].size();

        if(idx < 0 || idx >= n || col < 0 || col >= m)
        {
            return INT_MAX;
        }

        if(idx == n-1)
        {
            if(col >= 0 && col < m)
            {
                return matrix[idx][col];
            }
            
        }

        int left = solve(idx+1,col-1,matrix);
        int down = solve(idx+1,col,matrix);
        int right = solve(idx+1,col+1,matrix);

        int half = min(left,min(down,right));
        if(half == INT_MAX)
        {
            return INT_MAX;
        }
        return matrix[idx][col] + half;

    }
    int minFallingPathSum(vector<vector<int>>& matrix) {
        int n = matrix.size();
        int m = matrix[0].size();

        for(int j = 0; j < m; j++)
        {
            int mini = solve(0,j,matrix);
            ans = min(ans,mini);
        }

        return ans;
    }
};

//memo
✅ Time: O(n × m)
✅ Space: O(n × m)

class Solution {
public:
    int ans = INT_MAX;
    int solve(int idx,int col,vector<vector<int>>& matrix,vector<vector<int>>&dp)
    {
        int n = matrix.size();
        int m = matrix[0].size();

        if(idx < 0 || idx >= n || col < 0 || col >= m)
        {
            return INT_MAX;
        }

        if(idx == n-1)
        {
            if(col >= 0 && col < m)
            {
                return matrix[idx][col];
            }
            
        }

        if(dp[idx][col] != 1e9)
        {
            return dp[idx][col];
        }

        int left = solve(idx+1,col-1,matrix,dp);
        int down = solve(idx+1,col,matrix,dp);
        int right = solve(idx+1,col+1,matrix,dp);

        int half = min(left,min(down,right));
        if(half == INT_MAX)
        {
            return dp[idx][col] = INT_MAX;
        }
        return dp[idx][col] = matrix[idx][col] + half;

    }
    int minFallingPathSum(vector<vector<int>>& matrix) {
        int n = matrix.size();
        int m = matrix[0].size();

        vector<vector<int>>dp(n+1,vector<int>(m+1,1e9));

        for(int j = 0; j < m; j++)
        {
            int mini = solve(0,j,matrix,dp);
            ans = min(ans,mini);
        }

        return ans;
    }
};


//tabu
Time: O(n × m)
Space: O(n × m)
class Solution {
public:
    int ans = INT_MAX;
    
    int minFallingPathSum(vector<vector<int>>& matrix) {
        int n = matrix.size();
        int m = matrix[0].size();

        vector<vector<int>>dp(n,vector<int>(m,0));

        for(int j = 0; j < m; j++)
        {
            dp[n-1][j] = matrix[n-1][j];
        }

        for(int i = n - 2; i >= 0; i--)
        {
            for(int j = 0; j  < m; j++)
            {

                int left = INT_MAX;
                if(j > 0)
                {
                    left = dp[i+1][j-1];
                }

                int down = dp[i+1][j];

                int right = INT_MAX;
                if(j < m - 1)
                {
                    right = dp[i+1][j+1];
                }
                
                dp[i][j] = matrix[i][j] + min(left,min(down,right));
                
            }   
           
        }
        for(int j = 0; j < m; j++)
            {
                 ans = min(ans,dp[0][j]);
            }  

        return ans;
    }
};
