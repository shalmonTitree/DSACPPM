//bruteforce : tle
Time Complexity: O(2^(N+M))
- At each cell, the function makes up to two recursive calls: up and left.
- The recursion explores many overlapping paths, resulting in exponential time complexity.
Space Complexity: O(N + M)
- The maximum recursion depth is N + M - 1.
- No additional data structure is used.

class Solution {
public:
    int solve(int i,int j,vector<vector<int>>& grid)
    {
        int n = grid.size();
        int m = grid[0].size();
        
        if(i == 0 && j == 0)
        {
            return grid[0][0];
        }

        if(i < 0 || j < 0 || i >= n || j >= m)
        {
            return INT_MAX;
        }

        int up =  solve(i-1,j,grid);
        int left = solve(i,j-1,grid);

        return grid[i][j] + min(up,left);
    }
    int minPathSum(vector<vector<int>>& grid) {
        int n = grid.size();
        int m = grid[0].size();

        return solve(n-1,m-1,grid);
    }
};


//memo
Time Complexity: O(N × M)
- Each cell's minimum path sum is computed only once.
- Each computation takes O(1) work, excluding recursive calls.
Space Complexity: O(N × M)
- DP array: O(N × M).
- Recursion stack: O(N + M).


class Solution {
public:
    int solve(int i,int j,vector<vector<int>>& grid,vector<vector<int>>&dp)
    {
        int n = grid.size();
        int m = grid[0].size();
        
        if(i == 0 && j == 0)
        {
            return grid[0][0];
        }

        if(i < 0 || j < 0 || i >= n || j >= m)
        {
            return INT_MAX;
        }

        if(dp[i][j] != -1) return dp[i][j];

        int up =  solve(i-1,j,grid,dp);
        int left = solve(i,j-1,grid,dp);

        return dp[i][j] = grid[i][j] + min(up,left);
    }
    int minPathSum(vector<vector<int>>& grid) {
        int n = grid.size();
        int m = grid[0].size();
        vector<vector<int>>dp(n,vector<int>(m,-1));
        return solve(n-1,m-1,grid,dp);
    }
};

//tabu
Time Complexity: O(N × M)
- Two nested loops visit every grid cell once.
- Each cell is computed in O(1) time.
Space Complexity: O(N × M)
- The 2D DP array stores N × M values.
- No recursion stack is needed.

class Solution {
public:
    
    int minPathSum(vector<vector<int>>& grid) {
        int n = grid.size();
        int m = grid[0].size();
        vector<vector<int>>dp(n,vector<int>(m,0));

        dp[0][0] = grid[0][0];

        for(int i = 0; i < n; i++)
        {
            for(int j = 0; j < m; j++)
            {
                if(i == 0 && j == 0)
                {
                    continue;
                }
                else
                {
                    int up = INT_MAX;
                    int left = INT_MAX;

                    if(i > 0)
                    {
                        up = dp[i-1][j];
                    }

                    if(j > 0)
                    {
                        left = dp[i][j-1];
                    }

                    dp[i][j] = grid[i][j] + min(up,left);
                }
            }
        }
        return dp[n-1][m-1];
    }
};
