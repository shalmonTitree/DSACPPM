#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

int compute(int i,int j,vector<vector<int>>&v,vector<vector<int>>&dp)
{
    int n = v.size() - 1;
    int m = v[0].size() - 1;

    if(i == n && j == m)
    {
        return 0;
    }


    if(i > n || j > m)
    {
        return 1e9;
    }

    if(v[i][j] == 0)
    {
        return 1e9;
    }

    if(dp[i][j] != -1)
    {
        return dp[i][j];
    }

    int down = compute(i + v[i][j], j, v,dp);
    int right = compute(i, j + v[i][j], v,dp);

    return dp[i][j] = 1 + min(down,right);
}
void solve() {
