//tabu
#include <bits/stdc++.h>
using namespace std;

const int INF = 1e9;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    cin >> n >> m;

    vector<vector<int>> v(n + 1, vector<int>(m + 1));
    vector<vector<int>> dp(n + 1, vector<int>(m + 1, INF));

    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= m; j++) {
            cin >> v[i][j];
        }
    }

    dp[n][m] = 0;

    for (int i = n; i >= 1; i--) {
        for (int j = m; j >= 1; j--) {

            if (i == n && j == m)
                continue;

            if (v[i][j] == 0)
                continue;

            int jump = v[i][j];

            if (i + jump <= n)
                dp[i][j] = min(dp[i][j], 1 + dp[i + jump][j]);

            if (j + jump <= m)
                dp[i][j] = min(dp[i][j], 1 + dp[i][j + jump]);
        }
    }

    if (dp[1][1] >= INF)
        cout << -1 << '\n';
    else
        cout << dp[1][1] << '\n';

    return 0;
}
