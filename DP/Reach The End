    {
        for(int j = 1; j <=m; j++)
        {
            cin>>v[i][j];
        }
    }

    int ans = compute(1,1,v,dp);
    if(ans >= 1e9)
    {
        cout<<"-1"<<endl;
    }
    else
    {
        cout<<ans<<endl;
    }
}

int main() {
