#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

int fun(int idx,int tar,vector<int>&curr,vector<int>&future,vector<int>&diff)
{
    //basecase

    if(idx == curr.size())
    {
        return 0;
    }
    //workdone
    int nottake = fun(idx+1,tar,curr,future,diff);

    int take = 0;
    if(curr[idx] <= tar)
    {
        take = diff[idx] + fun(idx+1,tar - curr[idx],curr,future,diff);
    }

    //return
    return max(take,nottake);
}
void solve() {
    int n,tar;
    cin>>n>>tar;
    vector<int>curr(n);
    vector<int>future(n);
    vector<int>diff(n);

    for(int i = 0; i < n; i++) cin>>curr[i];
    for(int i = 0; i < n; i++) cin>>future[i];
    for(int i = 0; i < n; i++)
    {
        int val = future[i] - curr[i];
        diff[i] = val;
    }

    int ans = fun(0,tar,curr,future,diff);
    cout<<ans<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    //cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}

