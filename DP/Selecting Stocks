//tabu
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
    int n,tar;
    cin>>n>>tar;
    vector<int>curr(n);
    vector<int>future(n);
    vector<int>diff(n);
    vector<vector<int>>dp(n+1,vector<int>(tar+1,0));

    for(int i = 0; i < n; i++) cin>>curr[i];
    for(int i = 0; i < n; i++) cin>>future[i];
    for(int i = 0; i < n; i++)
    {
        int val = future[i] - curr[i];
        diff[i] = val;
    }


    for(int idx = 1; idx <= n; idx++)
    {
        for(int target = 1; target <= tar; target++)
        {
            int nottake = dp[idx-1][target];

            int take = 0;
            if(curr[idx-1] <= target)
            {
                take = diff[idx-1] + dp[idx-1][target - curr[idx-1]];
            }

            dp[idx][target] = max(take,nottake);
        }
    }
    cout<<dp[n][tar]<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    //cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
