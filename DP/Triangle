class Solution {
public:
    int solve(int r,int c,vector<vector<int>>& triangle)
    {
        int n = triangle.size();
  

        if(r == n - 1)
        {
            return triangle[r][c];
        }

        

        int down = solve(r+1,c,triangle);
        int downright = solve(r+1,c+1,triangle);

        return triangle[r][c] + min(down,downright);
    }
    int minimumTotal(vector<vector<int>>& triangle) {
       
        return solve(0,0,triangle);
    }
};


