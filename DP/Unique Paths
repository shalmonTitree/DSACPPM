//rec
Time Complexity: O(2^(m+n))
- At each cell, we make up to 2 recursive calls: up and left.
- The maximum recursion depth is m + n - 1.
Space Complexity: O(m + n)

- The recursion stack can reach a maximum depth of m + n - 1.

class Solution {
public:
    int solve(int i,int j,int m,int n)
    {
        if(i == 0 && j == 0)
        {
            return 1;
        }

        if(i < 0 || j < 0 || i >= m || j >= n)
        {
            return 0;
        }

        int up = solve(i-1,j,m,n);
        int left = solve(i,j-1,m,n);

        return up+left;
    }
    int uniquePaths(int m, int n) {
        return solve(m-1,n-1,m,n);
    }
};

//memo
Time Complexity: O(m × n)
- Each cell's result is calculated only once.
- Each calculation takes O(1) work apart from recursive calls.
Space Complexity: O(m × n)
- DP array: O(m × n).
- Recursion stack: O(m + n).

class Solution {
public:
    int solve(int i,int j,int m,int n,vector<vector<int>>&dp)
    {
        if(i == 0 && j == 0)
        {
            return 1;
        }

        if(i < 0 || j < 0 || i >= m || j >= n)
        {
            return 0;
        }
        if(dp[i][j] != -1)
        {
            return dp[i][j];
        }

        int up = solve(i-1,j,m,n,dp);
        int left = solve(i,j-1,m,n,dp);

        return dp[i][j] = up+left;
    }
    int uniquePaths(int m, int n) {
        //dp will be row,col info
        vector<vector<int>>dp(m+1,vector<int>(n+1,-1));
        return solve(m-1,n-1,m,n,dp);
    }
};

//tabu
Time Complexity: O(m × n)
- Two nested loops visit every cell once.
- Each cell is calculated in O(1) time.
Space Complexity: O(m × n)
- The 2D DP array stores m × n values (your code allocates slightly more using m+1 and n+1, which does not change the asymptotic complexity).
- No recursion stack is used.

class Solution {
public:
    
    int uniquePaths(int m, int n) {
        // dp will be row,col info
        vector<vector<int>> dp(m+1, vector<int>(n+1, 0));

        dp[0][0] = 1;
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {

                if(i == 0 && j == 0)
                {
                    continue;
                }

                int up = 0;
                int left = 0;

                if(i > 0)
                {
                    up = dp[i-1][j];
                }

                if(j > 0)
                {
                    left = dp[i][j-1];
                }

                dp[i][j] = left + up;
            }
        }
        return dp[m-1][n-1];
    }
};
