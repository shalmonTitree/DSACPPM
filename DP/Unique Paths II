//rec
class Solution {
public:
    int solve(int r,int c,vector<vector<int>>& obstacleGrid)
    {
        int n = obstacleGrid.size();
        int m = obstacleGrid[0].size();

        if(r == 0 && c == 0)
        {
            return 1;
        }
        if(r < 0 || c < 0 || r >= n || c >= m)
        {
            return 0;
        }

        if(obstacleGrid[r][c] == 1)
        {
            return 0;
        }

        

        int up = solve(r-1,c,obstacleGrid);
        int left = solve(r,c-1,obstacleGrid);

        return up+left;
    }
    int uniquePathsWithObstacles(vector<vector<int>>& obstacleGrid) {
        int n = obstacleGrid.size();
        int m = obstacleGrid[0].size();
        if(obstacleGrid[0][0] == 1)
        {
            return 0;
        }
        return solve(n-1,m-1,obstacleGrid);
    }
};

//memo
Memoization
O(n×m)
O(n×m) + O(n+m)

class Solution {
public:
    int solve(int r,int c,vector<vector<int>>& obstacleGrid,vector<vector<int>>&dp)
    {
        int n = obstacleGrid.size();
        int m = obstacleGrid[0].size();

        if(r == 0 && c == 0)
        {
            return 1;
        }
        if(r < 0 || c < 0 || r >= n || c >= m)
        {
            return 0;
        }
        

        if(obstacleGrid[r][c] == 1)
        {
            return 0;
        }

        if(dp[r][c] != -1)
        {
            return dp[r][c];
        }

        int up = solve(r-1,c,obstacleGrid,dp);
        int left = solve(r,c-1,obstacleGrid,dp);

        return dp[r][c] = up+left;
    }
    int uniquePathsWithObstacles(vector<vector<int>>& obstacleGrid) {
        int n = obstacleGrid.size();
        int m = obstacleGrid[0].size();

        vector<vector<int>>dp(n,vector<int>(m,-1));

        if(obstacleGrid[0][0] == 1)
        {
            return 0;
        }
        return solve(n-1,m-1,obstacleGrid,dp);
    }
};

//tabu
O(n × m)
O(n × m)

class Solution {
public:
    int uniquePathsWithObstacles(vector<vector<int>>& obstacleGrid) {
        int n = obstacleGrid.size();
        int m = obstacleGrid[0].size();

        vector<vector<int>> dp(n, vector<int>(m, 0));

        if (obstacleGrid[0][0] == 1) {
            return 0;
        }

        dp[0][0] = 1;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (i == 0 && j == 0) {
                    continue;
                }

                if (obstacleGrid[i][j] == 1) {
                    dp[i][j] = 0;
                } else {
                    int up = 0;
                    int left = 0;

                    if (i > 0) {
                        up = dp[i - 1][j];
                    }

                    if (j > 0) {
                        left = dp[i][j - 1];
                    }

                    dp[i][j] = up + left;
                }
            }
        }
        return dp[n - 1][m - 1];
    }
};
