#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl



int func(int day,int last,vector<vector<int>>&v)
{
   int n = v.size();
   if(day == n)
   {
        return 0;
   }

   int ans = 0;

   for(int task = 0; task < 3; task++)
   {
        if(task != last)
        {
            ans = max(ans, v[day][task] + func(day+1,task,v));
        }
   }

   return ans;
}
void solve() {
    int n;
    cin>>n;
    vector<vector<int>>v(n,vector<int>(3));
    for(int i = 0; i < n; i++)
    {
        for(int j = 0; j < 3; j++)
        {
            cin>>v[i][j];
        }
    }
    
    
    cout<<func(0,3,v);
    
    
}

