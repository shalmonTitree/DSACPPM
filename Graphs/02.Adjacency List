Space: O(V + E)
Add edge: O(1)
Traverse neighbors: O(degree of vertex)

#include <iostream>
#include <vector>
using namespace std;

int main() {
    int V = 4;

    vector<vector<int>> adj(V);

    // Undirected graph
    adj[0].push_back(1);
    adj[1].push_back(0);

    adj[0].push_back(2);
    adj[2].push_back(0);

    adj[1].push_back(3);
    adj[3].push_back(1);

    adj[2].push_back(3);
    adj[3].push_back(2);

    // Print adjacency list
    for (int i = 0; i < V; i++) {
        cout << i << " -> ";
        for (int node : adj[i])
            cout << node << " ";
        cout << endl;
    }
}
