Time Complexity: O(V + E), Space Complexity: O(V) (auxiliary) or O(V + E) (including the adjacency list).

#include <iostream>
#include <vector>
using namespace std;

void dfs(int node, vector<vector<int>> &adj, vector<bool> &visited) {
    visited[node] = true;
    cout << node << " ";

    for (int neighbor : adj[node]) {
        if (!visited[neighbor]) {
            dfs(neighbor, adj, visited);
        }
    }
}

int main() {
    int V, E;
    cin >> V >> E;

    vector<vector<int>> adj(V);
    vector<bool> visited(V, false);

    // Input edges (Undirected Graph)
    for (int i = 0; i < E; i++) {
        int u, v;
        cin >> u >> v;

        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    cout << "DFS Traversal: ";
    dfs(0, adj, visited);

    return 0;
}
