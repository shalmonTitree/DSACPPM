//dfs
class Solution {
public:
    void dfs(int node,vector<vector<int>>&graph,vector<int>&vis)
    {
        vis[node] = 1;
        for(auto it : graph[node])
        {
            if(!vis[it])
            {
                dfs(it,graph,vis);
            }
        }
    }
    int findCircleNum(vector<vector<int>>& isConnected) {
        int n = isConnected.size();
        vector<vector<int>>graph(n);
        vector<int>vis(n,0);
        int cnt = 0;
       for(int i = 0; i < n; i++)
       {
        for(int j = 0; j < n; j++)
        {
            if(isConnected[i][j] == 1 && i != j)
            {
                graph[i].push_back(j);
                graph[j].push_back(i);
            }
        }
       }


        for(int i = 0; i < n; i++)
        {
            if(!vis[i])
            {
                cnt++;
                dfs(i,graph,vis);
            }
        }

        return cnt;
    }
};


//bfs
class Solution {
public:
    void bfs(int node,vector<vector<int>>&graph,vector<int>&vis)
    {
        vis[node] = 1;
        queue<int>q;
        q.push(node);

        while(!q.empty())
        {
            int ngh = q.front();
            q.pop();
            
            for(auto it : graph[ngh])
            {
                if(!vis[it])
                {
                    vis[it] = 1;
                    q.push(it);
                }
            }
        }
    }
    int findCircleNum(vector<vector<int>>& isConnected) {
        int n = isConnected.size();
        vector<vector<int>>graph(n);
        vector<int>vis(n,0);
        int cnt = 0;
       for(int i = 0; i < n; i++)
       {
        for(int j = 0; j < n; j++)
        {
            if(isConnected[i][j] == 1 && i != j)
            {
                graph[i].push_back(j);
                graph[j].push_back(i);
            }
        }
       }


        for(int i = 0; i < n; i++)
        {
            if(!vis[i])
            {
                cnt++;
                bfs(i,graph,vis);
            }
        }

        return cnt;
    }
};
