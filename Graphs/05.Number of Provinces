class Solution {
public:

    void dfs(int node,
             vector<vector<int>>& adj,
             vector<bool>& vis) {

        vis[node] = true;

        for (auto it : adj[node]) {

            if (!vis[it]) {
                dfs(it, adj, vis);
            }
        }
    }

    int countConnected(int V, vector<vector<int>>& edges) {

        // Build adjacency list
        vector<vector<int>> adj(V);

        for (auto it : edges) {

            int u = it[0];
            int v = it[1];

            adj[u].push_back(v);
            adj[v].push_back(u);
        }

        vector<bool> vis(V, false);

        int count = 0;

        // Count connected components
        for (int i = 0; i < V; i++) {

            if (!vis[i]) {

                count++;

                dfs(i, adj, vis);
            }
        }

        return count;
    }
};

