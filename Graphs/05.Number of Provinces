//bfs

class Solution {
public:

    void bfs(int node,
             vector<vector<int>>& adj,
             vector<bool>& vis) {

        queue<int> q;
        q.push(node);
        vis[node] = true;

        while (!q.empty()) {

            int curr = q.front();
            q.pop();

            for (auto it : adj[curr]) {

                if (!vis[it]) {
                    vis[it] = true;
                    q.push(it);
                }
            }
        }
    }

    int countConnected(int V, vector<vector<int>>& edges) {

        // Build adjacency list
        vector<vector<int>> adj(V);

        for (auto it : edges) {

            int u = it[0];
            int v = it[1];

            adj[u].push_back(v);
            adj[v].push_back(u);
        }

        vector<bool> vis(V, false);

        int count = 0;

        // Count connected components
        for (int i = 0; i < V; i++) {

            if (!vis[i]) {

                count++;

                bfs(i, adj, vis);
            }
        }

        return count;
    }
};



