class Solution {
public:

    int bfs(queue<pair<int, int>>& q,
            vector<vector<int>>& grid,
            int fresh) {

        int n = grid.size();
        int m = grid[0].size();

        int time = 0;

        int dx[4] = {-1, 0, 1, 0};
        int dy[4] = {0, 1, 0, -1};

        while (!q.empty()) {

            int sz = q.size();
            bool rot = false;

            // One level = one minute
            while (sz--) {

                int r = q.front().first;
                int c = q.front().second;
                q.pop();

                for (int k = 0; k < 4; k++) {

                    int nrow = r + dx[k];
                    int ncol = c + dy[k];

                    if (nrow >= 0 && nrow < n &&
                        ncol >= 0 && ncol < m &&
                        grid[nrow][ncol] == 1) {

                        grid[nrow][ncol] = 2;
                        fresh--;

                        rot = true;

                        q.push({nrow, ncol});
                    }
                }
            }

            // At least one orange became rotten
            if (rot) {
                time++;
            }
        }

        // Fresh oranges are still remaining
        if (fresh > 0) {
            return -1;
        }

        return time;
    }

    int orangesRotting(vector<vector<int>>& grid) {

        int n = grid.size();
        int m = grid[0].size();

        queue<pair<int, int>> q;

        int fresh = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {

                if (grid[i][j] == 2) {
                    q.push({i, j});
                }

                if (grid[i][j] == 1) {
                    fresh++;
                }
            }
        }

        return bfs(q, grid, fresh);
    }
};
