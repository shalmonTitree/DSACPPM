Time Complexity

Let:

V = number of vertices
E = number of edges

For each bfs() call:

Copying adj → O(V + E)
Copying vis → O(V)
BFS traversal → O(V + E)

In the worst case, BFS may be called for many disconnected components.

Therefore, with your exact code, the worst-case time can be:

O(V × (V + E))

//space 
Because adj and vis are passed by value, each BFS call creates copies:

adj copy → O(V + E)
vis copy → O(V)
queue → O(V)

So auxiliary space during a BFS call is:

O(V + E)

The original adj also occupies O(V + E).
class Solution {
  public:
    bool bfs(int src,vector<vector<int>>adj,vector<int>vis,int V)
    {
        vis[src] = 1;
        queue<pair<int,int>>q; //node,parent
        q.push({src,-1});
        
        while(!q.empty())
        {
            int node = q.front().first;
            int parent = q.front().second;
            q.pop();
            
            for(auto it : adj[node])
            {
                if(!vis[it])
                {
                    vis[it] = 1;
                    q.push({it,node});
                }
                else if(parent != it)
                {
                    return true;
                }
            }
            
        }
        return false;
        
    }
    bool isCycle(int V, vector<vector<int>>& edges) {
    
        vector<int>vis(V,0);
        vector<vector<int>>adj(V);
        for(auto it : edges)
        {
            int u = it[0];
            int v = it[1];
            
            adj[u].push_back(v);
            adj[v].push_back(u);
        }
        
        for(int i = 0; i < V;i++)
        {
            if(!vis[i])
            {
                if(bfs(i,adj,vis,V))
                {
                    return true;
                }
                
            }
        }
        return false;
        
        
    }
};
