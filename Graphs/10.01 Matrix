Time Complexity: O(N × M)

Where:

N = number of rows
M = number of columns

Why?

Initial traversal to find all 0s → O(N × M)
BFS visits every cell at most once → O(N × M)
For every cell, we check 4 directions → 4 × N × M → O(N × M)

Therefore:

TC = O(N × M)

Space Complexity: O(N × M)

You use:

vis → O(N × M)
dist → O(N × M)
Queue → worst case O(N × M)

So:

SC = O(N × M)

ans is also created:


//bfs
class Solution {
public:
    vector<vector<int>> updateMatrix(vector<vector<int>>& mat) {
        int n = mat.size();
        int m = mat[0].size();
        vector<vector<int>>ans = mat;
        vector<vector<int>>vis(n,vector<int>(m,0));
        vector<vector<int>>dist(n,vector<int>(m,0));

        queue<pair<pair<int,int>,int>>q;

        for(int i = 0; i < n; i++)
        {
            for(int j = 0; j < m; j++)
            {
                if(mat[i][j] == 0)
                {
                    q.push({{i,j},0});
                    vis[i][j] = 1;
                }
            }
        }

        int dx[4] = {-1,0,1,0};
        int dy[4] = {0,1,0,-1};

        while(!q.empty())
        {
            int row = q.front().first.first;
            int col = q.front().first.second;
            int steps = q.front().second;
            q.pop();

            dist[row][col] = steps;

            for(int k = 0; k < 4; k++)
            {
                int nrow = dx[k] + row;
                int ncol = dy[k] + col;

                if(nrow >= 0 && nrow < n && ncol >= 0 && ncol < m && vis[nrow][ncol] == 0)
                {
                    vis[nrow][ncol] = 1;
                    q.push({{nrow,ncol}, steps+1});
                }
            }
        }
        return dist;
    }
};

