For this Word Ladder BFS solution, let:

N = number of words in wordList
L = length of each word
Alphabet size = 26
Time Complexity

For every word that we process:

We change each of its L characters.
For each position, we try 26 characters.
Each unordered_set lookup is O(1) average.

So:

TC = O(N × L × 26)

Since 26 is constant:

TC = O(N × L)

Space Complexity

You use:

unordered_set containing up to N words → O(N × L) because each word has length L
Queue can contain up to N words → O(N × L)

Therefore:

SC = O(N × L)

class Solution {
public:
    int ladderLength(string beginWord, string endWord, vector<string>& wordList) {
        unordered_set<string>st(wordList.begin(),wordList.end());
        queue<pair<string,int>>q;
        q.push({beginWord,1});

        st.erase(beginWord);

        while(!q.empty())
        {
            string word = q.front().first;
            int steps = q.front().second;
            q.pop();

            if(word == endWord)
            {
                return steps;
            }
            for(int i = 0; i < word.size(); i++)
            {
                char org = word[i];
                for(char ch = 'a'; ch <= 'z'; ch++)
                {
                    word[i] = ch;
                    if(st.find(word) != st.end())
                    {
                        st.erase(word);
                        q.push({word,steps+1});
                    }

                }
                word[i] = org;
            }
        }
        return 0;
    }
};
