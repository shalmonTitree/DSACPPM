class Solution {
  public:
    void toposortDFS(int node, vector<vector<pair<int,int>>>& adj,
                     vector<int>& vis, stack<int>& st)
    {
        vis[node] = 1;

        for(auto it : adj[node])
        {
            if(!vis[it.first])
            {
                toposortDFS(it.first, adj, vis, st);
            }
        }

        st.push(node);
    }

    vector<int> shortestPath(int V, vector<vector<int>>& edges) {
        
        vector<vector<pair<int,int>>> adj(V);
        vector<int> vis(V, 0);
        stack<int> st;
        vector<int> dist(V, 1e9);

        // Build adjacency list
        for(auto it : edges)
        {
            int u = it[0];
            int v = it[1];
            int wt = it[2];

            adj[u].push_back({v, wt});
        }

        // Topological sort
        for(int i = 0; i < V; i++)
        {
            if(!vis[i])
            {
                toposortDFS(i, adj, vis, st);
            }
        }

        // Source = 0
        dist[0] = 0;

        // Relax edges in topological order
        while(!st.empty())
        {
            int node = st.top();
            st.pop();

            for(auto it : adj[node])
            {
                int v = it.first;
                int wt = it.second;

                if(dist[node] != 1e9 &&
                   dist[node] + wt < dist[v])
                {
                    dist[v] = dist[node] + wt;
                }
            }
        }

        // Unreachable nodes -> -1
        for(int i = 0; i < V; i++)
        {
            if(dist[i] == 1e9)
            {
                dist[i] = -1;
            }
        }

        return dist;
    }
};
