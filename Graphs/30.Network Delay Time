class Solution {
public:
    int networkDelayTime(vector<vector<int>>& times, int n, int k) {
         vector<pair<int, int>> adj[n+1];
        for(auto it : times)
        {
            int from = it[0];
            int to = it[1];
            int d = it[2];

            adj[from].push_back({to,d});
        }

        priority_queue<
    pair<int, int>,
    vector<pair<int, int>>,
    greater<pair<int, int>>
> pq;

        vector<int>dist(n+1,1e9);

        dist[k] = 0;
        pq.push({0,k});

        while(!pq.empty())
        {
            auto [d,node] = pq.top();
            pq.pop();

            for(auto it : adj[node])
            {
                int ngh = it.first;
                int wt = it.second;

                if(d + wt < dist[ngh])
                {
                    dist[ngh] = d + wt;
                    pq.push({dist[ngh],ngh});
                }
            }
        }
         int ans = 0;

        for (int i = 1; i <= n; i++) {

            if (dist[i] == 1e9)
                return -1;

            ans = max(ans, dist[i]);
        }

        return ans;
        

    }
};
