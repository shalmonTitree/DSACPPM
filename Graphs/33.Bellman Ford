
Time Complexity: O(V × E)

Space Complexity: O(V)

V = number of vertices
E = number of edges

Reason:

Outer loop runs V - 1 times.
Inner loop checks all E edges.
So TC = O(V × E).
dist array uses O(V) space.

class Solution {
  public:
    vector<int> bellmanFord(int V, vector<vector<int>>& edges, int src) {
       
        vector<int>dist(V,1e8);
        dist[src] = 0;
        
        for(int i = 0; i < V - 1; i++)
        {
            for(auto it : edges)
            {
                int u = it[0];
                int v = it[1];
                int wt = it[2];
                
                if(dist[u] != 1e8 && dist[u] + wt < dist[v])
                {
                    dist[v] = dist[u] + wt;
                }
            }
        }
        
        //this iteration check for negative cycle
        for(auto it : edges)
            {
                int u = it[0];
                int v = it[1];
                int wt = it[2];
                
                if(dist[u] != 1e8 && dist[u] + wt < dist[v])
                {
                    return {-1};
                }
            }
        return dist;
    }
};
