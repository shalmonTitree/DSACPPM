class DisjointSet {
    vector<int> parent, size;

public:
    DisjointSet(int n) {
        parent.resize(n);
        size.resize(n, 1);

        for (int i = 0; i < n; i++)
            parent[i] = i;
    }

    int findUPar(int node) {
        if (node == parent[node])
            return node;

        return parent[node] = findUPar(parent[node]);
    }

    void unionBySize(int u, int v) {
        int ulp_u = findUPar(u);
        int ulp_v = findUPar(v);

        if (ulp_u == ulp_v)
            return;

        if (size[ulp_u] < size[ulp_v]) {
            parent[ulp_u] = ulp_v;
            size[ulp_v] += size[ulp_u];
        }
        else {
            parent[ulp_v] = ulp_u;
            size[ulp_u] += size[ulp_v];
        }
    }

    int getSize(int node) {
        return size[findUPar(node)];
    }
};

class Solution {
public:
    int largestIsland(vector<vector<int>>& grid) {

        int n = grid.size();

        DisjointSet ds(n * n);

        int dx[] = {-1, 0, 1, 0};
        int dy[] = {0, 1, 0, -1};

        // Step 1: Connect all existing land cells
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {

                if (grid[i][j] == 0)
                    continue;

                int node = i * n + j;

                for (int k = 0; k < 4; k++) {

                    int ni = i + dx[k];
                    int nj = j + dy[k];

                    if (ni >= 0 && ni < n &&
                        nj >= 0 && nj < n &&
                        grid[ni][nj] == 1) {

                        int adjNode = ni * n + nj;

                        ds.unionBySize(node, adjNode);
                    }
                }
            }
        }

        int ans = 0;

        // Step 2: Check every 0
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {

                if (grid[i][j] == 1)
                    continue;

                set<int> components;

                for (int k = 0; k < 4; k++) {

                    int ni = i + dx[k];
                    int nj = j + dy[k];

                    if (ni >= 0 && ni < n &&
                        nj >= 0 && nj < n &&
                        grid[ni][nj] == 1) {

                        int adjNode = ni * n + nj;

                        components.insert(ds.findUPar(adjNode));
                    }
                }

                int currentSize = 1;

                for (auto parent : components) {
                    currentSize += ds.getSize(parent);
                }

                ans = max(ans, currentSize);
            }
        }

        // Handles all-1 grid
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {

                if (grid[i][j] == 1) {
                    ans = max(ans, ds.getSize(i * n + j));
                }
            }
        }

        return ans;
    }
};
