Time Limit: 1 sec
Memory Limit: 256 MB

Description

You are given an undirected graph with N nodes and M edges. Considering each node has unit weight. You need to calculate the Connected Sum for this graph.

Connected Sum is calculated in the following way -
For each component in the graph, first get the sum of the weights of the nodes. Then calculate its square root and perform ceil operation on this value. Finally, the sum of this value over all components is called Connected Sum of that graph.

Input Format

The first line contains an integer T - denoting the number of test cases.
The first line of each test case contains 2 space seperated integers - N and M.
The next M lines contain two space seperated integers denoting the nodes associated with the ith edge.

Output Format

For each test case, print the Connected Sum on a new line.

Constraints

1≤T≤100
1≤N≤105
1≤M≤105
Its guaranteed that the sum of N and M across all the test cases does not exceed 106.

Sample Input 1

1 10 5 1 2 1 3 2 4 3 5 7 8

Sample Output 1

8

Note

In Sample Input 1,

The different components are {1,2,3,4,5}, {7,8}, {6}, {9} and {10}. So, the Connected Sum will be 3+2+1*3=8.

Sample Input 2

1 4 2 1 2 1 4

Sample Output 2

3

In Sample Input 2,

The different components are {1,2,4} and {3}. So, the Connected Sum will be 2+1=3.


#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl


int dfs(int node,vector<vector<int>>&adj,vector<bool>&vis,int &count)
{
    vis[node] = true;
    count++;

    for(auto it : adj[node])
    {
        if(!vis[it])
        {
            dfs(it,adj,vis,count);
        }
    }
    return count;
}
void solve() {
    int n,m;
    cin>>n>>m;
    vector<pair<int,int>>edges;
    vector<vector<int>>adj(n+1);
    vector<bool>vis(n+1,false);
    int ans = 0;
   

    for(int i = 0; i < m; i++)
    {
        int u,v;
        cin>>u>>v;
        edges.push_back({u,v});
    }

    
    for(auto it : edges)
    {
        int u = it.first;
        int v = it.second;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }


    for(int i = 1; i <= n; i++)
    {
        int count = 0;
        if(!vis[i])
        {
            int sum = dfs(i,adj,vis,count);
            ans += ceil(sqrt(sum));
        }
    }

    cout<<ans<<endl;
    
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
