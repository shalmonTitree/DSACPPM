class Solution {
public:
    int dfs(vector<vector<int>>& grid, int r, int c) {
        int m = grid.size();
        int n = grid[0].size();

        // Outside the grid -> perimeter
        if (r < 0 || r >= m || c < 0 || c >= n) {
            return 1;
        }

        // Water -> perimeter
        if (grid[r][c] == 0) {
            return 1;
        }

        // Already visited land
        if (grid[r][c] == -1) {
            return 0;
        }

        // Mark as visited
        grid[r][c] = -1;

        int perimeter = 0;

        perimeter += dfs(grid, r - 1, c); // up
        perimeter += dfs(grid, r + 1, c); // down
        perimeter += dfs(grid, r, c - 1); // left
        perimeter += dfs(grid, r, c + 1); // right

        return perimeter;
    }

    int islandPerimeter(vector<vector<int>>& grid) {
        int m = grid.size();
        int n = grid[0].size();

        // Find the first land cell
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (grid[i][j] == 1) {
                    return dfs(grid, i, j);
                }
            }
        }

        return 0;
    }
};


