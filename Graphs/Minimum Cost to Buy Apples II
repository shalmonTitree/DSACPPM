//brute using floyd warshall
Complexity analysis
- Time: (O(n^3)) — two Floyd–Warshall computations.
- Space: (O(n^2)) — two distance matrices.
class Solution {
public:
    using ll = long long;
    const ll INF = 4e18;

    vector<ll> minCost(
        int n,
        vector<int>& prices,
        vector<vector<int>>& roads
    ) {
        vector<vector<ll>> empty(n, vector<ll>(n, INF));
        vector<vector<ll>> loaded(n, vector<ll>(n, INF));

        for (int i = 0; i < n; i++) {
            empty[i][i] = 0;
            loaded[i][i] = 0;
        }

        for (auto& r : roads) {
            int u = r[0], v = r[1];
            ll cost = r[2], tax = r[3];

            empty[u][v] = empty[v][u] = cost;
            loaded[u][v] = loaded[v][u] = cost * tax;
        }

        // Floyd-Warshall
        for (int k = 0; k < n; k++) {
            for (int i = 0; i < n; i++) {
                for (int j = 0; j < n; j++) {
                    if (empty[i][k] != INF &&
                        empty[k][j] != INF) {
                        empty[i][j] = min(
                            empty[i][j],
                            empty[i][k] + empty[k][j]
                        );
                    }

                    if (loaded[i][k] != INF &&
                        loaded[k][j] != INF) {
                        loaded[i][j] = min(
                            loaded[i][j],
                            loaded[i][k] + loaded[k][j]
                        );
                    }
                }
            }
        }

        vector<ll> ans(n);

        for (int i = 0; i < n; i++) {
            ans[i] = prices[i];

            for (int j = 0; j < n; j++) {
                if (empty[i][j] == INF ||
                    loaded[j][i] == INF)
                    continue;

                ll total = empty[i][j]
                         + prices[j]
                         + loaded[j][i];

                ans[i] = min(ans[i], total);
            }
        }

        return ans;
    }
};


//optimal using diktras 
Complexity analysis

For one Dijkstra run using an adjacency list and priority queue:
\[
O((V+E)\log V)
\]

We run it twice for every vertex.
- Time: \(O(V(V+E)\log V)\)
- Space: \(O(V+E)\) auxiliary space.

class Solution {
public:
    using ll = long long;
    const ll INF = 4e18;

    vector<ll> dijkstra(
        int src,
        vector<vector<pair<int, ll>>>& adj,
        int n
    ) {
        vector<ll> dist(n, INF);

        priority_queue<
            pair<ll, int>,
            vector<pair<ll, int>>,
            greater<pair<ll, int>>
        > pq;

        dist[src] = 0;
        pq.push({0, src});

        while (!pq.empty()) {
            auto [d, u] = pq.top();
            pq.pop();

            if (d != dist[u]) continue;

            for (auto [v, w] : adj[u]) {
                if (d + w < dist[v]) {
                    dist[v] = d + w;
                    pq.push({dist[v], v});
                }
            }
        }

        return dist;
    }

    vector<ll> minCost(
        int n,
        vector<int>& prices,
        vector<vector<int>>& roads
    ) {
        vector<vector<pair<int, ll>>> emptyGraph(n);
        vector<vector<pair<int, ll>>> loadedGraph(n);

        for (auto& r : roads) {
            int u = r[0], v = r[1];
            ll cost = r[2], tax = r[3];

            emptyGraph[u].push_back({v, cost});
            emptyGraph[v].push_back({u, cost});

            loadedGraph[u].push_back({v, cost * tax});
            loadedGraph[v].push_back({u, cost * tax});
        }

        vector<ll> ans(n);

        for (int i = 0; i < n; i++) {
            vector<ll> d1 = dijkstra(i, emptyGraph, n);
            vector<ll> d2 = dijkstra(i, loadedGraph, n);

            ans[i] = prices[i];

            for (int j = 0; j < n; j++) {
                if (d1[j] == INF || d2[j] == INF)
                    continue;

                ll total = d1[j] + prices[j] + d2[j];

                ans[i] = min(ans[i], total);
            }
        }

        return ans;
    }
};
