class Solution {
public:

    vector<int> findMinHeightTrees(int n, vector<vector<int>>& edges) {

        // Special case
        if (n == 1) {
            return {0};
        }

        // Build adjacency list
        vector<vector<int>> adj(n);

        for (auto it : edges) {

            int u = it[0];
            int v = it[1];

            adj[u].push_back(v);
            adj[v].push_back(u);
        }

        // Store degree of every node
        vector<int> degree(n);

        for (int i = 0; i < n; i++) {
            degree[i] = adj[i].size();
        }

        // Put all leaves into queue
        queue<int> q;

        for (int i = 0; i < n; i++) {

            if (degree[i] == 1) {
                q.push(i);
            }
        }

        int remaining = n;

        while (remaining > 2) {

            int sz = q.size();

            // Remove current layer of leaves
            remaining -= sz;

            while (sz--) {

                int node = q.front();
                q.pop();

                for (auto neighbor : adj[node]) {

                    degree[neighbor]--;

                    if (degree[neighbor] == 1) {
                        q.push(neighbor);
                    }
                }
            }
        }

        // Remaining 1 or 2 nodes are MHT roots
        vector<int> ans;

        while (!q.empty()) {
            ans.push_back(q.front());
            q.pop();
        }

        return ans;
    }
};
