class Solution {
public:

    int bfs(vector<vector<char>>& maze,
            vector<int>& entrance) {

        int n = maze.size();
        int m = maze[0].size();

        queue<pair<int, int>> q;

        int r = entrance[0];
        int c = entrance[1];

        q.push({r, c});

        // Mark entrance as visited
        maze[r][c] = '+';

        int dx[4] = {-1, 0, 1, 0};
        int dy[4] = {0, 1, 0, -1};

        int steps = 0;

        while (!q.empty()) {

            int sz = q.size();

            while (sz--) {

                int row = q.front().first;
                int col = q.front().second;
                q.pop();

                for (int k = 0; k < 4; k++) {

                    int nrow = row + dx[k];
                    int ncol = col + dy[k];

                    // Valid and empty cell
                    if (nrow >= 0 && nrow < n &&
                        ncol >= 0 && ncol < m &&
                        maze[nrow][ncol] == '.') {

                        // Check if this is an exit
                        if (nrow == 0 || nrow == n - 1 ||
                            ncol == 0 || ncol == m - 1) {

                            return steps + 1;
                        }

                        // Mark visited
                        maze[nrow][ncol] = '+';

                        q.push({nrow, ncol});
                    }
                }
            }

            steps++;
        }

        return -1;
    }

    int nearestExit(vector<vector<char>>& maze,
                    vector<int>& entrance) {

        return bfs(maze, entrance);
    }
};
