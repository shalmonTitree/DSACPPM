"Both DFS and BFS have O(m × n) time complexity because every cell is visited at most once. However, recursive DFS can cause stack overflow for large grids due to deep recursion. I would prefer BFS for this problem because it uses an iterative queue and avoids recursion depth limitations. Although both have O(m × n) worst-case auxiliary space, BFS provides more predictable execution without relying on the call stack."

/*
===============================================================================
Approach 1: Brute Force (DFS with Visited Array)
===============================================================================

Idea:
- Traverse every cell.
- Whenever an unvisited land ('1') is found,
  perform DFS to mark the entire island as visited.
- Count the number of DFS calls.

Time Complexity : O(n * m)
Space Complexity: O(n * m)

n = Rows
m = Columns
*/

class Solution {
public:
    void dfs(int r,int c,vector<vector<char>>& grid,vector<vector<bool>>&vis)
    {
        int n = grid.size();
        int m = grid[0].size();
        vis[r][c] = true;
        int dx[4] = {-1,0,1,0};
        int dy[4] = {0,1,0,-1};

        for(int k = 0; k < 4; k++)
        {
            int nrow = dx[k] + r;
            int ncol = dy[k] + c;

            if(nrow >= 0 && nrow < n && ncol >= 0 && ncol < m && !vis[nrow][ncol] && grid[nrow][ncol] == '1')
            {
                dfs(nrow,ncol,grid,vis);
            }
        }
    }
    int numIslands(vector<vector<char>>& grid) {
        int n = grid.size();
        int m = grid[0].size();

        int cnt = 0;
        vector<vector<bool>>vis(n,vector<bool>(m,false));

        for(int i = 0; i < n; i++)
        {
            for(int j = 0; j < m; j++)
            {
                if(!vis[i][j] && grid[i][j] == '1')
                {
                    cnt++;
                    dfs(i,j,grid,vis);
                }
            }
        }
        return cnt;
    }
};

/*
===============================================================================
Approach 2: Better
===============================================================================

Idea:
- Use BFS instead of DFS.
- Start BFS from every unvisited land cell.
- Mark all connected land cells as visited.

Time Complexity : O(n * m)
Space Complexity: O(n * m)
*/

class Solution {
public:
    void bfs(int r,int c,vector<vector<char>>& grid,vector<vector<bool>>&vis)
    {
        int n = grid.size();
        int m = grid[0].size();

        
        vis[r][c] = true;
        queue<pair<int,int>>q;
        q.push({r,c});

        while(!q.empty())
        {
            int i = q.front().first;
            int j = q.front().second;

            q.pop();

            int dx[4] = {-1,0,1,0};
            int dy[4] = {0,1,0,-1};

            for(int k = 0; k < 4; k++)
            {
                int nrow = dx[k] + i;
                int ncol = dy[k] + j;

                if(nrow >= 0 && nrow < n && ncol >= 0 && ncol < m && !vis[nrow][ncol] && grid[nrow][ncol] == '1')
                {
                    vis[nrow][ncol] = true;
                    q.push({nrow,ncol});
                }
            }

        }
        
    }
    int numIslands(vector<vector<char>>& grid) {
        int n = grid.size();
        int m = grid[0].size();

        int cnt = 0;
        vector<vector<bool>>vis(n,vector<bool>(m,false));

        for(int i = 0; i < n; i++)
        {
            for(int j = 0; j < m; j++)
            {
                if(!vis[i][j] && grid[i][j] == '1')
                {
                    cnt++;
                    bfs(i,j,grid,vis);
                }
            }
        }
        return cnt;
    }
};
