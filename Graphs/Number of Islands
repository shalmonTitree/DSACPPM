/*
===============================================================================
Approach 1: Brute Force (DFS with Visited Array)
===============================================================================

Idea:
- Traverse every cell.
- Whenever an unvisited land ('1') is found,
  perform DFS to mark the entire island as visited.
- Count the number of DFS calls.

Time Complexity : O(n * m)
Space Complexity: O(n * m)

n = Rows
m = Columns
*/

class Solution1 {
public:
    int n, m;

    void dfs(int i, int j, vector<vector<char>>& grid, vector<vector<bool>>& vis) {

        if (i < 0 || i >= n || j < 0 || j >= m || vis[i][j] || grid[i][j] == '0')
            return;

        vis[i][j] = true;

        dfs(i + 1, j, grid, vis);
        dfs(i - 1, j, grid, vis);
        dfs(i, j + 1, grid, vis);
        dfs(i, j - 1, grid, vis);
    }

    int numIslands(vector<vector<char>>& grid) {

        n = grid.size();
        m = grid[0].size();

        vector<vector<bool>> vis(n, vector<bool>(m, false));

        int cnt = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {

                if (!vis[i][j] && grid[i][j] == '1') {
                    cnt++;
                    dfs(i, j, grid, vis);
                }
            }
        }

        return cnt;
    }
};



/*
===============================================================================
Approach 2: Better
===============================================================================

Idea:
- Use BFS instead of DFS.
- Start BFS from every unvisited land cell.
- Mark all connected land cells as visited.

Time Complexity : O(n * m)
Space Complexity: O(n * m)
*/

class Solution2 {
public:
    int n, m;

    void bfs(int i, int j, vector<vector<char>>& grid,vector<vector<bool>>& vis) {

        queue<pair<int, int>> q;
        q.push({i, j});
        vis[i][j] = true;

        int dr[] = {-1, 1, 0, 0};
        int dc[] = {0, 0, -1, 1};

        while (!q.empty()) {

            auto [r, c] = q.front();
            q.pop();

            for (int k = 0; k < 4; k++) {

                int nr = r + dr[k];
                int nc = c + dc[k];

                if (nr >= 0 && nr < n && nc >= 0 && nc < m && !vis[nr][nc] && grid[nr][nc] == '1') {
                    vis[nr][nc] = true;
                    q.push({nr, nc});
                }
            }
        }
    }

    int numIslands(vector<vector<char>>& grid) {

        n = grid.size();
        m = grid[0].size();

        vector<vector<bool>> vis(n, vector<bool>(m, false));

        int cnt = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {

                if (!vis[i][j] && grid[i][j] == '1') {
                    cnt++;
                    bfs(i, j, grid, vis);
                }
            }
        }

        return cnt;
    }
};
