/*
===============================================================================
Approach 1: Brute Force
===============================================================================

Idea:
- Start DFS/BFS from every cell.
- Check whether water can reach both oceans.
- Count cells that satisfy both conditions.

Time Complexity : O((n * m)²)
Space Complexity: O(n * m)

n = Rows
m = Columns
*/



/*
===============================================================================
Approach 2: Better
===============================================================================

No meaningful better approach exists.
*/



/*
===============================================================================
Approach 3: Optimal (Reverse DFS from Oceans) ⭐ Most Expected
===============================================================================

Idea:
- Instead of checking every cell, start DFS from the oceans.
- Pacific DFS:
    - Top row + Left column.
- Atlantic DFS:
    - Bottom row + Right column.
- During DFS, move only to cells having
  height >= current height.
- Cells visited by both DFS traversals
  can flow to both oceans.

Time Complexity : O(n * m)
Space Complexity: O(n * m)
*/

class Solution {
public:
    int n, m;

    void dfs(int r, int c,
             vector<vector<int>>& heights,
             vector<vector<bool>>& vis) {

        vis[r][c] = true;

        int dr[] = {-1, 1, 0, 0};
        int dc[] = {0, 0, -1, 1};

        for (int k = 0; k < 4; k++) {

            int nr = r + dr[k];
            int nc = c + dc[k];

            if (nr >= 0 && nr < n &&
                nc >= 0 && nc < m &&
                !vis[nr][nc] &&
                heights[nr][nc] >= heights[r][c]) {

                dfs(nr, nc, heights, vis);
            }
        }
    }

    vector<vector<int>> pacificAtlantic(vector<vector<int>>& heights) {

        n = heights.size();
        m = heights[0].size();

        vector<vector<bool>> pacific(n, vector<bool>(m, false));
        vector<vector<bool>> atlantic(n, vector<bool>(m, false));

        // Pacific (Top Row)
        for (int j = 0; j < m; j++) {
            if (!pacific[0][j])
                dfs(0, j, heights, pacific);
        }

        // Pacific (Left Column)
        for (int i = 0; i < n; i++) {
            if (!pacific[i][0])
                dfs(i, 0, heights, pacific);
        }

        // Atlantic (Bottom Row)
        for (int j = 0; j < m; j++) {
            if (!atlantic[n - 1][j])
                dfs(n - 1, j, heights, atlantic);
        }

        // Atlantic (Right Column)
        for (int i = 0; i < n; i++) {
            if (!atlantic[i][m - 1])
                dfs(i, m - 1, heights, atlantic);
        }

        vector<vector<int>> ans;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {

                if (pacific[i][j] && atlantic[i][j])
                    ans.push_back({i, j});
            }
        }

        return ans;
    }
};
