Time Limit: 3 sec
Memory: 256 MB

Description

There are n cities and m roads between them. Your task is to process q queries where you have to determine the length of the shortest route between two given cities. Each road connects two cities and is two-way. Multiple roads between the same pair of cities may exist; consider the shortest among them.

Input Format

The first input line has three integers n, m and q: the number of cities, roads, and queries. Then, there are m lines describing the roads. Each line has three integers a, b and c: there is a road between cities a and b whose length is c. All roads are two-way roads. Finally, there are q lines describing the queries. Each line has two integers a and b: determine the length of the shortest route between cities a and b.

Output Format

Print the length of the shortest route for each query. If there is no route, print −1 instead.

Constraints

1≤n≤500
1≤m≤n2
1≤q≤105
1≤a,b≤n
1≤c≤109

Sample Input 1

4 3 5
1 2 5
1 3 9
2 3 3
1 2
2 1
1 3
1 4
3 2

Sample Output 1

5
5
8
-1
3

Sample Input 2

2 2 1
1 2 1
1 2 2
1 2

Sample Output 2

1

Note

For Sample Input 1, the shortest distances are: between 1 and 2 is 5, between 2 and 1 is 5, between 1 and 3 the shortest path is 1→2→3 with length 5+3=8, between 1 and 4 there is no route so answer is −1, and between 3 and 2 is 3.

For Sample Input 2, there are two roads between 1 and 2 with lengths 1 and 2; the shortest is 1.


#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl
const ll INF = 1e18;

void solve() {
    ll n,m,q;
    cin>>n>>m>>q;
    
    vector<vector<ll>>dist(n+1,vector<ll>(n+1,INF));
    for(int i = 1; i <= m; i++)
    {
        ll a,b,c;
        cin>>a>>b>>c;
        dist[a][b] = min(dist[a][b],c);
        dist[b][a] = min(dist[b][a],c);
    }
    for(int i = 0; i <= n; i++)
    {
        for(int j = 0; j <= n; j++)
        {
            if(i == j)
            {
                dist[i][j] = 0;
            }
        }
    }

    for(ll k = 1; k <= n; k++)
    {
        for(ll i = 1; i <= n; i++)
        {
            for(ll j = 1; j <= n; j++)
            {
                dist[i][j] = min(dist[i][j], dist[i][k] + dist[k][j]);
            }
        }
    }

    while(q--)
    {
        ll a,b;
        cin>>a>>b;
        if(dist[a][b] == INF)
        {
            cout<<"-1"<<endl;
        }
        else
        {
            cout<<dist[a][b]<<endl;
        }
    }



}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    // cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
