//bruteforece
class Solution {
public:
    int maxScoreSightseeingPair(vector<int>& values) {
        int n = values.size();
        int ans = 0;

        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                int score = values[i] + values[j] + i - j;
                ans = max(ans, score);
            }
        }

        return ans;
    }
};

//optimal
class Solution {
public:
    int maxScoreSightseeingPair(vector<int>& values) {
        int n = values.size();
        int maxi = values[0];
        int ans = 0;
        for(int j = 1; j < n; j++)
        {
            ans = max(ans,maxi + values[j] - j);

            maxi = max(maxi, values[j] + j);
        }

        return ans;
    }
};
