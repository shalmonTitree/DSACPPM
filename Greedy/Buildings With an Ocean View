class Solution {
public:
    vector<int> findBuildings(vector<int>& heights) {
        int n = heights.size();
        vector<int>ans;
        ans.push_back(n-1);
        int currmax = heights[n-1];

        for(int i = n - 2; i >= 0; i--)
        {
            if(heights[i] > currmax)
            {
                ans.push_back(i);
                currmax = heights[i];
            }
        }
        sort(ans.begin(),ans.end());
        return ans;
    }
};
