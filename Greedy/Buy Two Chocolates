class Solution {
public:
    int buyChoco(vector<int>& prices, int money) {
        int n = prices.size();
        
        int p = 0;
        int leftover = money;
        sort(prices.begin(),prices.end());
        for(int i = 0; i < n; i++)
        {
            if(prices[i] <= money)
            {
                money -= prices[i];
                p++;
            }
            if(p == 2)
            {
                break;
            }
        }
        if(p != 2)
        {
            return leftover;
        }
        return money;

    }
};
