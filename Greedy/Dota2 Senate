class Solution {
public:
    string predictPartyVictory(string senate) {
        queue<int> R, D;

        int n = senate.size();

        for (int i = 0; i < n; i++) {
            if (senate[i] == 'R')
                R.push(i);
            else
                D.push(i);
        }

        while (!R.empty() && !D.empty()) {

            int r = R.front();
            int d = D.front();

            R.pop();
            D.pop();

            if (r < d) {
                // R bans D
                R.push(r + n);
            }
            else {
                // D bans R
                D.push(d + n);
            }
        }

        return R.empty() ? "Dire" : "Radiant";
    }
};
