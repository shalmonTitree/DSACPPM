class Solution {
public:
    int jump(vector<int>& nums) {
        int n = nums.size();
        int ans = 0;
        int maxreach = 0;
        int end = 0;
        int far = 0;

        for(int i = 0; i < n - 1; i++)
        {
            far = max(far,i + nums[i]);

            if(i == end)
            {
                ans++;
                end = far;
            }
        }
        return ans;
    }
};


//recu
class Solution {
public:
    int solve(int i, vector<int>& nums) {
        if (i >= nums.size() - 1)
            return 0;

        int ans = INT_MAX;

        for (int j = 1; j <= nums[i]; j++) {
            if (i + j < nums.size()) {
                int result = solve(i + j, nums);

                if (result != INT_MAX) {
                    ans = min(ans, 1 + result);
                }
            }
        }

        return ans;
    }

    int jump(vector<int>& nums) {
        return solve(0, nums);
    }
};

//memo
class Solution {
public:
    int solve(int i, vector<int>& nums, vector<int>& dp) {
        // Reached or crossed the last index
        if (i >= nums.size() - 1)
            return 0;

        // Already calculated
        if (dp[i] != -1)
            return dp[i];

        int ans = INT_MAX;

        for (int j = 1; j <= nums[i]; j++) {
            if (i + j < nums.size()) {
                int result = solve(i + j, nums, dp);

                if (result != INT_MAX) {
                    ans = min(ans, 1 + result);
                }
            }
        }

        return dp[i] = ans;
    }

    int jump(vector<int>& nums) {
        int n = nums.size();

        vector<int> dp(n, -1);

        return solve(0, nums, dp);
    }
};

//tabu
class Solution {
public:
    int jump(vector<int>& nums) {
        int n = nums.size();

        vector<int> dp(n, INT_MAX);
        dp[0] = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 1; j <= nums[i] && i + j < n; j++) {
                if (dp[i] != INT_MAX) {
                    dp[i + j] = min(dp[i + j], dp[i] + 1);
                }
            }
        }

        return dp[n - 1];
    }
};
