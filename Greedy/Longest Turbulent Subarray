class Solution {
public:
    int maxTurbulenceSize(vector<int>& arr) {
        int curr = 1;
        int ans = 1;

        for (int i = 1; i < arr.size(); i++) {

            if (arr[i] == arr[i - 1]) {
                curr = 1;
            }
            else if (i >= 2 &&
                    ((arr[i - 2] < arr[i - 1] && arr[i - 1] > arr[i]) ||
                     (arr[i - 2] > arr[i - 1] && arr[i - 1] < arr[i]))) {
                curr++;
            }
            else {
                curr = 2;
            }

            ans = max(ans, curr);
        }

        return ans;
    }
};
