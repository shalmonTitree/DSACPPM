//bruteforce
class Solution {
public:
    int maxSumDistinctTriplet(vector<int>& x, vector<int>& y) {
        int ans = 0;
        int n = x.size();
        for(int i = 0; i < n; i++)
        {
            for(int j = 0; j < n; j++)
            {
                for(int k = 0; k < n; k++)
                {
                    if(x[i] != x[j] && x[j] != x[k] && x[k] != x[i])
                    {
                        ans = max(ans,y[i]+y[j]+y[k]);
                    }
                }
            }
        }
        if(ans == 0)
        {
            return -1;
        }
        return ans;
    }
};

//optimal
class Solution {
public:
    int maxSumDistinctTriplet(vector<int>& x, vector<int>& y) {
        unordered_map<int, int> mp;

        for (int i = 0; i < x.size(); i++) {
            mp[x[i]] = max(mp[x[i]], y[i]);
        }

        if (mp.size() < 3)
            return -1;

        vector<int> values;

        for (auto it : mp) {
            values.push_back(it.second);
        }

        sort(values.begin(), values.end());

        int n = values.size();

        return values[n - 1] + values[n - 2] + values[n - 3];
    }
};
