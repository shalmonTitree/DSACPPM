class Solution {
public:
    int maxAbsoluteSum(vector<int>& nums) {
        int n = nums.size();
        int mini = 0;
        int maxi = 0;

        int ans = 0;

        for(int i = 0; i < nums.size(); i++)
        {
            mini = min(0,mini) + nums[i];
            maxi = max(0,maxi) + nums[i];

            ans = max(ans,abs(mini));
            ans = max(ans,maxi);
        }
        return ans;
    }
};
