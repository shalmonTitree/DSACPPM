//bruteforce
**Complexity:**

- Time Complexity: O(n log n)
- Auxiliary Space Complexity: O(log n), typically for `std::sort`.
- Output Space: O(k).

**Why?**

We sort all n points, even though we only need the k closest points. This results in unnecessary sorting operations.

class Solution {
public:
    static bool cmp(vector<int>&a, vector<int>&b)
    {
        int d1 = a[0]*a[0] + a[1]*a[1];
        int d2 = b[0]*b[0] + b[1]*b[1];

        return d1 < d2;
    }
    vector<vector<int>> kClosest(vector<vector<int>>& points, int k) {

        sort(points.begin(),points.end(),cmp);
        vector<vector<int>>ans;
        for(int i = 0; i < k; i++)
        {
            ans.push_back(points[i]);
        }

        return ans;
    }
};


//Better – Min Heap (Store All Points)
Complexity:
- Time Complexity: O(n log n + k log n)
- Space Complexity: O(n)
We insert all n points into the priority queue and extract the k closest points.

class Solution {
public:
  
    vector<vector<int>> kClosest(vector<vector<int>>& points, int k) {

        priority_queue<pair<int,pair<int,int>>,vector<pair<int,pair<int,int>>>, greater<pair<int,pair<int,int>>>>pq;

        for(auto it : points)
        {
            int x = it[0];
            int y = it[1];
            int dist = x*x + y*y;

            pq.push({dist,{x,y}});
        }
     
        vector<vector<int>> ans;

        while(k--) {

            auto p = pq.top();
            pq.pop();

            int x = p.second.first;
            int y = p.second.second;

            ans.push_back({x,y});
        }

        return ans;
    }
};

//optimal 
Optimal – Max Heap of Size K
**Complexity:**

- Time Complexity: O(n log k)
- Auxiliary Space Complexity: O(k)
- Output Space: O(k)

**Why is this better?**

Unlike the Min Heap approach, which stores all n points, this approach stores only k points in the heap.

This reduces the auxiliary space complexity from O(n) to O(k).


class Solution {
public:
    vector<vector<int>> kClosest(vector<vector<int>>& points, int k) {

        priority_queue<pair<int, pair<int,int>>> pq;

        for(auto it : points) {

            int x = it[0];
            int y = it[1];

            int dist = x*x + y*y;

            pq.push({dist, {x,y}});

            if(pq.size() > k) {
                pq.pop();
            }
        }

        vector<vector<int>> ans;

        while(!pq.empty()) {

            auto p = pq.top();
            pq.pop();

            ans.push_back({
                p.second.first,
                p.second.second
            });
        }

        return ans;
    }
};
