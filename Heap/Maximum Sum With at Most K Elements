TC:
- Sorting all rows: O(N * M log M)
- Sorting selected elements: O(S log S)
- Calculating sum: O(K)
Overall TC: O(N * M log M + S log S)

SC: O(S) for the vector.

class Solution {
public:
    long long maxSum(vector<vector<int>>& grid, vector<int>& limits, int k) {

        vector<int> v;

        int n = grid.size();

        for(int i = 0; i < n; i++)
        {
            sort(grid[i].rbegin(), grid[i].rend());

            for(int j = 0; j < limits[i]; j++)
            {
                v.push_back(grid[i][j]);
            }
        }

        sort(v.rbegin(), v.rend());

        long long sum = 0;

        for(int i = 0; i < min(k, (int)v.size()); i++)
        {
            sum += v[i];
        }

        return sum;
    }
};


