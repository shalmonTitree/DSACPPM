Optimal Approach – Min Heap (Priority Queue) 
Operation	Complexity
Insert n elements individually	O(n log n)
Extract two smallest elements	O(log n) per extraction
Insert combined rope	O(log n)
Repeat n - 1 times	O(n log n)

Overall Time Complexity:

O(n log n)

Space Complexity:

O(n)

The priority queue stores at most n elements.

class Solution {
public:
    long long minCost(vector<int>& arr) {

        priority_queue<int, vector<int>, greater<int>> pq;

        for(auto it : arr) {
            pq.push(it);
        }

        long long cost = 0;

        while(pq.size() > 1) {

            int a = pq.top();
            pq.pop();

            int b = pq.top();
            pq.pop();

            int sum = a + b;

            cost += sum;

            pq.push(sum);
        }

        return cost;
    }
};

