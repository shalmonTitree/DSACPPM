//Brute Force – Frequency Map + Sorting
1. Use an unordered map to count the frequency of each element.
2. Store the elements and their frequencies in a vector.
3. Sort the vector based on frequency in descending order.
4. Return the first k elements.

Time Complexity (TC):
1. Building the frequency map: O(n)
2. Creating the vector of pairs: O(m)
3. Sorting the vector: O(m log m)
4. Extracting the top k elements: O(k)
Overall TC: O(n + m log m) = O(n log n)

Space Complexity (SC):
1. Unordered map: O(m)
2. Vector of pairs: O(m)
3. Answer vector: O(k)
Overall SC: O(m + k) = O(n)

Where:
- n = total number of elements in nums.
- m = number of distinct elements in nums.
- k = number of top frequent elements required.

class Solution {
public:
    vector<int> topKFrequent(vector<int>& nums, int k) {
        unordered_map<int, int> mp;

        for (int num : nums) {
            mp[num]++;
        }

        vector<pair<int, int>> arr;

        for (auto it : mp) {
            arr.push_back({it.second, it.first});
        }

        sort(arr.rbegin(), arr.rend());

        vector<int> ans;

        for (int i = 0; i < k; i++) {
            ans.push_back(arr[i].second);
        }

        return ans;
    }
};

//better Max Heap (Priority Queue)
We use a Max Heap based on frequency.
1. Count the frequency using an unordered map.
2. Insert {frequency, element} pairs into a Max Heap.
3. Extract the top element k times.
4. Store the extracted elements in the answer.

TC: O(N + M log M)
- O(N): Traversing the array and building the frequency map.
- O(M log M): Inserting M distinct elements into the max heap. Each insertion takes O(log M).
- O(K log M): Extracting K elements from the heap.
- Overall: O(N + M log M), since K ≤ M.
SC: O(M)
- O(M): Frequency map stores M distinct elements.
- O(M): Max heap stores M elements.
- O(K): Result vector stores K elements.
- Overall: O(M).



class Solution {
public:
    vector<int> topKFrequent(vector<int>& nums, int k) {
        unordered_map<int, int> mp;

        for (int num : nums) {
            mp[num]++;
        }

        priority_queue<pair<int, int>> pq;

        for (auto it : mp) {
            pq.push({it.second, it.first});
        }

        vector<int> ans;

        for (int i = 0; i < k; i++) {
            ans.push_back(pq.top().second);
            pq.pop();
        }

        return ans;
    }
};

//optimal
Instead of storing all unique elements in the heap, maintain only the k most frequent elements.
1. Count frequencies using an unordered map.
2. Insert {frequency, element} into a Min Heap.
3. If heap size exceeds k, remove the element with the smallest frequency.
4. At the end, the heap contains the k most frequent elements.

TC: O(N + M log K)
- O(N): Traversing the array and building the frequency map.
- O(M log K): Processing M distinct elements. Each heap insertion/removal takes O(log K), as heap size is maintained at K.
- O(K): Extracting K elements from the heap.
- Overall: O(N + M log K).
SC: O(M + K)
- O(M): Frequency map stores M distinct elements.
- O(K): Min heap stores at most K elements.
- O(K): Result vector stores K elements.
- Overall: O(M + K), which simplifies to O(M) since K ≤ M.

class Solution {
public:
    vector<int> topKFrequent(vector<int>& nums, int k) {
        unordered_map<int, int> mp;

        for (int num : nums) {
            mp[num]++;
        }

        priority_queue<
            pair<int, int>,
            vector<pair<int, int>>,
            greater<pair<int, int>>
        > pq;

        for (auto it : mp) {
            pq.push({it.second, it.first});

            if (pq.size() > k) {
                pq.pop();
            }
        }

        vector<int> ans;

        while (!pq.empty()) {
            ans.push_back(pq.top().second);
            pq.pop();
        }

        return ans;
    }
};


//more optimal
Complexity:
- Time Complexity: O(n)
  - Frequency counting: O(n) average.
  - Bucket creation: O(m).
  - Traversing buckets: O(n + m).
- Space Complexity: O(n)
class Solution {
public:
    vector<int> topKFrequent(vector<int>& nums, int k) {
        unordered_map<int, int> mp;

        for (int num : nums) {
            mp[num]++;
        }

        vector<vector<int>> bucket(nums.size() + 1);

        for (auto it : mp) {
            bucket[it.second].push_back(it.first);
        }

        vector<int> ans;

        for (int i = nums.size(); i >= 1; i--) {
            for (int num : bucket[i]) {
                ans.push_back(num);

                if (ans.size() == k) {
                    return ans;
                }
            }
        }

        return ans;
    }
};

