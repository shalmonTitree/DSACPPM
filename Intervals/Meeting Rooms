GFG - Attend All Meetings

====================================================
1. Brute Force
TC: O(n²)
SC: O(1)
====================================================

class Solution {
public:
    bool canAttend(vector<vector<int>>& arr) {

        int n = arr.size();

        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {

                if (!(arr[i][1] <= arr[j][0] || arr[j][1] <= arr[i][0]))
                    return false;
            }
        }

        return true;
    }
};

====================================================
2. Sorting (Optimal)
TC: O(n log n)
SC: O(1)
====================================================

class Solution {
public:
    bool canAttend(vector<vector<int>>& arr) {

        sort(arr.begin(), arr.end());

        for (int i = 1; i < arr.size(); i++) {
            if (arr[i][0] < arr[i - 1][1])
                return false;
        }

        return true;
    }
};
