//bruteforce
Complexity:
- Time: O(n³) worst case due to repeated pairwise comparisons and vector erasures.
- Auxiliary Space: O(1), excluding the input and output storage.

class Solution {
public:
    vector<vector<int>> merge(vector<vector<int>>& intervals) {

        bool merged = true;

        while(merged) {
            merged = false;

            for(int i = 0; i < intervals.size(); i++) {
                for(int j = i + 1; j < intervals.size(); j++) {

                    // Check overlap
                    if(intervals[i][0] <= intervals[j][1] &&
                       intervals[j][0] <= intervals[i][1]) {

                        intervals[i][0] = min(intervals[i][0], intervals[j][0]);
                        intervals[i][1] = max(intervals[i][1], intervals[j][1]);

                        intervals.erase(intervals.begin() + j);

                        merged = true;
                        break;
                    }
                }

                if(merged)
                    break;
            }
        }

        return intervals;
    }
};

//optimal
Complexity:
- Time: O(n log n) — sorting takes O(n log n), traversal takes O(n).
- Auxiliary Space: O(n) for the result vector, plus O(log n) typically for sorting's stack.

class Solution {
public:
    vector<vector<int>> merge(vector<vector<int>>& intervals) {

        sort(intervals.begin(), intervals.end());

        vector<vector<int>> ans;

        ans.push_back(intervals[0]);

        for(int i = 1; i < intervals.size(); i++) {

            if(intervals[i][0] <= ans.back()[1]) {

                ans.back()[1] = max(ans.back()[1], intervals[i][1]);

            }
            else {
                ans.push_back(intervals[i]);
            }
        }

        return ans;
    }
};
