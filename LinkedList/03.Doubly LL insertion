#include <iostream>
using namespace std;

class Node {
public:
    int data;
    Node* prev;
    Node* next;

    Node(int val) {
        data = val;
        prev = nullptr;
        next = nullptr;
    }
};

Node* head = nullptr;

// Insert at Beginning
void insertBeg(int val) {
    Node* newNode = new Node(val);

    newNode->next = head;

    if (head != nullptr)
        head->prev = newNode;

    head = newNode;
}

// Insert at End
void insertEnd(int val) {
    Node* newNode = new Node(val);

    if (head == nullptr) {
        head = newNode;
        return;
    }

    Node* temp = head;
    while (temp->next != nullptr) {
        temp = temp->next;
    }

    temp->next = newNode;
    newNode->prev = temp;
}

// Insert at Position (1-based indexing)
void insertPos(int val, int pos) {
    if (pos <= 0) {
        cout << "Invalid Position\n";
        return;
    }

    if (pos == 1) {
        insertBeg(val);
        return;
    }

    Node* temp = head;

    for (int i = 1; i < pos - 1 && temp != nullptr; i++) {
        temp = temp->next;
    }

    if (temp == nullptr) {
        cout << "Position Out of Range\n";
        return;
    }

    Node* newNode = new Node(val);

    newNode->next = temp->next;
    newNode->prev = temp;

    if (temp->next != nullptr)
        temp->next->prev = newNode;

    temp->next = newNode;
}

// Display Forward
void display() {
    Node* temp = head;

    while (temp != nullptr) {
        cout << temp->data << " ";
        temp = temp->next;
    }

    cout << endl;
}

int main() {
    insertBeg(20);
    insertBeg(10);

    insertEnd(40);
    insertEnd(50);

    insertPos(30, 3);

    display(); // 10 20 30 40 50

    return 0;
}
