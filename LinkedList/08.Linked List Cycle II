1. Using a Hash Set
Time: O(n)
Space: O(n)

class Solution {
public:
    ListNode *detectCycle(ListNode *head) {
        unordered_set<ListNode*> st;

        while (head != NULL) {
            if (st.find(head) != st.end())
                return head;

            st.insert(head);
            head = head->next;
        }

        return NULL;
    }
};

2. Floyd's Cycle Detection
Time: O(n)
Space: O(1)

class Solution {
public:
    ListNode *detectCycle(ListNode *head) {
        ListNode* slow = head;
        ListNode* fast = head;

        // Detect cycle
        while (fast != NULL && fast->next != NULL) {
            slow = slow->next;
            fast = fast->next->next;

            if (slow == fast) {
                ListNode* ptr = head;

                while (ptr != slow) {
                    ptr = ptr->next;
                    slow = slow->next;
                }

                return ptr;
            }
        }

        return NULL;
    }
};
