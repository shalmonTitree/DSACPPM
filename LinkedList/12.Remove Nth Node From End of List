/*
===============================================================================
Approach 1: Two Pass (Find Length)
===============================================================================

Idea:
- Traverse the list once to find its length.
- Calculate the node to remove from the beginning:
      position = length - n
- Traverse again to that node and remove the next node.

Time Complexity : O(N)
Space Complexity: O(1)
*/

class Solution1 {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {

        ListNode* temp = head;
        int len = 0;

        while (temp) {
            len++;
            temp = temp->next;
        }

        if (len == n)
            return head->next;

        temp = head;

        for (int i = 1; i < len - n; i++)
            temp = temp->next;

        temp->next = temp->next->next;

        return head;
    }
};



/*
===============================================================================
Approach 2: One Pass (Fast & Slow Pointer) - Optimal
===============================================================================

Idea:
- Create a dummy node before head.
- Move the fast pointer n steps ahead.
- Move both fast and slow until fast reaches the last node.
- Slow will be just before the node to delete.
- Remove the node.

Time Complexity : O(N)
Space Complexity: O(1)
*/

class Solution2 {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {

        ListNode dummy(0);
        dummy.next = head;

        ListNode* fast = &dummy;
        ListNode* slow = &dummy;

        for (int i = 0; i < n; i++)
            fast = fast->next;

        while (fast->next) {
            fast = fast->next;
            slow = slow->next;
        }

        slow->next = slow->next->next;

        return dummy.next;
    }
};

