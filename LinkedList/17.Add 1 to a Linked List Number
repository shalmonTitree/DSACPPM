class Solution {
public:
    Node* addOne(Node* head) {
        long long num = 0;
        Node* temp = head;

        while (temp) {
            num = num * 10 + temp->data;
            temp = temp->next;
        }

        num++;

        string s = to_string(num);

        Node* newHead = new Node(s[0] - '0');
        Node* curr = newHead;

        for (int i = 1; i < s.size(); i++) {
            curr->next = new Node(s[i] - '0');
            curr = curr->next;
        }

        return newHead;
    }
};


