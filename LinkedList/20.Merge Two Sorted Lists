/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* mergeTwoLists(ListNode* list1, ListNode* list2) {
        vector<int>nodes;

        ListNode* temp = list1;
        while(temp)
        {
            nodes.push_back(temp->val);
            temp = temp->next;
        }

        temp = list2;
        while(temp)
        {
            nodes.push_back(temp->val);
            temp = temp->next;
        }

        sort(nodes.begin(),nodes.end());

        ListNode dummy(0);
        ListNode* tail = &dummy;

        for(int i = 0; i < nodes.size(); i++)
        {
            tail->next = new ListNode(nodes[i]);
            tail = tail->next;
        }
        tail->next = NULL;

        return dummy.next;

    }
};


//two pointer apporach
/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* mergeTwoLists(ListNode* list1, ListNode* list2) {
        ListNode dummy(0);
        ListNode* tail = &dummy;

        while(list1 && list2)
        {
            if(list1->val <= list2->val)
            {
                tail->next = list1;
                list1 = list1->next;
                
            }else{
                tail->next = list2;
                list2 = list2->next;
            }

            tail = tail->next;
        }

        while(list1)
        {
             tail->next = list1;
            list1 = list1->next;
            tail = tail->next;
        }
        while(list2)
        {
            tail->next = list2;
                list2 = list2->next;
                tail = tail->next;
        }

        return dummy.next;
    }

};

