https://leetcode.com/problems/find-the-highest-altitude/

class Solution {
public:
    int largestAltitude(vector<int>& gain) {
        int n = gain.size();
        vector<int>pre(n+1,0);
        pre[0] = gain[0];
        for(int i = 1; i < n; i++)
        {
            pre[i] = pre[i-1] + gain[i];
        }
        int maxi = 0;
        for(int i= 0; i < pre.size(); i++)
        {
            maxi = max(maxi,pre[i]);
        }
        return maxi;
    }
};
