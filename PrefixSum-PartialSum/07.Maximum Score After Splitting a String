https://leetcode.com/problems/maximum-score-after-splitting-a-string/description/

class Solution {
public:
    int maxScore(string s) {
        int n = s.size();
        vector<int>pre(n+1,0);
        vector<int>suff(n+1,0);
        if(s[0] == '0')
        {
            pre[0] = 1;
        }
        if(s[n - 1] == '1')
        {
            suff[n-1] = 1;
        }

        for(int i = 1; i < n; i++)
        {
            if(s[i] == '0')
            {
                pre[i] = pre[i-1] + 1;
            }
            else
            {
                pre[i] = pre[i-1];
            }
        }


        for(int i = n - 2; i >= 0; i--)
        {
            if(s[i] == '1')
            {
                suff[i] = suff[i+1] + 1;
            }
            else
            {
                suff[i] = suff[i+1];
            }
        }
        int ans = 0;
        for(int i = 0; i < n - 1; i++)
        {
            ans = max(ans,pre[i] + suff[i+1]);
        }
        return ans;
    }
};

