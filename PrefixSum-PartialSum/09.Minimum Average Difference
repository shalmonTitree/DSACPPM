https://leetcode.com/problems/minimum-average-difference/?envType=problem-list-v2&envId=prefix-sum


class Solution {
public:
    int minimumAverageDifference(vector<int>& nums) {
        int n = nums.size();
        vector<long long>pre(n+1,0);
        vector<long long>suff(n+1,0);
        
        pre[0] = nums[0];
        long long presum = nums[0];
        long long suffsum = nums[n-1];
        for(int i = 1; i < n; i++)
        {
            presum += nums[i];
            pre[i] = presum / (i + 1);
        }

        suff[n-1] = nums[n-1];
        for(int i = n - 2;i>=0;i--)
        {
            suffsum += nums[i];
            suff[i] = suffsum / (n - i);
        }
        int ans = INT_MAX;
        int idx = 0;
        for(int i = 0; i < n; i++)
        {
            long long val = llabs(pre[i] - suff[i+1]);
            if(val < ans)
            {
                ans = val;
                idx = i;
            }

        }
        return idx;

    }
};

