https://leetcode.com/problems/find-the-smallest-balanced-index/description/?envType=problem-list-v2&envId=prefix-sum 
class Solution {
public:
    int smallestBalancedIndex(vector<int>& nums) {
        int n = nums.size();
        vector<long long> presum(n + 1, 0);
        vector<long long> suffpro(n + 1, 1);

        for (int i = 0; i < n; i++) {
            presum[i + 1] = presum[i] + nums[i];
        }
        for (int i = n - 1; i >= 0; i--) {
            if (suffpro[i + 1] > 1e18 / nums[i])
                suffpro[i] = 1e18;
            else
                suffpro[i] = suffpro[i + 1] * nums[i];
        }

        for (int i = 0; i < n; i++) {
            if (presum[i] == suffpro[i + 1]) {
                return i;
            }
        }
        return -1;
    }
};
