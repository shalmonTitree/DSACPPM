https://leetcode.com/problems/equal-score-substrings/?envType=problem-list-v2&envId=prefix-sum
class Solution {
public:
    bool scoreBalance(string s) {
        int n = s.size();
        char c = 'a';
        unordered_map<char,int>mp;
        for(int i = 1; i <= 26; i++)
        {
            mp[c] = i;
            c++;
        }

        vector<int>pre(n,0);
        vector<int>suff(n,0);

        pre[0] = mp[s[0]];
        suff[n-1] = mp[s[n-1]];

        for(int i = 1; i < n; i++)
        {
            pre[i] = pre[i-1] + mp[s[i]];
        }
        for(int i = n-2; i >= 0; i--)
        {
            suff[i] = suff[i+1] + mp[s[i]];
        }
        for(int i = 0; i < n - 1; i++)
        {
            if(pre[i] == suff[i+1])
            {
                return true;
            }
        }
        return false;

    }
};

