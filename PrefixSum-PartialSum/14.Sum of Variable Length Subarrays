class Solution {
public:
    int subarraySum(vector<int>& nums) {
        int n = nums.size();
        vector<int>pre(n,0);
        pre[0] = nums[0];
        for(int i = 1; i < n; i++)
        {
            pre[i] = pre[i-1] + nums[i];
        }
        int sum = 0;
        for(int i = 0; i < n; i++)
        {
            int l = max(0,i - nums[i]);
            int r = i;

            if(l == 0)
            {
                sum += pre[r];
            }
            else
            {
                sum += pre[r] - pre[l-1];
            }
        }


        return sum;
    }
};
