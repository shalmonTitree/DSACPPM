class Solution {
public:
    string shiftingLetters(string s, vector<int>& shifts) {
        int n = s.size();
        vector<long long>suff(n);
        suff[n-1] = shifts[n-1];

        for(int i = n-2; i >= 0; i--)
        {
            suff[i] = suff[i+1] + shifts[i];
        }
        string ans = "";
        for(int i = 0; i < n; i++)
        {
            int pos = s[i] - 'a';
            long long shifting = pos + suff[i];
            int wrap = shifting%26;
            char ch = 'a' + wrap;
            ans += ch;
        }
        return ans;
    }
};

