//bruteforce
TC: Common upper-bound estimate O(n! × n) for the search, plus the cost of copying solutions.
Auxiliary SC: O(n) recursion stack, excluding the board and output; the board itself uses O(n²).


class Solution {
public: 
    bool isSafe(int row,int col,vector<string>&board, int n)
    {
        int r = row;
        int c = col;

        //upper left diag
        while(r >= 0 && c >= 0)
        {
            if(board[r][c] == 'Q')
            {
                return false;
            }
            r--;
            c--;
        }

        r = row;
        c = col;

        //same coumn
        while(r >= 0)
        {
            if(board[r][c] == 'Q')
            {
                return false;
            }
            r--;

        }

        //upper righ diag
        r = row;
        c = col;
        while(r >= 0 && c < n)
        {
            if(board[r][c] == 'Q')
            {
                return false;
            }
            r--;
            c++;
        }

        return true;
    }
    void solve(int row, int n, vector<vector<string>>&ans,vector<string>&board)
    {
        if(row == n)
        {
            ans.push_back(board);
            return;
        }

        for(int col = 0; col < n; col++)
        {
            if(isSafe(row,col,board,n))
            {
                board[row][col] = 'Q';
                solve(row+1, n , ans,board);
                board[row][col] = '.';
            }
        }
    }
    vector<vector<string>> solveNQueens(int n) {
        vector<vector<string>>ans;
        vector<string>board(n,string(n,'.'));
        solve(0,n,ans,board);
        return ans;
    }
};


