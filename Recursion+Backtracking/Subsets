//bruteforce
	O(n × 2ⁿ)	O(n)

class Solution {
public:
    void solve(int idx,vector<int>&nums,vector<vector<int>>&ans,vector<int>&curr)
    {   
        if(idx == nums.size())
        {
            ans.push_back(curr);
            return;
        }

        curr.push_back(nums[idx]);
        solve(idx + 1,nums,ans,curr);
        curr.pop_back();

        solve(idx+1,nums,ans,curr);
    }
    vector<vector<int>> subsets(vector<int>& nums) {
        vector<vector<int>>ans;
        vector<int>curr;
        solve(0,nums,ans,curr);
        return ans;

    }
};
