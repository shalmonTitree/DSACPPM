LeetCode 190 - Reverse Bits

====================================================
1. Bit by Bit (Optimal)
TC: O(32) = O(1)
SC: O(1)
====================================================

class Solution {
public:
    uint32_t reverseBits(uint32_t n) {

        uint32_t ans = 0;

        for (int i = 0; i < 32; i++) {
            ans <<= 1;
            ans |= (n & 1);
            n >>= 1;
        }

        return ans;
    }
};

====================================================
2. Bit Manipulation (Using Bit Positions)
TC: O(32) = O(1)
SC: O(1)
====================================================

class Solution {
public:
    uint32_t reverseBits(uint32_t n) {

        uint32_t ans = 0;

        for (int i = 0; i < 32; i++) {
            if (n & (1u << i))
                ans |= (1u << (31 - i));
        }

        return ans;
    }
};
