Time Complexity: O((n - k + 1) × k) ≈ O(nk)
Space Complexity: O(1)

#include <iostream>
#include <climits>
using namespace std;

void printMin(int arr[], int n, int k) {
    for (int i = 0; i <= n - k; i++) {
        int mini = INT_MAX;

        for (int j = i; j < i + k; j++) {
            mini = min(mini, arr[j]);
        }

        cout << mini << " ";
    }
}

int main() {
    int arr[] = {10, 5, 2, 7, 8, 7};
    int n = sizeof(arr) / sizeof(arr[0]);
    int k = 3;

    printMin(arr, n, k);

    return 0;
}



//better
Time Complexity is O(nlogk)

#include <bits/stdc++.h>
using namespace std;

void printMinOfSubarrays(const vector<int> &arr, int k)
{
    multiset<int> s;

    for (int i = 0; i < arr.size(); i++)
    {
        s.insert(arr[i]);

        if (s.size() > k)
        {
            s.erase(s.find(arr[i - k]));
        }

        if (s.size() == k)
        {
            cout << *s.begin() << endl;
        }
    }
}


int main()
{
    // Example usage:
    vector<int> arr = {3, 1, 4, 2, 8, 6, 5, 7};
    int k = 3;

    cout << "Minimum of each " << k << "-size subarray:" << endl;
    printMinOfSubarrays(arr, k);
    
    return 0;
}

//optimal: monotone dequeue
Time Complexity: O(n)
Space Complexity: O(k)

#include <bits/stdc++.h>
using namespace std;

void printMin(vector<int> &arr, int k)
{
    deque<int> dq;

    for (int i = 0; i < arr.size(); i++)
    {
        while (!dq.empty() && dq.back() > arr[i])
            dq.pop_back();

        dq.push_back(arr[i]);

        if (i >= k && dq.front() == arr[i - k])
            dq.pop_front();

        if (i >= k - 1)
            cout << dq.front() << " ";
    }
}

int main()
{
    vector<int> arr = {10, 5, 2, 7, 8, 7};
    int k = 3;

    printMin(arr, k);

    return 0;
}

