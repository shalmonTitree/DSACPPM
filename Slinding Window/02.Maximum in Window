```text
Time Limit: 1 sec
Memory: 256 MB

Description

You are given an array A of size N and a positive integer K (K ≤ N). The elements of the array are A1, A2, ..., AN.

Let Bi = max(Ai, Ai+1, ..., Ai+K−1), for 1 ≤ i ≤ N−K+1.

Find Bi values for all i such that 1 ≤ i ≤ N−K+1.

Input Format

The first line contains T, the number of test cases.

For each test case, the first line contains N, the number of integers in the array A, and K.

The second line of each test case contains N space-separated integers A1, A2, ..., AN.

Output Format

For each test case, print array B as:
B1 B2 ... B(N−K+1)

Print each test case on a new line.

Constraints

1 ≤ T ≤ 100000
1 ≤ K ≤ N ≤ 100000
−10^9 ≤ Ai ≤ 10^9

Sum of N over all test cases ≤ 5 × 10^5

Sample Input

4
9 3
1 2 3 1 4 5 2 3 6
5 5
1 -4 3 -3 -9
4 1
-3 1 -8 3
5 2
-1 -1 -1 -1 -1

Sample Output

3 3 4 5 5 5 6
3
-3 1 -8 3
-1 -1 -1 -1

Note

For the first test case, sliding windows of size 3 produce maxima:
3, 3, 4, 5, 5, 5, 6.

For the second test case, the single window of size 5 has maximum 3.
```



//better
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
    ll n,k;
    cin>>n>>k;
    vector<ll>v(n);
    for(ll i = 0; i < n; i++)
    {
        cin>>v[i];
    }

    multiset<int, greater<int>> ms;

    for(int i = 0; i < n; i++)
    {
        ms.insert(v[i]);

        if(ms.size() > k)
        {
            ms.erase(ms.find(v[i-k]));
        }

        if(ms.size() == k)
        {
            cout<<*ms.begin()<<" ";
        }
    }
    cout<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}

//optimal
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
    ll n,k;
    cin>>n>>k;
    vector<ll>v(n);
    for(ll i = 0; i < n; i++)
    {
        cin>>v[i];
    }

    deque<int>dq;

    for(int i = 0; i < n; i++)
    {
        while(!dq.empty() && dq.back() < v[i])
        {
            dq.pop_back();
        }
        dq.push_back(v[i]);

        if(i >=k && dq.front() == v[i-k])
        {
            dq.pop_front();
        }

        if(i >= k - 1)
        {
            cout<<dq.front()<<" ";
        }

    }
    cout<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
