Time Limit: 1 sec
Memory: 256 MB

Description

Given an array of N integers and an integer D. Consider all subarrays with length D; the penalty of a subarray is the number of distinct elements present in the subarray. Find a subarray of length D with minimum penalty. Print the minimum penalty.

Input Format

The first line contains an integer T, the number of test cases (1 ≤ T ≤ 10,000).

For each test case:
The first line contains two integers N and D, where 1 ≤ N ≤ 10^6 and 1 ≤ D ≤ N.
The second line contains N space-separated integers Ai, where 0 ≤ Ai ≤ 10^6.

The sum of N over all test cases does not exceed 5 × 10^6.

Output Format

For each test case, print the minimum penalty in a new line.

Constraints

1 ≤ T ≤ 10^4
1 ≤ N ≤ 10^6
1 ≤ D ≤ N
0 ≤ Ai ≤ 10^6

The sum of N over all test cases does not exceed 5 × 10^6.

Sample Input

5
6 3
0 1 1 2 2 2
5 3
1 0 1 2 3
5 5
1 1 2 3 4
5 1
1 2 3 4 5
7 3
1 2 1 2 3 4 2

Sample Output

1
2
4
1
2

Note

For the first test case, all the subarrays of length 3 and their penalties are:

[0, 1, 1] - Penalty: 2
[1, 1, 2] - Penalty: 2
[1, 2, 2] - Penalty: 2
[2, 2, 2] - Penalty: 1

So the minimum penalty is 1.



//bruteforce
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
    ll n,d;
    cin>>n>>d;
    vector<ll>v(n);
    for(ll i = 0; i < n; i++)
    {
        cin>>v[i];
    }

    int ans = INT_MAX;
    for(int i = 0; i < n; i++)
    {
        set<int>st;
        for(int j = i; j < i + d;j++)
        {
            st.insert(v[j]);
        }
        int len = st.size();
        ans = min(ans,len);
    }
    cout<<ans<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}


//optimal
Time Complexity: O(n log d) (using map)
Space Complexity: O(d)

#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
    ll n,d;
    cin>>n>>d;
    vector<ll>v(n);
    for(ll i = 0; i < n; i++)
    {
        cin>>v[i];
    }

    ll ans = LLONG_MAX;
    map<ll,ll>mp;


    //3 steps: insert, remove, check

    for(ll i = 0; i < n; i++)
    {
        //insert
        mp[v[i]]++;

        //check window size
        if(i >= d)
        {
            mp[v[i - d]]--;

            if(mp[v[i-d]] == 0)
            {
                mp.erase(v[i-d]);
            }
        }

        //if equal to window size
        if(i >= d - 1)
        {
            ans = min(ans,(ll)mp.size());
        }
    }
    cout<<ans<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}



