#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
    int n,k;
    cin>>n>>k;
    int arr[n];
    for(int i = 0; i < n; i++)
    {
        cin>>arr[i];
    }


    int cnt = 0;
    int ans = 0;

    int tail = 0;
    int head = -1;

    while(tail < n)
    {
      
        while(head + 1 < n && ((cnt < k) || arr[head + 1] == 1))
        {
            head++;
            if(arr[head] == 0)
            {
                cnt++;
            }

        }
        
        //here cnt == k so update answer
        ans = max(ans,head - tail + 1);



        //now you have updated your anser and it has size of k so move tail from left
        //so tail++

        if(tail <= head)
        {
            if(arr[tail] == 0)
            {
                cnt--;
            }
            tail++;
        }
        else
        {
            tail++;
            head = tail - 1;
        }
    }

    cout<<ans<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    //cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
