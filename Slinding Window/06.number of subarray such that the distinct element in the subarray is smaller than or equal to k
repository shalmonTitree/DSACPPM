Time Limit: 1 sec
Memory: 256 MB

Description
Given an array of N integers, find the number of subarrays with at most K distinct elements.

Input Format
The first line contains T, the number of test cases (1 ≤ T ≤ 10).

For each test case, the first line contains two space-separated integers N and K where 1 ≤ N ≤ 10^5 and 0 ≤ K ≤ 10^5.

The next line contains N space-separated integers A1, A2, ..., AN where 0 ≤ Ai ≤ 10^6.

Output Format
For each test case print the number of subarrays with at most K distinct elements in a newline.

Constraints
1 ≤ T ≤ 10
1 ≤ N ≤ 10^5
0 ≤ K ≤ 10^5
0 ≤ Ai ≤ 10^6

Sample Input 1

5
3 2
1 2 3
3 2
3 2 2
5 0
2 1 0 4 0
7 3
1 2 1 0 1 0 2
10 5
1 0 7 1 10 2 4 10 1 3

Sample Output 1

5
6
0
28
46

Note
For each test case we count subarrays that contain at most K distinct elements using a sliding window. For example, in the first test case N = 3, K = 2, A = [1, 2, 3]. The valid subarrays are [1], [2], [3], [1, 2], [2, 3], giving 5 subarrays.



#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
    int n,k;
    cin>>n>>k;
    int arr[n];
    for(int i = 0; i < n; i++)
    {
        cin>>arr[i];
    }

    if(k == 0)
    {
        cout<<"0"<<endl;
        return;
    }

    //ds 
    int freq[1000100] = {0};
    int distcnt = 0;


    ll ans = 0;

    int tail = 0;
    int head = -1;

    while(tail < n)
    {
      
        while(head + 1 < n && (distcnt < k || freq[arr[head+1]] > 0))
        {
            head++;
            if(freq[arr[head]] == 0)
            {
                distcnt++;
               
            }
             freq[arr[head]]++;
        }
        
        //here cnt == k so update answer
        ans +=  head - tail + 1;




        //now you have updated your anser and it has size of k so move tail from left
        //so tail++

        if(tail <= head)
        {
            freq[arr[tail]]--;
            if(freq[arr[tail]] == 0)
            {
                distcnt--;
            }
            tail++;
        }
        else
        {
            tail++;
            head = tail - 1;
        }
    }

    cout<<ans<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
