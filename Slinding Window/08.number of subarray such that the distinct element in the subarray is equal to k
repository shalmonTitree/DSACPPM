#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

int atMostK(int arr[], int n, int k)
{
    if (k < 0)
        return 0;

    int freq[1000100] = {0};
    int distcnt = 0;
    int ans = 0;

    int tail = 0;
    int head = -1;

    while (tail < n)
    {
        while (head + 1 < n &&
               (distcnt < k || freq[arr[head + 1]] > 0))
        {
            head++;

            if (freq[arr[head]] == 0)
                distcnt++;

            freq[arr[head]]++;
        }

        ans += (head - tail + 1);

        if (tail <= head)
        {
            freq[arr[tail]]--;

            if (freq[arr[tail]] == 0)
                distcnt--;

            tail++;
        }
        else
        {
            tail++;
            head = tail - 1;
        }
    }

    return ans;
}

void solve()
{
    int n, k;
    cin >> n >> k;

    int arr[n];

    for (int i = 0; i < n; i++)
        cin >> arr[i];

    //less than equal to k - less than k = subarray equal to k
    cout << atMostK(arr, n, k) - atMostK(arr, n, k - 1) << endl;
}

int main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    // cin >> t;

    while (t--)
    {
        solve();
    }

    return 0;
}
