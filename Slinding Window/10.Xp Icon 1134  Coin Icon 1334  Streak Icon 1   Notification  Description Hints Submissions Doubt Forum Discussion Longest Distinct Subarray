
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
    int n;
    cin>>n;
    int arr[n];
    for(int i = 0; i < n; i++)
    {
        cin>>arr[i];
    }

    

    //ds 
    unordered_map<int, int> freq;
   


    ll ans = 0;

    int tail = 0;
    int head = -1;

    while(tail < n)
    {
      
        while(head + 1 < n && (freq[arr[head+1]]  == 0))
        {
            head++;
             freq[arr[head]]++;
        }
        
        //here cnt == k so update answer
        ll len =  head - tail + 1;
        ans = max(ans,(ll)len);

        //now you have updated your anser and it has size of k so move tail from left
        //so tail++

        if(tail <= head)
        {
            freq[arr[tail]]--;
        if (freq[arr[tail]] == 0)
            freq.erase(arr[tail]);   // optional
        tail++;
        }
        else
        {
            tail++;
            head = tail - 1;
        }
    }

    cout<<ans<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
