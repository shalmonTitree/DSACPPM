Time Limit: 2 sec
Memory Limit: 256 MB

Description

Given an array A of N integers and an integer target, find three distinct integers in A such that their sum is closest to target (i.e., the absolute value of sum − target is minimized).

Print the minimum absolute value of (sum − target).

You cannot select the same index more than once. All three selected indices must be distinct.

Input Format

The first line contains an integer T, the number of test cases (1 ≤ T ≤ 100).

For each test case:

* The first line contains two space-separated integers N and target.

  * 3 ≤ N ≤ 10³
  * −10¹⁸ ≤ target ≤ 10¹⁸
* The second line contains N space-separated integers A₁, A₂, ..., Aₙ.

  * −10⁹ ≤ Aᵢ ≤ 10⁹

The sum of N over all test cases does not exceed 10⁴.

Output Format

For each test case, print the minimum absolute value of (sum − target).

Constraints

3 ≤ N ≤ 10³

−10¹⁸ ≤ target ≤ 10¹⁸

−10⁹ ≤ Aᵢ ≤ 10⁹

Sum of N over all test cases ≤ 10⁴.

Sample Input 1

1
5 3
1 2 3 4 5

Sample Output 1

3

Note

For the sample test case, choosing the three integers 1, 2, and 3 gives the sum 6. The absolute difference from target = 3 is |6 − 3| = 3, which is the minimum possible.


#include <bits/stdc++.h>
using namespace std;

typedef long long ll;

void solve()
{
    ll n, tar;
    cin >> n >> tar;

    vector<ll> v(n);
    for (int i = 0; i < n; i++)
    {
        cin >> v[i];
    }

    sort(v.begin(), v.end());

    ll ans = LLONG_MAX;

    for (int l = 0; l < n - 2; l++)
    {
        int k = l + 1;
        int r = n - 1;

        while (k < r)
        {
            ll sum = v[l] + v[k] + v[r];

            if (sum == tar)
            {
                cout << 0 << '\n';
                return;
            }

            ans = min(ans, abs(sum - tar));

            if (sum < tar)
                k++;
            else
                r--;
        }
    }

    cout << ans << '\n';
}

int main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--)
    {
        solve();
    }

    return 0;
}
