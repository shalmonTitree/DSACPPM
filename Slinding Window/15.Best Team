//Bruteforce : Give tle 
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
    ll n,k;
    cin>>n>>k;
    vector<ll>v(n);
    for(int i = 0; i < n; i++)
    {
        cin>>v[i];
    }

    sort(v.begin(),v.end());
    ll ans = LLONG_MAX;

    for(int i = 0; i + k <= n; i++)
    {
        vector<ll>store;
        for(int j = i; j < i + k; j++)
        {
            store.push_back(v[j]);
            if(store.size() == k)
            {
                break;
            }
        }

        ll maxi = store[store.size() - 1];
        ll mini = store[0];

        ans = min(ans,maxi-mini);
    }
    cout<<ans<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}


