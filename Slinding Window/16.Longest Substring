//Bruteforce
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
    int n,k;
    cin>>n>>k;
    int ans = 0;
    string s;
    cin>>s;
    string str;
    cin>>str;
    // unordered_map<char,int>mp;
    // for (int i = 0; i < 26; i++) {
    //     mp['a' + i] = str[i];
    // }
    

    for(int i = 0; i < s.size(); i++)
    {
        int cnt = 0;
        for(int j = i; j < s.size(); j++)
        {
            if(str[s[j] - 'a'] == '0')
            {
                cnt++;
            }
            if(cnt > k) break;

            ans = max(ans,j-i+1);
        }
    }
    cout<<ans<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}


