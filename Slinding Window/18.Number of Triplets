#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
    ll n,k;
    cin>>n>>k;
    vector<ll>v(n);
    for(int i = 0; i < n; i++)cin>>v[i];
    int cnt = 0;
    for(int i = 0; i < n; i++)
    {
        for(int j = i + 1; j < n; j++)
        {
            for(int l = j + 1; l < n; l++)
            {
                if(v[i]+v[j]+v[l] <= k)
                {
                    cnt++;
                }
            }
        }
    }
    cout<<cnt<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}


//optmial
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
    ll n,k;
    cin>>n>>k;
    vector<ll>v(n);
    for(int i = 0; i < n; i++)cin>>v[i];
    int cnt = 0;
    sort(v.begin(),v.end());
   

    for(int i = 0; i < n - 2; i++)
    {
        int m = i + 1;
        int r = n - 1;

        while(m < r)
        {
            if(v[i] + v[m] + v[r] <= k)
            {
                cnt += (r - m);
                m++;
            }
            else{
                r--;
            }
        }
    }
    cout<<cnt<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
