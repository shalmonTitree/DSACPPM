
#include <bits/stdc++.h>
using namespace std;

void sort(int a[], int n)

{
    //add code here
    int s = 0;
    int e = n - 1;
    int m = 0;
    while(m <= e)
    {
        if(a[m] == 0)
        {
            swap(a[s],a[m]);
            {
                s++;
                m++;

            }
        }
        else if(a[m] == 2)
        {
            swap(a[e],a[m]);
            {
                e--;
            }
        }
        else if(a[m] == 1)
        {
           m++;

        }
     
    }
}


int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(0);
    cout.tie(0);

    int n;
    cin >> n;
    int a[n];
    for (int i = 0; i < n; i++)
    {
        cin >> a[i];
    }
    sort(a, n);
    for (int i : a)
    {
        cout << i << ' ';
    }
    cout << '\n';
    return 0;
}
