#include <iostream>
#include <vector>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        vector<long long> A(N);

        for (int i = 0; i < N; i++) {
            cin >> A[i];
        }

        bool palindrome = true;
        int left = 0, right = N - 1;

        while (left < right) {
            if (A[left] != A[right]) {
                palindrome = false;
                break;
            }
            left++;
            right--;
        }

        if (palindrome)
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}
