#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
    int n;
    cin>>n;
    string org,tar;
    cin>>org>>tar;
    int cost = 0;
    cin>>cost;

    vector<int>diff(n);

    for(int i = 0; i < n; i++)
    {
        if(org[i] != tar[i])
        {
            diff[i] = abs((org[i] - 'a') - (tar[i] - 'a'));
        }
        else
        {
            diff[i] = 0;
        }
    }

    int ans = 0;
    int sum = 0;
    int head = -1;
    int tail = 0;

    while(tail < n)
    {
        while(head+1 < n && sum + diff[head+1] <= cost)
        {
            head++;
            sum += diff[head];
        }

        ans = max(ans,head - tail + 1);

        if(tail <= head)
        {
               sum -= diff[tail];
               tail++;
             
        }
        else
        {
            tail++;
            head = tail - 1;
        }
    }
    // cout<<" "<<endl;
    cout<<ans<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
