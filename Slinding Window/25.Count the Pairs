#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
   ll n,x;
   cin>>n>>x;
   vector<ll>v(n);
   for(ll i = 0; i < n; i++)
   {
    cin>>v[i];
   }

   sort(v.begin(),v.end());
   ll cnt = 0;
   int l = 0;
   int r = n - 1;
   while(l < r)
   {
        if(v[l] + v[r] <= x)
        {
            cnt += (r-l);
            l++;
        }
        else
        {
            r--;
        }
   }
   cout<<2*cnt<<endl;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
