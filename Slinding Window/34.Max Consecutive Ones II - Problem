//bruteforce
#include <iostream>
#include <vector>
#include <sstream>
#include <string>
using namespace std;

int solution(vector<int>& nums) {
  
    int ans = 0;
    int n = nums.size();
    for(int i = 0; i < n; i++)
    {
        int cnt = 0;
        for(int j = i; j < n; j++)
        {
            if(nums[j] == 0)
            {
                cnt++;
            }
            if(cnt > 1)
            {
                break;
            }
            ans = max(ans,j-i+1);
        }
    }
  	return ans;
}

int main() {
    string line;
    getline(cin, line);
    line = line.substr(1, line.length() - 2);
    vector<int> nums;
    stringstream ss(line);
    string num;
    while (getline(ss, num, ',')) {
        nums.push_back(stoi(num));
    }
    cout << solution(nums) << endl;
    return 0;
}


//optimal

#include <iostream>
#include <vector>
#include <sstream>
#include <string>
#include <algorithm>
using namespace std;

int solution(vector<int>& nums) {
  
    int n = nums.size();
    int ans = 0;
    int head = -1;
    int tail = 0;
	int cnt = 0;
    while(tail < n)
    {
        while(head + 1 < n)
        {
			head++;
            if(nums[head] == 0)
            {
                cnt++;
            }
            if(cnt > 1)
            {
                break;
            }
        }
        if(cnt >  1)
        {
            ans = max(ans,head - tail);
        }
        else
        {
            ans = max(ans,head - tail + 1);
        }

        if(tail <= head)
        {
            if(nums[tail] == 0)
            {
                cnt--;
            }
            tail++;
        }
        else
        {
            tail++;
            head = tail - 1;
        }
    }
    return ans;

}

int main() {
    string line;
    getline(cin, line);
    line = line.substr(1, line.length() - 2);
    vector<int> nums;
    stringstream ss(line);
    string num;
    while (getline(ss, num, ',')) {
        nums.push_back(stoi(num));
    }
    cout << solution(nums) << endl;
    return 0;
}
