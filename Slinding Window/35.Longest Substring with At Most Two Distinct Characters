//bruteforce
int lengthOfLongestSubstring(string s) {
   int n = s.size();
   int ans = 0;
   for(int i = 0; i < n; i++)
   {
       unordered_map<char,int>mp;
       for(int j = i; j < n; j++)
       {
           mp[s[j]]++;
           if(mp.size() <= 2)
           {
               ans = max(ans,j - i + 1);
           }
           else
           {
               break;
           }
       }
   }
   return ans;
}



//optimal;

int lengthOfLongestSubstring(string s) {
   int n = s.size();
   int ans = 0;
   int head = -1;
   int tail = 0;
    int dis = 0;
    vector<int>freq(26,0);
   while(tail < n)
   {
       while(head + 1 < n && (freq[s[head+1] - 'a'] != 0 || dis < 2))
       {
           head++;
           if(freq[s[head] - 'a'] == 0)
           {
               dis++;
           }
           freq[s[head] - 'a']++;
          
       }

       if(dis <= 2)
       {
           ans = max(ans,head - tail + 1);
       }

       if(tail <= head)
       {
           freq[s[tail]-'a']--;
           if(freq[s[tail] - 'a'] == 0)
           {
               dis--;
           }
           tail++;
       }
       else
       {
           tail++;
           head = tail - 1;
       }
   }
   return ans;
}
