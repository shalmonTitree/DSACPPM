//bruteforce
#include<bits/stdc++.h>
int kDistinctChars(int k, string &str)
{
    int n = str.size();
   int ans = 0;
   for(int i = 0; i < n; i++)
   {
       unordered_map<char,int>mp;
       for(int j = i; j < n; j++)
       {
           mp[str[j]]++;
           if(mp.size() <= k)
           {
               ans = max(ans,j - i + 1);
           }
           else
           {
               break;
           }
       }
   }
   return ans;
}




//optimal
#include<bits/stdc++.h>
int kDistinctChars(int k, string &str)
{
    int n = str.size();

   int ans = 0;
   int head = -1;
   int tail = 0;
    int dis = 0;
    vector<int>freq(26,0);
   while(tail < n)
   {
       while(head + 1 < n && (freq[str[head+1] - 'a'] != 0 || dis < k))
       {
           head++;
           if(freq[str[head] - 'a'] == 0)
           {
               dis++;
           }
           freq[str[head] - 'a']++;
          
       }

       if(dis <= k)
       {
           ans = max(ans,head - tail + 1);
       }

       if(tail <= head)
       {
           freq[str[tail]-'a']--;
           if(freq[str[tail] - 'a'] == 0)
           {
               dis--;
           }
           tail++;
       }
       else
       {
           tail++;
           head = tail - 1;
       }
   }
   return ans;
}


