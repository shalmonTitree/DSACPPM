class Solution {
public:
    int longestSubstring(string s, int k) {
        int n = s.size();

        int ans = 0;

        for(int i = 0; i < n; i++)
        {
            unordered_map<char,int>mp;
            for(int j = i; j < n; j++)
            {
                mp[s[j]]++;
                bool f = false;
                for(auto it : mp)
                {
                    if(it.second < k)
                    {
                        f = true;
                        break;
                    }
                }
                if(!f)
                {
                    ans = max(ans,j - i + 1);
                }
            }
        }
        return ans;
    }
};
