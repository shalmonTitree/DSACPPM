//bruteforce
Complexity Analysis:
- Time Complexity: (O(n^3)) – Three nested loops.
- Auxiliary Space: (O(1)).
class Solution {
public:
    int threeSumClosest(vector<int>& nums, int target) {
        int n = nums.size();

        int closestSum = nums[0] + nums[1] + nums[2];

        for (int i = 0; i < n - 2; i++) {
            for (int j = i + 1; j < n - 1; j++) {
                for (int k = j + 1; k < n; k++) {

                    int sum = nums[i] + nums[j] + nums[k];

                    if (abs(sum - target) <
                        abs(closestSum - target)) {
                        closestSum = sum;
                    }
                }
            }
        }

        return closestSum;
    }
};

