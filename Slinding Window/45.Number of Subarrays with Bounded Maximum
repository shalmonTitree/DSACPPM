//bruteforce
class Solution {
public:
    int numSubarrayBoundedMax(vector<int>& nums, int left, int right) {
        int n = nums.size();

        int cnt = 0;
        for(int i = 0; i < n; i++)
        {
            int maxi = 0;
            for(int j = i; j < n; j++)
            {
                maxi = max(maxi,nums[j]);
                if(maxi >= left && maxi <= right)
                {
                    cnt++;
                }
            }
        }
        return cnt;
    }
};


//optimal
class Solution {
public:
    int countSubarrays(vector<int>& nums, int k) {
        int cnt = 0;
        int len = 0;

        for (int x : nums) {
            if (x <= k) {
                len++;
            } else {
                len = 0;
            }

            cnt += len;
        }

        return cnt;
    }

    int numSubarrayBoundedMax(vector<int>& nums, int left, int right) {
        return countSubarrays(nums, right) - countSubarrays(nums, left - 1);
    }
};
