//bruteforce
For each window:
- Build curr → O(m)
- Sort curr → O(m log m)
- Compare with p → O(m)
Dominant operation is sorting:
TC = O(n × m log m)
Space Complexity
- curr → O(m)
- ans → O(k), where k is the number of anagrams found.
So:
Auxiliary SC = O(m)
If including the output array:
SC = O(m + k)
For interview/LeetCode purposes, you can usually say:
Time: O(n × m log m)
Space: O(m) (excluding the output array)



class Solution {
public:
    vector<int> findAnagrams(string s, string p) {
        int n = s.size();
        int m = p.size();
        vector<int>ans;
        sort(p.begin(),p.end());
        for(int i = 0; i <= n - m; i++)
        {
            string curr = "";
            for(int j = i; j < n; j++)
            {
                curr += s[j];
                if(j - i + 1 == m)
                {
                    sort(curr.begin(),curr.end());
                    
                    if(curr == p)
                    {
                        ans.push_back(i);
                    }
                    else
                    {
                        break;
                    }
                }
            }
        }
        return ans;
    }
};

//better
Time Complexity: O(n × m)
For each window of size m:
1. curr is maintained → O(m) across the window operations
2. Create freq → O(26) = O(1)
3. Traverse curr → O(m)
4. Traverse p → O(m)
5. Check 26 frequencies → O(26) = O(1)
There are approximately n windows.
So the dominant work is:
TC = O(n × m)
Space Complexity: O(m)


class Solution {
public:
    vector<int> findAnagrams(string s, string p) {
        int n = s.size();
        int m = p.size();

        vector<int> ans;
        sort(p.begin(), p.end());

        string curr = "";

        int head = -1;
        int tail = 0;
        while (tail < n) {
            while (head + 1 < n && (head + 1) - tail + 1 <= m) {
                head++;
                curr += s[head];
            }

            if (curr.size() == m) {
                vector<int> freq(26, 0);
                for (auto it : curr) {
                    freq[it - 'a']++;
                }
                for (auto it : p) {
                    freq[it - 'a']--;
                }

            

                bool flag = true;

                for (int i = 0; i < 26; i++) {
                    if (freq[i] != 0) {
                        flag = false;
                        break;
                    }
                }

                if (flag)
                    ans.push_back(tail);
            }

            if (tail <= head) {
                curr.erase(0, 1);
                tail++;
            } else {
                tail++;
                head = tail - 1;
            }
        }
        return ans;
    }
};

//otpimal
Time Complexity: O(n)
- Building freqp → O(m)
- Each character of s is added to freqs once → O(n)
- Each character is removed once → O(n)
- freqs == freqp compares 26 elements → O(26) = O(1)
Therefore:
TC = O(n + m) → O(n)
Space Complexity: O(1)
class Solution {
public:
    vector<int> findAnagrams(string s, string p) {
        int n = s.size();
        int m = p.size();

        vector<int> ans;

        vector<int> freqp(26, 0);
        vector<int> freqs(26, 0);

        for (auto it : p) {
            freqp[it - 'a']++;
        }

        int head = -1;
        int tail = 0;
        while (tail < n) {
            while (head + 1 < n && (head + 1) - tail + 1 <= m) {
                head++;
                freqs[s[head] - 'a']++;
            }

            if (head - tail + 1 == m) {
                if (freqs == freqp) {
                    ans.push_back(tail);
                }

                freqs[s[tail] - 'a']--;
                tail++;

            } else {
                tail++;
                head = tail - 1;
            }
        }
        return ans;
    }
};

