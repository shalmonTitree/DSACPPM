Time Complexity: O(n + m)

Both pointers traverse their respective arrays at most once. In each iteration, either i or j is incremented.

Space Complexity:
- Auxiliary Space: O(1)
- Including output array: O(n + m)

class Solution {
public:
    vector<vector<int>> intervalIntersection(vector<vector<int>>& firstList,
                                             vector<vector<int>>& secondList) {
        int n = firstList.size();
        int m = secondList.size();
        vector<vector<int>> ans;

        int i = 0;
        int j = 0;

        while (i < n && j < m) {
            pair<int, int> a = {firstList[i][0], firstList[i][1]};
            pair<int, int> b = {secondList[j][0], secondList[j][1]};
            vector<int> temp;

            if (b.first <= a.second && b.second >= a.first) {
                temp.push_back(max(a.first, b.first));
                temp.push_back(min(a.second, b.second));
                ans.push_back(temp);
            }

            if (a.second < b.second) {
                i++;
            } else {
                j++;
            }
        }
        return ans;
    }
};



