
class Solution {
public:
    int longestSubarray(vector<int>& nums) {

        int n = nums.size();
        int ans = 0;

        for (int i = 0; i < n; i++) {

            int zerocnt = 0;

            for (int j = i; j < n; j++) {

                if (nums[j] == 0) {
                    zerocnt++;
                }

                if (zerocnt > 1) {
                    break;
                }

                // One element must always be deleted
                ans = max(ans, j - i);
            }
        }

        return ans;
    }
};



class Solution {
public:
    int longestSubarray(vector<int>& nums) {
        int n = nums.size();
        int head = -1;
        int tail = 0;
        int ans = 0;
        int zerocnt = 0;
        while(tail < n)
        {
            while(head + 1 < n && zerocnt + (nums[head+1] == 0) <= 1)
            {
                head++;
                if(nums[head] == 0)
                {
                    zerocnt++;
                }
            }

            ans = max(ans,head-tail);

            if(tail <= head)
            {
                if(nums[tail] == 0)
                {
                    zerocnt--;
                }
                 tail++;
            }
            else
            {
                tail++;
                head = tail - 1;
            }
        }
        return ans;
    }
};
