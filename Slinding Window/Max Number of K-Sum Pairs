//bruteforce O(n²)
```cpp
class Solution {
public:
    int maxOperations(vector<int>& nums, int k) {

        int n = nums.size();

        vector<bool> vis(n, false);

        int ans = 0;

        for (int i = 0; i < n; i++)
        {
            if (vis[i])
                continue;

            for (int j = i + 1; j < n; j++)
            {
                if (!vis[j] && nums[i] + nums[j] == k)
                {
                    vis[i] = true;
                    vis[j] = true;

                    ans++;

                    break;
                }
            }
        }

        return ans;
    }
};
```

//optimal
```cpp
class Solution {
public:
    int maxOperations(vector<int>& nums, int k) {

        int n = nums.size();

        sort(nums.begin(), nums.end());

        int left = 0;
        int right = n - 1;

        int ans = 0;

        while (left < right)
        {
            int sum = nums[left] + nums[right];

            if (sum == k)
            {
                ans++;

                left++;
                right--;
            }
            else if (sum < k)
            {
                left++;
            }
            else
            {
                right--;
            }
        }

        return ans;
    }
};
```
