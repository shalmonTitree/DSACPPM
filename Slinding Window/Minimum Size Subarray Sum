class Solution {
public:
    int minSubArrayLen(int target, vector<int>& nums) {
        int n = nums.size();
        int ans = INT_MAX;
        for(int i = 0; i < n; i++)
        {
            int sum = 0;
            for(int j = i; j < n; j++)
            {
                sum += nums[j];
                if(sum >= target)
                {
                    ans = min(ans,j - i + 1);
                    break;
                }
            }
        }
        if(ans == INT_MAX)
        {
            return 0;
        }
        return ans;
    }
};

//optimal
class Solution {
public:
    int minSubArrayLen(int target, vector<int>& nums) {
        int n = nums.size();
        int ans = INT_MAX;
        int head = -1;
        int tail = 0;
        int sum = 0;
        while(tail < n)
        {
            while(head + 1 < n && sum < target)
            {
               head++;
               sum += nums[head];
            }

           if(sum >= target)
           {
            ans = min(ans,head - tail + 1);
           }

            if(tail > head)
            {
                tail++;
                head = tail - 1;
            }
            else
            {
                  sum -= nums[tail];
                tail++;
                
            }
        }
        if(ans == INT_MAX)
        {
            return 0;
        }
        return ans;
    }
};
