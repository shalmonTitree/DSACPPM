class Solution {
public:
    vector<string> findRepeatedDnaSequences(string s) {
        int Length = s.size();
        vector<string>answer;
        unordered_map<string,int>map;

        for(int idx_i = 0; idx_i < Length; idx_i++)
        {
            string current = "";
            for(int idx_j = idx_i; idx_j < Length; idx_j++)
            {
                current += s[idx_j];
                if(current.size() == 10)
                {
                    map[current]++;
                    break;
                }
            }
        }

        for(auto it : map)
        {
            if(it.second > 1)
            {
                answer.push_back(it.first);
            }
        }
        return answer;
    }
};

