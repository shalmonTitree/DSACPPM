//opimal
Complexity	Your code
Time	O(n)
Space	O(n)


class Solution {
public:
    vector<string> findRepeatedDnaSequences(string s) {
        int length = s.size();
        unordered_map<string,int>mp;
        vector<string>answer;

        int head = -1;
        int tail = 0;
        string current = "";

        while(tail < length)
        {
            while(head + 1 < length && (head + 1) - tail < 10) //see how you checked length
            {
                head++;
                current += s[head];
            }

            if((head - tail + 1) == 10)
            {
                mp[current]++;
            }

            if(tail <= head)
            {
                if(current.size() > 0) current.erase(0,1);
                tail++;
            }
            else
            {
                tail++;
                head = tail - 1;
            }
        }

        for(auto it : mp)
        {
            if(it.second > 1)
            {
                answer.push_back(it.first);
            }
        }
        return answer;
    }
};
