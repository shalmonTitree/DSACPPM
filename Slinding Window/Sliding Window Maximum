```cpp
class Solution {
public:
    vector<int> maxSlidingWindow(vector<int>& nums, int k) {

        int n = nums.size();

        int head = -1;
        int tail = 0;

        deque<int> dq;

        vector<int> ans;

        while(tail < n)
        {
            // Expand window
            while(head + 1 < n &&
                  (head + 1) - tail + 1 <= k)
            {
                head++;

                // Remove smaller elements
                while(!dq.empty() &&
                      nums[dq.back()] <= nums[head])
                {
                    dq.pop_back();
                }

                dq.push_back(head);
            }

            // Window size == k
            if(head - tail + 1 == k)
            {
                ans.push_back(nums[dq.front()]);
            }

            if(tail <= head)
            {
                // If maximum is leaving the window
                if(!dq.empty() && dq.front() == tail)
                {
                    dq.pop_front();
                }

                tail++;
            }
            else
            {
                tail++;
                head = tail - 1;
            }
        }

        return ans;
    }
};
