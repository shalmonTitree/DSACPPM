#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

int partitionarray(int s,int e,vector<int>&arr)
{
   int pivot = arr[s];
   int i = s + 1;
   int j = e;

   while(i <= j)
   {
        while(i <= e && arr[i] <= pivot)
        {
            i++;
        }

        while(j > s && arr[j] > pivot)
        {
            j--;
        }

        if(i < j)
        {
            swap(arr[i],arr[j]);
        }
   }
   swap(arr[s],arr[j]);
   return j;
}
void quicksort(int s,int e,vector<int>&arr)
{
   if(s < e)
   {
        int p = partitionarray(s,e,arr);

        quicksort(s,p-1,arr);
        quicksort(p+1,e,arr);
   }
}
void solve() {
    int n;
    cin>>n;
    vector<int>arr(n);
    for(int i = 0; i < n; i++)
    {
        cin>>arr[i];
    }

    quicksort(0,n-1,arr);

    for(int i = 0; i < n; i++)
    {
        cout<<arr[i]<<" ";
    }
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
