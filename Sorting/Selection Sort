#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
    int n;
    cin>>n;
    vector<int>arr(n);
    for(int i = 0; i < n; i++)
    {
        cin>>arr[i];
    }

    for(int i = 0; i <= n - 2; i++)
    {
        int mini = i;
        for(int j = i; j <= n - 1; j++)
        {
            if(arr[j] < arr[mini])
            {
                mini = j;
            }
        }

        swap(arr[i],arr[mini]);
    }

    for(int i = 0; i < n; i++)
    {
        cout<<arr[i]<<" ";
    }
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
