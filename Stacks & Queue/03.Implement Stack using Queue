#include <iostream>
#include <queue>
using namespace std;

class Stack {
private:
    queue<int> q;

public:
    // Push operation
    void push(int x) {
        q.push(x);

        // Rotate the queue
        int n = q.size();
        for (int i = 0; i < n - 1; i++) {
            q.push(q.front());
            q.pop();
        }

        cout << x << " pushed into stack\n";
    }

    // Pop operation
    void pop() {
        if (q.empty()) {
            cout << "Stack Underflow\n";
            return;
        }

        cout << q.front() << " popped from stack\n";
        q.pop();
    }

    // Peek operation
    void peek() {
        if (q.empty()) {
            cout << "Stack is empty\n";
            return;
        }

        cout << "Top element: " << q.front() << endl;
    }

    // Check if stack is empty
    bool isEmpty() {
        return q.empty();
    }

    // Display stack
    void display() {
        if (q.empty()) {
            cout << "Stack is empty\n";
            return;
        }

        queue<int> temp = q;

        cout << "Stack elements: ";
        while (!temp.empty()) {
            cout << temp.front() << " ";
            temp.pop();
        }
        cout << endl;
    }
};

int main() {
    Stack s;

    s.push(10);
    s.push(20);
    s.push(30);

    s.display();

    s.peek();

    s.pop();

    s.display();

    return 0;
}
