#include <iostream>
#include <stack>
using namespace std;

class Queue {
private:
    stack<int> s1, s2;

public:
    // Enqueue operation
    void enqueue(int x) {
        s1.push(x);
        cout << x << " inserted into queue\n";
    }

    // Dequeue operation
    void dequeue() {
        if (s1.empty() && s2.empty()) {
            cout << "Queue Underflow\n";
            return;
        }

        if (s2.empty()) {
            while (!s1.empty()) {
                s2.push(s1.top());
                s1.pop();
            }
        }

        cout << s2.top() << " removed from queue\n";
        s2.pop();
    }

    // Peek operation
    void peek() {
        if (s1.empty() && s2.empty()) {
            cout << "Queue is empty\n";
            return;
        }

        if (s2.empty()) {
            while (!s1.empty()) {
                s2.push(s1.top());
                s1.pop();
            }
        }

        cout << "Front element: " << s2.top() << endl;
    }

    // Check if queue is empty
    bool isEmpty() {
        return s1.empty() && s2.empty();
    }

    // Display queue
    void display() {
        if (isEmpty()) {
            cout << "Queue is empty\n";
            return;
        }

        stack<int> t1 = s1, t2 = s2;

        cout << "Queue elements: ";

        // Elements already in s2 are in correct order
        while (!t2.empty()) {
            cout << t2.top() << " ";
            t2.pop();
        }

        // Reverse s1 to print in queue order
        stack<int> temp;
        while (!t1.empty()) {
            temp.push(t1.top());
            t1.pop();
        }

        while (!temp.empty()) {
            cout << temp.top() << " ";
            temp.pop();
        }

        cout << endl;
    }
};

int main() {
    Queue q;

    q.enqueue(10);
    q.enqueue(20);
    q.enqueue(30);

    q.display();

    q.peek();

    q.dequeue();

    q.display();

    return 0;
}
