//bruteforce 
Time Complexity: O(nm²)
Auxiliary Space Complexity: O(1)
Space Complexity (including output): O(n)
	​

class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
        int n = nums1.size();
        int m = nums2.size();
        vector<int>ans;

        for(int i = 0; i < n; i++)
        {
            bool flag = false;
            for(int j = 0; j < m; j++)
            {
                if(nums1[i] == nums2[j])
                {
                    for(int k = j + 1; k < m; k++)
                    {
                        if(nums2[k] > nums1[i])
                        {
                            flag = true;
                            ans.push_back(nums2[k]);
                            break;
                        }
                    }
                }
            }
            if(!flag)
            {
                ans.push_back(-1);
            }
        }
        return ans;
    }
};

//optmial
Overall Time Complexity: O(n + m)
Auxiliary Space Complexity: O(m)

class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
        int n = nums1.size();
        int m = nums2.size();

        unordered_map<int,int>mp;
        stack<int>st;
        vector<int>ans;

        for(int i = m-1;i>=0;i--)
        {

            while(!st.empty() && st.top() <= nums2[i])
            {
                st.pop();
            }

            if(st.empty())
            {
                mp[nums2[i]] = -1;
            }
            else
            {
                mp[nums2[i]] = st.top();
            }

            st.push(nums2[i]);
        }

      
        for(int it : nums1)
        {
            ans.push_back(mp[it]);
        }
        return ans;
    }
};
