//bruteforce
Time Complexity: O(n²)
Space Complexity: O(n)

class Solution {
public:
    vector<int> nextGreaterElements(vector<int>& nums) {
        int n = nums.size();
        vector<int>newvec = nums;
        vector<int>ans;
        for(int i = 0; i < n; i++)
        {
            newvec.push_back(nums[i]);
        }

        for(int i = 0; i < n; i++)
        {
            bool flag = false;
            for(int j = i + 1; j < newvec.size(); j++)
            {
                if(newvec[j] > nums[i])
                {
                    flag = true;
                    ans.push_back(newvec[j]);
                    break;
                }
            }
            if(!flag)
            {
                ans.push_back(-1);
            }
        }
        return ans;
    }
};

//optimal
Time Complexity
O(n)
Space Complexity
O(n)

class Solution {
public:
    vector<int> nextGreaterElements(vector<int>& nums) {
        int n = nums.size();
        vector<int> ans(n);
        stack<int> st;

        for (int i = 2 * n - 1; i >= 0; i--) {
            while (!st.empty() && st.top() <= nums[i % n]) {
                st.pop();
            }

            if (i < n) {
                if (st.empty())
                    ans[i] = -1;
                else
                    ans[i] = st.top();
            }

            st.push(nums[i % n]);
        }

        return ans;
    }
};



