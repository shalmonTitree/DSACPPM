//Bruteforce
Time Complexity: O(n²)
Space Complexity: O(1)
class Solution {
  public:
    vector<int> nextSmallerEle(vector<int>& arr) {
        vector<int>ans;
        int n = arr.size();
        
        for(int i = 0; i < n; i++)
        {
            bool f = false;
            for(int j = i + 1; j < n; j++)
            {
                if(arr[j] < arr[i])
                {
                    ans.push_back(arr[j]);
                    f = true;
                    break;
                }
            }
            if(!f)
            {
                ans.push_back(-1);
            }
        }
        return ans;
        
    }
};

//optimal
Time Complexity: O(N)
- We traverse the array once from right to left, taking O(N) time.
- Each element is pushed into the stack exactly once.
- Each element is popped from the stack at most once.
Therefore, the amortized time complexity is O(N).
Space Complexity: O(N)
- ans vector stores N elements: O(N).
- Stack can store up to N elements in the worst case: O(N).
Therefore, auxiliary space complexity is O(N) for the stack.

Final Answer:
- TC: O(N)
- SC: O(N) (including output array)
- Auxiliary SC: O(N) (excluding output array)

class Solution {
  public:
    vector<int> nextSmallerEle(vector<int>& arr) {
        
        int n = arr.size();
        vector<int>ans(n);
        stack<int>st;
        
        for(int i = n - 1; i >= 0; i--)
        {
            while(!st.empty() && st.top() >= arr[i])
            {
                st.pop();
            }
            if(st.empty())
            {
                ans[i] = -1;
            }
            else
            {
                ans[i] = st.top();
            }
            
            st.push(arr[i]);
        }
        return ans;
        
    }
};
