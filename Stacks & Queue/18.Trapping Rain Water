//optimal two pointers
we need only 1 that smaller from(leftmax or rightmax)

class Solution {
public:
    int trap(vector<int>& height) {
        int n = height.size();

        int l = 0;
        int r = n - 1;
        int lmax = 0;
        int rmax = 0;
        int total = 0;

        while(l <= r)
        {
            if(height[l] <= height[r])
            {
                if(height[l] >= lmax)
                {
                    lmax = height[l];
                }
                else
                {
                    total += lmax - height[l];
                }
                l++;
            }
            else
            {
                if(height[r] >= rmax)
                {
                    rmax = height[r];
                }
                else
                {
                    total += rmax - height[r];
                }
                r--;
            }
        }
        return total;
    }
};


