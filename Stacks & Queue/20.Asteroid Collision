Time Complexity: \(O(N)\)
- Each asteroid is pushed into the stack at most once.
- Each asteroid is popped at most once.
- Therefore, total operations are linear.
- Space Complexity: \(O(N)\)
- In the worst case, all \(N\) asteroids are stored in the ans vector.
Final:
- TC: \(O(N)\)
- SC: \(O(N)\)


class Solution {
public:
    vector<int> asteroidCollision(vector<int>& asteroids) {
        int n = asteroids.size();
        vector<int>ans;

        for(int i = 0; i < n; i++)
        {
            if(asteroids[i] > 0)
            {
                ans.push_back(asteroids[i]);
            }
            else
            {
                while(!ans.empty() && ans.back() > 0 && ans.back() < abs(asteroids[i]))
            {
                ans.pop_back();
            }

            if(!ans.empty() && ans.back() == abs(asteroids[i]))
            {
                ans.pop_back();
            }
            else if(ans.empty() || ans.back() < 0)
            {
                ans.push_back(asteroids[i]);
            }
            }

            
        }
        return ans;
    }
};


//optimal
Time: O(N) amortized
Auxiliary Space: O(N)
Total Space: O(N)


class Solution {
public:
    vector<int> asteroidCollision(vector<int>& asteroids) {
        int n = asteroids.size();

        stack<int> st;

        for (auto it : asteroids) {
            bool destroy = false;

            while (!st.empty() && st.top() > 0 && it < 0) {
                if (abs(st.top()) < abs(it)) {
                    st.pop();
                }
                else if (abs(st.top()) == abs(it)) {
                    st.pop();
                    destroy = true;
                    break;
                }
                else {
                    destroy = true;
                    break;
                }
            }

            if (!destroy) {
                st.push(it);
            }
        }

        vector<int> ans(st.size());

        for (int i = st.size() - 1; i >= 0; i--) {
            ans[i] = st.top();
            st.pop();
        }

        return ans;
    }
};

