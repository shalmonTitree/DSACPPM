//bruteforce
Time Complexity
O(n²)
Space Complexity
O(1)

class Solution {
public:
    vector<int> prevSmaller(vector<int>& arr) {
        int n = arr.size();
        vector<int> ans(n);

        for (int i = 0; i < n; i++) {
            ans[i] = -1;

            for (int j = i - 1; j >= 0; j--) {
                if (arr[j] < arr[i]) {
                    ans[i] = arr[j];
                    break;
                }
            }
        }

        return ans;
    }
};

//optimal
Time Complexity
O(n)
Space Complexity
O(n)
          
class Solution {
public:
    vector<int> prevSmaller(vector<int>& arr) {
        int n = arr.size();
        vector<int> ans;
        stack<int> st;

        for (int i = 0; i < n; i++) {

            while (!st.empty() && st.top() >= arr[i]) {
                st.pop();
            }

            if (st.empty())
                ans.push_back(-1);
            else
                ans.push_back(st.top());

            st.push(arr[i]);
        }

        return ans;
    }
};
