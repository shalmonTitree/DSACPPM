class StockSpanner {
public:
    stack<pair<int,int>>st;
    int index = 0;
    StockSpanner() {
        
    }
    
    int next(int price) {
        
        while(!st.empty() && st.top().first <= price)
        {
            st.pop();
        }

        int previousidx;
        if(st.empty())
        {
            previousidx = -1;
        }
        else
        {
            previousidx = st.top().second;
        }
        int span = index - previousidx;

        st.push({price,index});

        index++;


        return span;
    }
};

