SPACE COMPLEXITY

The data structures used are:
1. pq: O(T) – Stores all tweets.
2. st: O(F) – Stores follow relationships.
3. cpy: O(T) – Temporary copy of the priority queue inside getNewsFeed().
4. ans: O(10) = O(1) – Stores at most 10 tweets.
Overall Auxiliary Space Complexity: O(T + F).

Peak Space Complexity: O(T + F), including the temporary priority queue copy.



class Twitter {

    unordered_map<int,unordered_set<int>>st;
    priority_queue<vector<int>>pq;
    int curr;

public:
  

    Twitter() {
        curr = 0;

    }
    
    void postTweet(int userId, int tweetId) {
        pq.push({curr++,tweetId,userId});
    }
    
    vector<int> getNewsFeed(int userId) {
        vector<int>ans;
        priority_queue<vector<int>>cpy = pq;

        int n = 0;

        while(!cpy.empty() && n < 10)
        {
            auto top = cpy.top();
            cpy.pop();
            //either user has posted or someone is follow this person you are getting the feed 
            if(top[2] == userId || st[userId].count(top[2]))
            {
                ans.push_back(top[1]);
                n++;
            }
        }
        return ans;

    }
    
    void follow(int followerId, int followeeId) {
        st[followerId].insert(followeeId);
    }
    
    void unfollow(int followerId, int followeeId) {
        st[followerId].erase(followeeId);
    }
};

