For a node at index i in a 0-indexed array:
Operation	Formula
Parent	(i-1)/2
Left child	2*i+1
Right child	2*i+2

#include <bits/stdc++.h>
using namespace std;

class MaxHeap {
    vector<int> heap;

public:
    // Insert an element
    void insert(int val) {
        heap.push_back(val);

        int i = heap.size() - 1;

        // Heapify Up
        while (i > 0) {
            int parent = (i - 1) / 2;

            if (heap[parent] < heap[i]) {
                swap(heap[parent], heap[i]);
                i = parent;
            } else {
                break;
            }
        }
    }

    // Return maximum element
    int getMax() {
        if (heap.empty()) return -1;
        return heap[0];
    }

    // Delete maximum element
    void deleteMax() {
        if (heap.empty()) return;

        heap[0] = heap.back();
        heap.pop_back();

        // Heapify Down
        int i = 0;
        int n = heap.size();

        while (true) {
            int largest = i;
            int left = 2 * i + 1;
            int right = 2 * i + 2;

            if (left < n && heap[left] > heap[largest])
                largest = left;

            if (right < n && heap[right] > heap[largest])
                largest = right;

            if (largest != i) {
                swap(heap[i], heap[largest]);
                i = largest;
            } else {
                break;
            }
        }
    }

    // Display heap
    void display() {
        for (int x : heap)
            cout << x << " ";
        cout << endl;
    }
};

int main() {
    MaxHeap h;

    h.insert(10);
    h.insert(20);
    h.insert(15);
    h.insert(30);
    h.insert(40);

    cout << "Max Element: " << h.getMax() << endl;

    h.display();

    h.deleteMax();

    cout << "After deletion: ";
    h.display();

    return 0;
}

