
#include <bits/stdc++.h>
using namespace std;

class MinHeap {
    vector<int> heap;

public:
    // Insert an element
    void insert(int val) {
        heap.push_back(val);

        int i = heap.size() - 1;

        // Heapify Up
        while (i > 0) {
            int parent = (i - 1) / 2;

            if (heap[parent] > heap[i]) {
                swap(heap[parent], heap[i]);
                i = parent;
            } else {
                break;
            }
        }
    }

    // Get minimum element
    int getMin() {
        if (heap.empty()) return -1;
        return heap[0];
    }

    // Delete minimum element
    void deleteMin() {
        if (heap.empty()) return;

        heap[0] = heap.back();
        heap.pop_back();

        // Heapify Down
        int i = 0;
        int n = heap.size();

        while (true) {
            int smallest = i;
            int left = 2 * i + 1;
            int right = 2 * i + 2;

            if (left < n && heap[left] < heap[smallest])
                smallest = left;

            if (right < n && heap[right] < heap[smallest])
                smallest = right;

            if (smallest != i) {
                swap(heap[i], heap[smallest]);
                i = smallest;
            } else {
                break;
            }
        }
    }

    // Display heap
    void display() {
        for (int x : heap)
            cout << x << " ";
        cout << endl;
    }
};

int main() {
    MinHeap h;

    h.insert(30);
    h.insert(10);
    h.insert(20);
    h.insert(5);
    h.insert(40);

    cout << "Minimum Element: " << h.getMin() << endl;

    h.display();

    h.deleteMin();

    cout << "After deletion: ";
    h.display();

    return 0;
}
