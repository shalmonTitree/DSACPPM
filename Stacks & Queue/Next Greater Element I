//bruteforce
Let:
- n = size of nums1
- m = size of nums2
Time Complexity (TC):

1. solve() function:
- Traverses nums2 once: O(m).
- Each element is pushed and popped from the stack at most once.
- Total: O(m).
2. Searching for elements:
- Outer loop runs n times.
- Inner loop runs m times.
- Each pair comparison takes O(1).
- Total: O(n × m).
Overall Time Complexity: O(m + n × m)

Space Complexity (SC):
1. cmp vector stores m pairs: O(m).
2. Stack stores at most m elements: O(m).
3. ans vector stores n elements: O(n).
Overall Space Complexity: O(n + m)

Final Complexity:

TC: O(m + n × m)

SC: O(n + m)

class Solution {
public:
    void solve(vector<pair<int,int>>&cmp, vector<int>& nums2)
    {   
        int n = nums2.size();
        stack<int>st;
      

        for(int i = n - 1; i >= 0; i--)
        {
            while(!st.empty() && st.top() <= nums2[i])
            {
                st.pop();
            }
            if(st.empty())
            {
                cmp[i].first = -1;
                cmp[i].second = nums2[i];
            }
            else
            {
                cmp[i].first = st.top();
                cmp[i].second = nums2[i];
            }
            st.push(nums2[i]);
        }
    }
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
        int n = nums1.size();
        int m = nums2.size();
        vector<pair<int,int>>cmp(m);
        solve(cmp,nums2);
        vector<int>ans;
        for(int i = 0; i < n; i++)
        {
            int curr = nums1[i];
            for(int j = 0; j < m; j++)
            {
                if(cmp[j].second == curr)
                {
                    ans.push_back(cmp[j].first);
                }
            }
        }
        return ans;
    }
};



//otpimal
Let:
- n = size of nums1
- m = size of nums2
1. solve() function:
- Traverses nums2 once: O(m).
- Each element is pushed into the stack once and popped at most once.
- Total: O(m).
2. Building the answer:
- Traverses nums1 once: O(n).
- Each unordered_map lookup takes O(1) average time.
- Total: O(n).
Overall Time Complexity: O(n + m) average.

Space Complexity (SC):
1. Stack: O(m).
2. Unordered map: O(m).
3. Answer vector: O(n).
Overall Space Complexity: O(n + m).

class Solution {
public:
    void solve( unordered_map<int,int>&mp, vector<int>& nums2)
    {   
        int n = nums2.size();
        stack<int>st;
      
        for(int i = n - 1; i >= 0; i--)
        {
            while(!st.empty() && st.top() <= nums2[i])
            {
                st.pop();
            }
            if(st.empty())
            {
                mp[nums2[i]] = -1;
            }
            else
            {
                mp[nums2[i]] = st.top();
            }
            st.push(nums2[i]);
        }
    }
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
        int n = nums1.size();
        int m = nums2.size();
        unordered_map<int,int>mp;

        solve(mp,nums2);
        vector<int>ans;
        for(int i = 0; i < n; i++)
        {
            ans.push_back(mp[nums1[i]]);
        }
        return ans;
    }
};

