class Solution {
public:
    string simplifyPath(string path) {
        
        stack<string>st;
        string ans = "";
        string temp = "";

        for(int i = 0; i < path.size(); i++)
        {
            if(path[i] == '/')
            {
                if(temp == ".")
                {

                }
                else if(temp == "..")
                {
                    if(!st.empty())
                    {
                        st.pop();
                    }
                }
                else if(!temp.empty())
                {
                    st.push(temp);
                }

                temp = "";
            }
            else
            {
                temp += path[i];
            }
        }


        if (temp == ".") {
    
        }
        else if (temp == "..") {
            if (!st.empty())
                st.pop();
        }
        else if (!temp.empty()) {
            st.push(temp);
        }


        while(!st.empty())
        {
            ans = "/" + st.top() + ans;
            st.pop();
        }
        
        if(ans.empty()) return "/";
        return ans;
    }
};


