#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

void solve() {
    int n;
    cin>>n;
    string s;
    cin>>s;
    int score = 0;

    for(int i = 0; i < s.size(); i++)
    {
        if(s[i] == 'V')
        {
            score += 5;
        }
        else if(s[i] == 'W')
        {
            score += 2;
        }
        else if(s[i] == 'X')
        {
            if(i+1 < s.size())
            {
                s.erase(i,1);
            }
            
        }
        else if(s[i] == 'Y')
        {
            if(i+1 < s.size())
            {
                char ch = s[i+1];
                s.erase(i,1);
                s.push_back(ch);
            }
        }
        else if(s[i] == 'Z')
        {
            if(i+1 < s.size())
            {

                char ch = s[i+1];
                if(ch == 'V')
                {
                    score /= 5;
                    s.erase(i,1);
                }
                else if(ch == 'W')
                {
                    score /= 2;
                    s.erase(i,1);
                }
            }
        }
    }
    cout<<score<<endl;
    
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    //cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}


