Here is the problem statement in plain text:

```text
Time Limit: 1 sec
Memory Limit: 256 MB

Description
Given a string s, determine if it can be made a palindrome by deleting at most one of its characters.

If s[i] is deleted, the resulting string is the concatenation of:
s[0:i-1] and s[i+1:n-1],
where n is the length of s.

If yes, print Y, otherwise print N.

Input Format
The first line contains an integer T, the number of test cases.

1 ≤ T ≤ 10000

Each of the next T lines contains a string S.

1 ≤ |S| ≤ 10^5

The sum of |S| over all test cases is at most 10^6.

Output Format
Print Y or N for each test case on a new line.

Constraints
1 ≤ T ≤ 10000
1 ≤ |S| ≤ 10^5
Sum of |S| across all test cases ≤ 10^6

Sample Input
2
abcfdcba
nitix

Sample Output
Y
N

Note
For the first test case:
s = "abcfdcba"

There is a single mismatch at the middle characters ('f' and 'd').
Deleting 'f' yields "abcdcba", which is a palindrome.
Therefore, the output is Y.

For the second test case:
s = "nitix"

Neither deleting the first mismatched character nor the second mismatched character results in a palindrome.
Therefore, the output is N.
```


#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

bool isPali(string &s,int l,int r)
{
    while(l < r)
    {
        if(s[l] != s[r])
        {
            return false;
        }
        l++;
        r--;
    }
    return true;

}
void solve() {
    string s;
    cin>>s;
    int i = 0;
    int j = s.size() - 1;
    int cnt = 0;
    bool k = true;
    while(i < j)
    {
        if(s[i] == s[j])
        {
            i++;
            j--;
        }
        else
        {
            k =  isPali(s,i+1,j) || isPali(s,i,j-1);
            break;
        }
    }
    if(k)
    {
        cout<<"Y"<<endl;
    }
    else
    {
        cout<<"N"<<endl;
    }
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}

