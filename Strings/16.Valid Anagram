//Bruteforce 
//Time Complexity: O(n log n)
//Space Complexity: O(log n) (due to sorting recursion stack)
class Solution {
public:
    bool isAnagram(string s, string t) {
        if(s.size() != t.size())
        {
            return false;
        }

        sort(s.begin(),s.end());
        sort(t.begin(),t.end());

        return s == t;
    }
};

//optimial 
//Time Complexity: O(n)
//Space Complexity: O(1)
class Solution {
public:
    bool isAnagram(string s, string t) {
        vector<int>freq(26);

        if(s.size() != t.size())
        {
            return false;
        }

        for(auto it : t)
        {
            freq[it - 'a']++;
        }
        for(auto it : s)
        {
            freq[it - 'a']--;
        }

        for(auto it : freq)
        {
            if(it != 0)
            {
                return false;
            }
        }

        return true;
    }
};
