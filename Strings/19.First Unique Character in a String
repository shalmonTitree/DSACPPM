//bruteforce
Time Complexity: O(n²)
Space Complexity: O(1)

class Solution {
public:
    int firstUniqChar(string s) {
        int n = s.size();
        for(int i = 0; i < n; i++)
        {
            bool f = false;
            for(int j = 0 ; j < n; j++)
            {
                if(s[i] == s[j] && i != j)
                {
                    f = true;
                    break;
                }
            }
            if(!f)
            {
                
                return i;
            }


        }
        return -1;
    }
};

//optimal
✅ Time Complexity: O(n)
✅ Space Complexity: O(1) (26-element array)
class Solution {
public:
    int firstUniqChar(string s) {
        vector<int> freq(26, 0);

        for(char ch : s) {
            freq[ch - 'a']++;
        }

        for(int i = 0; i < s.size(); i++) {
            if(freq[s[i] - 'a'] == 1) {
                return i;
            }
        }

        return -1;
    }
};

