//bruteforce
class Solution {
public:
    string ans = "";

     bool isPali( int left, int right,string &s) {
        while (left < right) {
            if (s[left] != s[right])
                return false;
            left++;
            right--;
        }
        return true;
    }

    void solve(int i,int j, string&s)
    {
        if(i > j) return;

        if(isPali(i,j,s))
        {
            if(j-i+1 > ans.size())
            {
                ans = s.substr(i,j-i+1);
            }
        }
        solve(i+1,j,s);
        solve(i,j-1,s);
    }
    string longestPalindrome(string s) {
        int n = s.size();
        solve(0,n-1,s);
        return ans;
    }
};

//optimal
class Solution {
public:
    string ans = "";

     

    bool solve(int i,int j, string&s,vector<vector<int>>&dp)
    {
        if(i >= j) return true;


        if(dp[i][j] != -1)return dp[i][j];

        if(s[i] != s[j])
        {
            return dp[i][j] = false;
        }

        return dp[i][j] = solve(i+1,j-1,s,dp);

    }
    string longestPalindrome(string s) {
        int n = s.size();
        vector<vector<int>>dp(n+1,vector<int>(n+1,-1));

         ans = s.substr(0, 1);

        for (int i = 0; i < n; i++) {
            for (int j = i; j < n; j++) {
                if (solve(i, j, s, dp)) {
                    if (j - i + 1 > ans.size()) {
                        ans = s.substr(i, j - i + 1);
                    }
                }
            }
        }

        return ans;
    }
};
