class Solution {
public:
    vector<int> preorderTraversal(TreeNode* root) {
        vector<int> ans;

        if (root == NULL)
            return ans;

        stack<TreeNode*> st;
        st.push(root);

        while (!st.empty()) {
            TreeNode* curr = st.top();
            st.pop();

            ans.push_back(curr->val);

            // Push right first
            if (curr->right != NULL)
                st.push(curr->right);

            // Push left second
            if (curr->left != NULL)
                st.push(curr->left);
        }

        return ans;
    }
};
