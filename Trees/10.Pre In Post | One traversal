void allTraversals(TreeNode* root) {
    if (root == nullptr) return;

    stack<pair<TreeNode*, int>> st;
    st.push({root, 1});

    vector<int> pre, in, post;

    while (!st.empty()) {
        auto &[node, state] = st.top();

        if (state == 1) {
            // PREORDER: Root
            pre.push_back(node->data);

            state++;

            // Go to left subtree
            if (node->left)
                st.push({node->left, 1});
        }

        else if (state == 2) {
            // INORDER: Left -> Root
            in.push_back(node->data);

            state++;

            // Go to right subtree
            if (node->right)
                st.push({node->right, 1});
        }

        else {
            // POSTORDER: Left -> Right -> Root
            post.push_back(node->data);

            st.pop();
        }
    }

    cout << "Preorder: ";
    for (int x : pre) cout << x << " ";

    cout << "\nInorder: ";
    for (int x : in) cout << x << " ";

    cout << "\nPostorder: ";
    for (int x : post) cout << x << " ";
}
