
class Solution {
public:
    vector<vector<int>> zigzagLevelOrder(TreeNode* root) {
        if(root == NULL) return {};
        
        vector<vector<int>>ans;
        queue<TreeNode*>q;
        q.push(root);
        
        bool flag = false;
        
        while(!q.empty())
        {
            int lvl = q.size();
            vector<int>level;
            
            for(int i = 0; i < lvl; i++)
            {
                TreeNode* node = q.front();
                q.pop();
                level.push_back(node->val);

                if(node->left != NULL)
                {
                    q.push(node->left);
                }

                if(node->right != NULL)
                {
                    q.push(node->right);
                }
            }
            if(flag)
            {
                reverse(level.begin(),level.end());
                
            }
            flag = !flag;
            ans.push_back(level);
        }
        return ans;
    }

};
