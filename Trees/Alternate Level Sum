Description

Given a binary tree, find the sum of all the nodes of alternate levels.

The root is at level `0`.
All the children of the root are at level `1`.
All the grandchildren of the root are at level `2`.
and so on.

Given `root` of the binary tree, Output the sum of all the nodes that are at alternate levels 0, 2, 4, and so on.

 Input Format

Complete the function ***int64_t alternateSum(TreeNode * root)*** that takes the root of the binary tree as input and returns the sum of all the nodes that are at alternate levels.

For local testing of the sample, the first line contains `T`, the number of test cases. The first line of each test case contains the level order traversal of the tree, where *'**`x`**'* denotes the *'nullptr'*.

Output Format

Return the sum of all the nodes that are at alternate levels.

Constraints

`1≤T≤104` - the number of test cases.
`1≤n≤105` - number of nodes in binary tree.
`1≤value≤105` - value of nodes in binary tree.
Sum of `n` over all test cases is `≤106`.

Sample Input 1

2 1,2,3,4,5,x,x,x,x,x,x 1,2,3,4,x,x,x,x,x

 Sample Output 1

10 5

 Note

for test case 1,

    1
   / \
  2   3
 / \     
4   5   

Output 10


for test case 2,

    1
   / \
  2   3
 /
4 


Output
5


#include <bits/stdc++.h>
using namespace std;

#define ll int64_t
#define endl '\n'

struct TreeNode {
    int data;
    TreeNode* left;
    TreeNode* right;
    TreeNode(int x) {
        this->left = nullptr;
        this->right = nullptr;
        this->data = x;
    }
};



class Solution {
    
    
public:
    
    
    int64_t alternateSum(TreeNode* root) {
        
        int64_t sum = 0;
        bool flag = true;
        if(root == NULL)
        {
            return sum;
        }
        queue<TreeNode*>q;
        q.push(root);

        while(!q.empty())
        {
            int sz = q.size();
            vector<int>lvl;
            for(int i = 0; i < sz; i++)
            {
                TreeNode* node = q.front();
                q.pop();
                
                lvl.push_back(node->data);
                
                if(node->left)
                {
                    q.push(node->left);
                }
                if(node->right)
                {
                    q.push(node->right);
                }
            }
            if(flag)
            {
                sum += (accumulate(lvl.begin(),lvl.end(),0));
            }
            flag = !flag;
        }
        return sum;
        
    }
    

    
};



TreeNode *deserialize(string data)
{
    if (data.size() == 0)
        return nullptr;
    vector<string> dat;
    string t;
    for (auto c : data)
    {
        if (c == ',')
        {
            dat.push_back(t);
            t.clear();
        }
        else
            t.push_back(c);
    }
    dat.push_back(t);
    int i = 0;
    queue<TreeNode *> q;
    TreeNode *root = new TreeNode(stoll(dat[0]));
    q.push(root);
    auto cur = root;
    i++;
    while (!q.empty())
    {
        auto x = q.front();
        q.pop();
        if (dat[i] != "x")
        {
            x->left = new TreeNode(stoll(dat[i]));
            q.push(x->left);
        }
        i++;
        if (dat[i] != "x")
        {
            x->right = new TreeNode(stoll(dat[i]));
            q.push(x->right);
        }
        i++;
    }
    return root;
}

