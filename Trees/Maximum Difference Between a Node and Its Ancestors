#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl

vector<vector<int>>graph;
vector<int>value;
vector<int>ans;

int n;

void dfs(int node,int parent,int minseen,int maxseen)
{
    ans[node] = max(abs(minseen - value[node]), abs(maxseen - value[node]));

    for(auto it : graph[node])
    {
        if(it != parent)
        {
            dfs(it,node,min(minseen,value[node], max(maxseen,value[node])));
        }
    }
}

void solve() {
    int n;
    cin>>n;


    graph.resize(n+1);
    value.resize(n+1);


    
    for(int i = 0; i < n - 1; i++)
    {
        int x,y;
        cin>>x>>y;

        graph[x].push_back(y);
        graph[y].push_back(x);
    }
    for(int i = 1;i <= n; i++)
    {
        cin>>value[i];
    }
    dfs(1,0,1e9,-1e9 );
    ans[1] = -1;

    for(int i = 1; i <= n; i++)
    {
        cout<<ans[i]<<" ";
    }
   
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    // cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
