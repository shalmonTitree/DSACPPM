```cpp
class Solution {
public:

    int ans = INT_MAX;
    int prev = -1;

    void dfs(TreeNode* node)
    {
        if(node == NULL)
        {
            return;
        }

        // Left
        dfs(node->left);

        // Current
        if(prev != -1)
        {
            ans = min(ans, node->val - prev);
        }

        prev = node->val;

        // Right
        dfs(node->right);
    }

    int getMinimumDifference(TreeNode* root)
    {
        dfs(root);

        return ans;
    }
};
