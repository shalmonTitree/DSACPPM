Time Limit: 3 sec
Memory Limit: 256 MB

Description

Convert a Binary Tree into its Mirror Tree.

Mirror of a Tree:

The mirror of a binary tree T is another binary tree M(T) where the left and right children of every non-leaf node are interchanged.

Input Format

The first line contains an integer T, the number of test cases.

For each test case:

The first line contains an integer N, the length of the array representing the serialized tree.

The next line contains N space-separated integers representing the serialized preorder representation of the tree, where -1 denotes a null node.

The input is given as a serialized representation of a binary tree.

The following function is used to parse the input:

Node* getBinaryTree(vector<int>& num, int* ind)

Output Format

Return the mirror tree as its serialized preorder representation, using -1 for null nodes.

Constraints

1 <= T <= 10^5

1 <= N

Sum of N over all test cases <= 10^7

Node values are integers.

Null nodes are represented by -1.

Sample Input 1

3
3
2067 -1 -1
13
8365 1448 5240 -1 9909 -1 -1 5843 -1 -1 5682 -1 -1
15
7841 883 -1 -1 4929 6791 -1 -1 9159 2122 -1 -1 4179 -1 -1

Sample Output 1

2067 -1 -1
8365 5682 -1 -1 1448 5843 -1 -1 5240 9909 -1 -1 -1
7841 4929 9159 4179 -1 -1 2122 -1 -1 6791 -1 -1 883 -1 -1

Note

For each test case, the mirror tree is obtained by recursively swapping the left and right children of every node.

The output should be the preorder serialized representation of the mirrored tree, with -1 representing null nodes.



#include <bits/stdc++.h>

using namespace std;

struct Node {
    int val;
    Node *left, *right;
    Node(int x) : val(x), left(NULL), right(NULL) {}
};

Node* solve(Node* root)
{
    if(root == NULL)
    {
        return NULL;
    }

    if(root->left || root->right)
    {
        swap(root->left,root->right);
    }

    if(root->left) solve(root->left);
    if(root->right) solve(root->right);

     return root;
}

Node* getMirrorTree(Node* root) {
    //Complete the function
    
    return solve(root);
}

Node* getBinaryTree(vector<int> &num, int*ind) {
    if(num[*ind] == -1)
        return NULL;
    Node* node = new Node(num[*ind]);
    (*ind)++;
    node->left = getBinaryTree(num,ind);
    (*ind)++;
    node->right = getBinaryTree(num,ind);
    return node;
}

void generateArray(Node* root, vector<int>&ans){
    if(root==NULL){
        ans.push_back(-1);
        return;
      }
    ans.push_back(root->val);
    generateArray(root->left,ans);
    generateArray(root->right,ans);
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(0); cout.tie(0);

    int t;
    cin >> t;
    while(t--){
        int n;
        cin>>n;
        assert(n<=1000000);
        vector<int>arr(n);
        for(int i=0;i<n;i++)
            cin>>arr[i];
        int ind = 0;
        Node* tree = getBinaryTree(arr,&ind);
        tree = getMirrorTree(tree);
        vector<int>ans;
        generateArray(tree,ans);
        for(auto v:ans)cout<<v<<" ";
        cout<<"\n";
    }
    return 0;
}
