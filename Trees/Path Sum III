Brute Force — DFS from Every Node
Idea: Start a path from every node and count all downward paths whose sum equals targetSum
Complexity
- Time: O(N²) worst case, when the tree is skewed.
- Auxiliary space: O(H) for the recursion stack.


class Solution {
public:

    int cnt = 0;

    void dfs(TreeNode* node, long long sum, int targetSum)
    {
        if(node == NULL)
        {
            return;
        }

        sum += node->val;

        if(sum == targetSum)
        {
            cnt++;
        }

        dfs(node->left, sum, targetSum);
        dfs(node->right, sum, targetSum);
    }

    void traverse(TreeNode* node, int targetSum)
    {
        if(node == NULL)
        {
            return;
        }

        // Start a path from this node
        dfs(node, 0, targetSum);

        // Try every node as starting point
        traverse(node->left, targetSum);
        traverse(node->right, targetSum);
    }

    int pathSum(TreeNode* root, int targetSum)
    {
        cnt = 0;

        traverse(root, targetSum);

        return cnt;
    }
};
Optimal — Prefix Sum + Hash Map
Idea: Instead of recalculating path sums from every node, maintain a running sum from the root to the current node.

If the current prefix sum is sum, a path ending at the current node has the target sum when an earlier prefix sum equals:

sum - targetSum

We store prefix sums and their frequencies in an unordered_map.
Complexity
- Time: O(N) on average, assuming expected constant-time hash map operations.
- Auxiliary space: O(H) for recursion and up to O(H) prefix-sum entries along the current path


class Solution {
public:
    int dfs(TreeNode* root, long long sum, int targetSum,
            unordered_map<long long, int>& prefix) {
        if (root == nullptr)
            return 0;

        sum += root->val;

        int count = prefix[sum - targetSum];

        prefix[sum]++;

        count += dfs(root->left, sum, targetSum, prefix);
        count += dfs(root->right, sum, targetSum, prefix);

        prefix[sum]--;

        return count;
    }

    int pathSum(TreeNode* root, int targetSum) {
        unordered_map<long long, int> prefix;
        prefix[0] = 1;

        return dfs(root, 0, targetSum, prefix);
    }
};
