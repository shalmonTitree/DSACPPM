class Solution {
public:
    Node* connect(Node* root) {

        if(root == NULL)
            return root;

        queue<Node*> q;
        q.push(root);

        while(!q.empty())
        {
            int sz = q.size();

            Node* prev = NULL;

            for(int i = 0; i < sz; i++)
            {
                Node* node = q.front();
                q.pop();

                // Connect previous node to current node
                if(prev != NULL)
                {
                    prev->next = node;
                }

                prev = node;

                if(node->left)
                {
                    q.push(node->left);
                }

                if(node->right)
                {
                    q.push(node->right);
                }
            }

            // Last node of level points to NULL
            prev->next = NULL;
        }

        return root;
    }
};
