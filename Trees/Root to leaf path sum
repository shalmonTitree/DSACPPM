Time Limit: **1 sec**Memory: **256 MB**

##### Description

Given a binary tree and a number `S`, return true if the tree has a root-to-leaf path such that adding up all the values along the path equals the given number. Return false if no such path can be found.

##### Input Format

The first line contains an integer `T`, `(1≤T≤105)`, the number of test cases.
For each test case:

* The first line contains two integers `N` and `S`, where `N` is the length of the array representing the serialized representation of a tree, and `S` is the given number.
* The next line contains `N` space-separated integers. The input is given as a serialized representation of a tree. The following function parses the input: *Node* getBinaryTree(vector &num, int* ind) Sum of `N` across all test cases `≤107`.

##### Output Format

For each test case, print "yes" if such a path exists, and "no" otherwise.

##### Constraints

* `1≤T≤105`
* `1≤N≤106`
* Sum of `N` over all test cases `≤107`

##### Sample Input 1

4 5 10 1 9 -1 -1 -1  5 61 8 -1 10 -1 -1  3 2 2 -1 -1  13 13 3 5 3 8 9 -1 -1 -1 -1 -1 1 -1 -1

##### Sample Output 1

yes no yes no

##### Note

For the first test case, there is a root-to-leaf path `1→9` whose sum is `10`.
For the second test case, there is no root-to-leaf path with sum `61`.
For the third test case, the tree has only one node with value `2`, and the sum is `2`.
For the fourth test case, no root-to-leaf path adds up to `13`.


#include <bits/stdc++.h>

using namespace std;

struct Node {
    int val;
    Node *left, *right;
    Node(int x) : val(x), left(NULL), right(NULL) {}
};

bool solve(Node* node,int t, int c)
{
    if(node == NULL)
    {
        return false;
    }
    //leafnode
    if(node->left == NULL && node->right == NULL)
    {
        if(t == c+node->val)
        {
            return true;
        }
        else
        {
            return false;
        }
    }

    bool left = solve(node->left,t,c + node->val);
    bool right = solve(node->right,t,c + node->val);
    return left || right;

}
bool hasPathSum(Node* node, int sum)
{
       if(node == NULL)
       {
        return false;
       }

        int currsum = 0;
       return solve(node,sum,currsum);
}


Node* getBinaryTree(vector<int> &num, int*ind) {
    if(num[*ind] == -1)
        return NULL;
    Node* node = new Node(num[*ind]);
    (*ind)++;
    node->left = getBinaryTree(num,ind);
    (*ind)++;
    node->right = getBinaryTree(num,ind);
    return node;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(0); cout.tie(0);

    int t;
    cin >> t;
    while(t--){
        int n,sum;
        cin>>n>>sum;
        assert(n<=1000000);
        vector<int>arr(n);
        for(int i=0;i<n;i++)
            cin>>arr[i];
        int ind = 0;
        Node* tree = getBinaryTree(arr,&ind);
        if(hasPathSum(tree,sum))
            cout<<"yes\n";
        else
            cout<<"no\n";
    }
    return 0;
}
