#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   // optional, better to avoid redefining endl


vector<int>store;

void dfs(int node,vector<vector<int>>&adj)
{
    store[node]  = 0;

    for(auto it : adj[node])
    {
        dfs(it,adj);
        store[node] += 1 + store[it];
    }

}
void solve() {
    int n;
    cin>>n;
    vector<int>v(n+1);
    store.resize(n+1);
    for(int i = 2; i <= n; i++)
    {
        cin>>v[i];
    }
    vector<vector<int>>adj(n+1);
    for(int i = 2; i <= n; i++)
    {
        adj[v[i]].push_back(i);
    }
    dfs(1,adj);
    for(int i = 1; i < store.size(); i++)
    {
        cout<<store[i]<<" ";
    }
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    // cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
