/*
===============================================================================
Approach 1: Brute Force (Recursive DFS + Same Tree) - Most Expected
===============================================================================

Idea:
- Traverse every node of the main tree.
- At each node, check whether the subtree rooted there is identical
  to subRoot using the Same Tree function.
- If found, return true.
- Otherwise, recursively search the left and right subtrees.

Time Complexity : O(M × N)
Space Complexity: O(H)

where
M = Number of nodes in root
N = Number of nodes in subRoot
H = Height of root
*/

class Solution1 {
public:

    bool isSame(TreeNode* p, TreeNode* q) {

        if (!p && !q)
            return true;

        if (!p || !q)
            return false;

        if (p->val != q->val)
            return false;

        return isSame(p->left, q->left) &&
               isSame(p->right, q->right);
    }

    bool isSubtree(TreeNode* root, TreeNode* subRoot) {

        if (!root)
            return false;

        if (isSame(root, subRoot))
            return true;

        return isSubtree(root->left, subRoot) ||
               isSubtree(root->right, subRoot);
    }
};
