#include <bits/stdc++.h>
using namespace std;

#define ll int64_t
#define endl '\n'

struct TreeNode {
    int data;
    TreeNode* left;
    TreeNode* right;
    TreeNode(int x) {
        this->left = nullptr;
        this->right = nullptr;
        this->data = x;
    }
};



class Solution {



public:

    int maxdepth(TreeNode* root)
    {
        if(root == NULL) return 0;

        int l = maxdepth(root->left);
        int r = maxdepth(root->right);

        return 1 + max(l,r);
    }

    int mindepth(TreeNode* root)
    {
        if(root->left == NULL && root->right == NULL)
        {
            return 1;
        }

        int l = INT_MAX;
        if(root->left)
        {
            l = mindepth(root->left);
        }

        int r = INT_MAX;
        if(root->right)
        {
            r = mindepth(root->right);
        }

        return 1 + min(l,r);

    }

    int treeDiff(TreeNode *root) {
        
        if(root == NULL)
        {
            return 0;
        }

        int maxd = maxdepth(root);
        int mind = mindepth(root);



        return maxd - mind;
        
    }
    
    
};



TreeNode *deserialize(string data)
{
    if (data.size() == 0)
        return nullptr;
    vector<string> dat;
    string t;
    for (auto c : data)
    {
        if (c == ',')
        {
            dat.push_back(t);
            t.clear();
        }
        else
            t.push_back(c);
    }
    dat.push_back(t);
    int i = 0;
    queue<TreeNode *> q;
    TreeNode *root = new TreeNode(stoll(dat[0]));
    q.push(root);
    auto cur = root;
    i++;
    while (!q.empty())
    {
        auto x = q.front();
        q.pop();
        if (dat[i] != "x")
        {
            x->left = new TreeNode(stoll(dat[i]));
            q.push(x->left);
        }
        i++;
        if (dat[i] != "x")
        {
            x->right = new TreeNode(stoll(dat[i]));
            q.push(x->right);
        }
        i++;
    }
    return root;
}

